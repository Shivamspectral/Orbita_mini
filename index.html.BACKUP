      <div class="dash-card mytasks-card">
        <div class="dash-card-head"><h3>My Tasks</h3><button onclick="document.querySelector('[data-page=\'tasks\']').click()">View all <i class="fa-solid fa-arrow-right"></i></button></div>
        <div id="dash-my-tasks" class="mytask-list"></div>
      </div>

