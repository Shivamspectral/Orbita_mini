                                <div class="team-empty-icon"><i class="fa-solid fa-people-group"></i></div>
                                <h2>Choose a team</h2>
                                <p>Every functional team, student lead, committee member and faculty coordinator from the official 2026-27 roster will appear here.</p>
                                <button class="small-btn" onclick="showAllTeams()"><i class="fa-solid fa-eye"></i> Show all teams</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="view-analytics" class="view-section hide">
                    <div class="view-toolbar">
                        <div><div class="profile-chip"><span class="status-dot"></span> Council Analytics Board</div><p style="margin-top:.45rem;color:var(--text-muted);font-size:.8rem">Statistical insights from the existing Tasks, Events, Meetings, Finance, Grievances and Members modules.</p></div>
                        <div class="analytics-toolbar"><button class="analytics-btn" onclick="refreshAnalyticsBoard()"><i class="fa-solid fa-rotate"></i> Refresh</button><button class="analytics-btn" onclick="exportAnalyticsCSV()"><i class="fa-solid fa-file-csv"></i> Export CSV</button></div>
                    </div>
                    <div class="kpi-grid">
                        <div class="kpi"><div class="kpi-label">Task Completion</div><div class="kpi-value" id="an-task-pct">0%</div></div>
                        <div class="kpi"><div class="kpi-label">Grievances Resolved</div><div class="kpi-value" id="an-grievance-pct">0%</div></div>
                        <div class="kpi"><div class="kpi-label">Council Members</div><div class="kpi-value" id="an-members">0</div></div>
                        <div class="kpi"><div class="kpi-label">Total Activities</div><div class="kpi-value" id="an-activities">0</div></div>
                    </div>
                    <div class="analytics-grid">
                        <div class="analytics-card"><div class="analytics-head"><h3>Activity Distribution</h3><span>Live from current records</span></div><div class="bar-chart" id="an-bars"></div></div>
                        <div class="analytics-card"><div class="analytics-head"><h3>Task Health</h3><span>Completion vs pending</span></div><div class="donut-wrap"><div class="donut-box"><div class="analytics-donut" id="an-donut"></div><div class="donut-center" id="an-donut-text">0%</div></div><div class="legend" id="an-task-legend"></div></div></div>
                    </div>
                    <div class="analytics-grid three">
                        <div class="analytics-card"><div class="analytics-head"><h3>Operational Health</h3><span>Current snapshot</span></div><div id="an-health"></div></div>
                        <div class="analytics-card"><div class="analytics-head"><h3>Smart Alerts</h3><span>Read-only</span></div><div id="an-alerts"></div></div>
                        <div class="analytics-card"><div class="analytics-head"><h3>Council Activity Mix</h3><span>Records</span></div><div id="an-mix"></div></div>
                    </div>
                    <div class="analytics-card" style="margin-top:1.25rem"><div class="analytics-head"><h3>Workload Snapshot</h3><span>Top assignment signals</span></div><table class="analytics-table"><thead><tr><th>Rank</th><th>Assignee / Signal</th><th>Tasks</th><th>Share</th></tr></thead><tbody id="an-leaderboard"></tbody></table></div>
                </div>

                <div id="view-chat" class="view-section hide">
                    <div class="section-header" style="margin-bottom:1rem;">
                        <div>
                            <h2 style="display:flex;align-items:center;gap:10px;"><i class="fa-solid fa-comments" style="color:var(--accent-blue);"></i> Council Connect</h2>
                            <p>Private council conversations and team channels for Siddhant College.</p>
                        </div>
                        <div style="display:flex;align-items:center;gap:8px;font-size:.72rem;color:var(--text-muted);"><span class="scms-live-dot"></span> Chat ready</div>
                    </div>
                    <div class="chat-shell">
                        <aside class="chat-sidebar">
                            <div class="chat-side-head">
                                <div class="chat-brand">
                                    <div><h3>Messages</h3><small>Student Council 2026–27</small></div>
                                    <div class="chat-avatar" style="width:38px;height:38px;border-radius:12px;"><i class="fa-solid fa-users"></i></div>
                                </div>
                            </div>
                            <div class="chat-search"><i class="fa-solid fa-magnifying-glass"></i><input id="chat-search-input" placeholder="Search chats..." oninput="filterChatList(this.value)"></div>
                            <div id="chat-list" class="chat-list"></div>
                        </aside>
                        <section class="chat-main">
                            <div class="chat-head">
                                <div class="chat-head-left">
                                    <div id="chat-head-avatar" class="chat-avatar team"><i class="fa-solid fa-users"></i></div>
                                    <div class="chat-head-title"><h3 id="chat-head-title">Council General</h3><p id="chat-head-subtitle"><span class="scms-live-dot" style="width:7px;height:7px;margin-right:5px;"></span> Council channel</p></div>
                                </div>
                                <div class="chat-head-actions">
                                    <button class="chat-icon-btn" title="Search messages" onclick="focusChatSearch()"><i class="fa-solid fa-magnifying-glass"></i></button>
                                    <button class="chat-icon-btn" title="Clear this chat" onclick="clearActiveChat()"><i class="fa-solid fa-broom"></i></button>
                                </div>
                            </div>
                            <div id="chat-messages" class="chat-messages"></div>
                            <div id="chat-typing" class="chat-typing" style="padding:0 22px;"><span>Someone is typing</span> <span class="typing-dots"><span></span><span></span><span></span></span></div>
                            <div class="chat-composer">
                                <div class="chat-compose-box">
                                    <textarea id="chat-input" rows="1" maxlength="1000" placeholder="Write a message..." onkeydown="chatKeydown(event)" oninput="autoGrowChat(this)"></textarea>
                                    <button class="chat-send" onclick="sendChatMessage()" title="Send message"><i class="fa-solid fa-paper-plane"></i></button>
                                </div>
                                <div class="chat-compose-tools"><span>Enter to send · Shift + Enter for a new line</span><span id="chat-counter">0 / 1000</span></div>
                            </div>
                        </section>
                    </div>
                </div>

                <div class="ssav-footer">
                    ASTRA<span style="font-size:.7rem;color:#7a1f3d;vertical-align:super;">™</span>
                    &nbsp;·&nbsp; Student Council Management System &nbsp;·&nbsp; Siddhant College of Engineering
                </div>

            
                <div id="view-power" class="view-section hide">
                    <div class="power-hero">
                        <div>
                            <div class="power-kicker"><i class="fa-solid fa-bolt"></i> SCMS Power Suite • ASTRA Operations</div>
                            <h2>Student Council Operating System</h2>
                            <p>Twenty connected command features with a responsive local cache and Supabase cloud persistence bridge. Changes are mirrored to the configured backend.</p>
                            <div class="power-actions"><button class="small-btn" onclick="generateSCMSBriefing()"><i class="fa-solid fa-wand-magic-sparkles"></i> Daily Briefing</button><button class="small-btn" onclick="openCommandPalette()"><i class="fa-solid fa-terminal"></i> Command K</button><button class="small-btn" onclick="exportPowerSuite()"><i class="fa-solid fa-file-export"></i> Export Suite</button></div>
                        </div>
                        <div class="power-health"><span class="power-kicker">Council health</span><div><strong id="power-health-score">82%</strong> <span class="power-badge">ON TRACK</span></div><div class="power-progress"><i id="power-health-bar"></i></div><small id="power-health-note" style="color:var(--text-muted);display:block;margin-top:.45rem">Calculated from tasks, events, meetings, finance and grievances.</small></div>
                    </div>
                    <div class="power-grid">
                        <div class="power-card" onclick="switchPowerTab('command')"><div class="power-icon"><i class="fa-solid fa-tower-broadcast"></i></div><h3>Command Center</h3><p>Live council pulse, attention signals and one-click operations.</p><div class="power-stat">Mission control →</div></div>
                        <div class="power-card" onclick="switchPowerTab('calendar')"><div class="power-icon"><i class="fa-solid fa-calendar-days"></i></div><h3>Super Calendar</h3><p>Combine events, meetings, deadlines and tasks in one agenda.</p><div class="power-stat" id="power-calendar-stat">0 scheduled</div></div>
                        <div class="power-card" onclick="switchPowerTab('approvals')"><div class="power-icon"><i class="fa-solid fa-route"></i></div><h3>Approval Engine</h3><p>Route finance, events, announcements and requests through approval stages.</p><div class="power-stat" id="power-approval-stat">0 requests</div></div>
                        <div class="power-card" onclick="switchPowerTab('goals')"><div class="power-icon"><i class="fa-solid fa-bullseye"></i></div><h3>Goals & OKRs</h3><p>Track council goals, owners, milestones and delivery.</p><div class="power-stat" id="power-goal-stat">3 goals</div></div>
                        <div class="power-card" onclick="switchPowerTab('docs')"><div class="power-icon"><i class="fa-solid fa-folder-tree"></i></div><h3>Document Vault</h3><p>Local document index for minutes, circulars, reports and certificates.</p><div class="power-stat" id="power-doc-stat">0 documents</div></div>
                        <div class="power-card" onclick="switchPowerTab('media')"><div class="power-icon"><i class="fa-solid fa-photo-film"></i></div><h3>Media & PR</h3><p>Plan posts, posters, press releases and event coverage.</p><div class="power-stat" id="power-media-stat">0 content items</div></div>
                        <div class="power-card" onclick="switchPowerTab('grievances')"><div class="power-icon"><i class="fa-solid fa-shield-halved"></i></div><h3>Grievance Command</h3><p>Priority queue, resolution workflow and response tracking.</p><div class="power-stat" id="power-grievance-stat">0 open</div></div>
                        <div class="power-card" onclick="switchPowerTab('achievements')"><div class="power-icon"><i class="fa-solid fa-medal"></i></div><h3>Achievements</h3><p>Professional recognition for delivery, consistency and teamwork.</p><div class="power-stat" id="power-achievement-stat">0 awards</div></div>
                    </div>
                    <div class="power-toolbar">
                        <button class="power-tab active" data-power-tab="command" onclick="switchPowerTab('command')">Command</button><button class="power-tab" data-power-tab="calendar" onclick="switchPowerTab('calendar')">Calendar</button><button class="power-tab" data-power-tab="approvals" onclick="switchPowerTab('approvals')">Approvals</button><button class="power-tab" data-power-tab="goals" onclick="switchPowerTab('goals')">Goals</button><button class="power-tab" data-power-tab="docs" onclick="switchPowerTab('docs')">Documents</button><button class="power-tab" data-power-tab="media" onclick="switchPowerTab('media')">Media</button><button class="power-tab" data-power-tab="grievances" onclick="switchPowerTab('grievances')">Grievances</button><button class="power-tab" data-power-tab="achievements" onclick="switchPowerTab('achievements')">Achievements</button><button class="power-tab" data-power-tab="assistant" onclick="switchPowerTab('assistant')">AI Assistant</button>
                    </div>
                    <div id="power-panel-command" class="power-panel active">
                      <div class="power-two"><div class="card"><div class="section-header"><div><h3>Attention Center</h3><div class="team-small">What the council should act on first.</div></div><button class="small-btn" onclick="refreshPowerSuite()">Refresh</button></div><div class="power-list" id="power-attention-list"></div></div><div class="card"><div class="section-header"><div><h3>Automation Recipes</h3><div class="team-small">Trigger operational workflows locally.</div></div></div><div class="power-list"><div class="power-row"><div class="mini"><i class="fa-solid fa-calendar-check"></i></div><div><strong>Event → preparation pack</strong><small>Create checklist, owner tasks and reminders.</small></div><button class="small-btn" onclick="runPowerAutomation('event')">Run</button></div><div class="power-row"><div class="mini"><i class="fa-solid fa-handshake"></i></div><div><strong>Meeting → action items</strong><small>Turn meeting decisions into tracked tasks.</small></div><button class="small-btn" onclick="runPowerAutomation('meeting')">Run</button></div><div class="power-row"><div class="mini"><i class="fa-solid fa-file-invoice"></i></div><div><strong>Finance → approval route</strong><small>Start Team Lead → Treasurer → GS → President.</small></div><button class="small-btn" onclick="runPowerAutomation('finance')">Run</button></div></div></div></div>
                      <div class="power-three" style="margin-top:1rem"><div class="card"><div class="section-header"><h3>Live Activity</h3></div><div class="power-list" id="power-activity-list"></div></div><div class="card"><div class="section-header"><h3>Engagement</h3></div><div id="power-engagement"></div></div><div class="card"><div class="section-header"><h3>Role Intelligence</h3></div><div id="power-role-intel"></div></div></div>
                    </div>
                    <div id="power-panel-calendar" class="power-panel"><div class="card"><div class="section-header"><div><h3>Super Calendar</h3><div class="team-small">Events + meetings + task deadlines.</div></div><input class="toolbar-input" id="power-calendar-search" placeholder="Search agenda..." oninput="renderPowerCalendar()"></div><div id="power-calendar-list" class="power-list"></div></div></div>
                    <div id="power-panel-approvals" class="power-panel"><div class="power-two"><div class="card"><div class="section-header"><h3>Approval Queue</h3><button class="small-btn" onclick="createApproval()">+ Request</button></div><div id="power-approval-list" class="power-list"></div></div><div class="card"><div class="section-header"><h3>Workflow</h3></div><div class="power-list"><div class="power-row"><div class="mini">1</div><div><strong>Team Lead</strong><small>Initial review</small></div><span class="power-badge">START</span></div><div class="power-row"><div class="mini">2</div><div><strong>Treasurer / Coordinator</strong><small>Budget or operational validation</small></div><span class="power-badge">REVIEW</span></div><div class="power-row"><div class="mini">3</div><div><strong>General Secretary</strong><small>Council-level approval</small></div><span class="power-badge">VERIFY</span></div><div class="power-row"><div class="mini">4</div><div><strong>President</strong><small>Final decision</small></div><span class="power-badge">FINAL</span></div></div></div></div></div>
                    <div id="power-panel-goals" class="power-panel"><div class="power-two"><div class="card"><div class="section-header"><h3>Council Goals</h3><button class="small-btn" onclick="addPowerGoal()">+ Goal</button></div><div id="power-goals-list" class="power-list"></div></div><div class="card"><div class="section-header"><h3>Goal Health</h3></div><div id="power-goal-health"></div></div></div></div>
                    <div id="power-panel-docs" class="power-panel"><div class="card"><div class="section-header"><div><h3>Document Vault</h3><div class="team-small">Upload and manage council documents with server-backed metadata.</div></div><button class="small-btn" onclick="addPowerDocument()">+ Add document</button></div><div id="power-doc-list" class="power-list"></div></div></div>
                    <div id="power-panel-media" class="power-panel"><div class="card"><div class="section-header"><div><h3>Media & PR Pipeline</h3><div class="team-small">Idea → Draft → Review → Approved → Published.</div></div><button class="small-btn" onclick="addMediaItem()">+ Content</button></div><div id="power-media-list" class="power-list"></div></div></div>
                    <div id="power-panel-grievances" class="power-panel"><div class="power-two"><div class="card"><div class="section-header"><h3>Grievance Command Queue</h3></div><div id="power-grievance-list" class="power-list"></div></div><div class="card"><div class="section-header"><h3>Response Health</h3></div><div id="power-grievance-health"></div></div></div></div>
                    <div id="power-panel-achievements" class="power-panel"><div class="card"><div class="section-header"><div><h3>Professional Achievements</h3><div class="team-small">Recognition stays local and editable.</div></div><button class="small-btn" onclick="addAchievement()">+ Award</button></div><div id="power-achievement-list" class="power-list"></div></div></div>
                    <div id="power-panel-assistant" class="power-panel"><div class="card"><div class="section-header"><div><h3>SCMS Assistant</h3><div class="team-small">Local rule-based council assistant — no external AI/API.</div></div></div><div class="assistant-box"><input class="power-input" id="power-assistant-input" placeholder="Ask: what needs attention today?" onkeydown="if(event.key==='Enter')askSCMSAssistant()"><button class="small-btn" onclick="askSCMSAssistant()">Ask</button></div><div class="assistant-output briefing-box" id="power-assistant-output">Ask me about tasks, events, meetings, finance, grievances, teams or today's priorities.</div></div></div>
                </div>

</main>
        </div>
    </div>

    <script>
        // ORBITA MINI FastAPI data adapter. The approved UI remains unchanged.
        // Data and authentication are stored locally in this browser until Supabase is intentionally connected later.
        const FRONTEND_ONLY = true;
        let CURRENT_USER = null;
        let AUTH_TOKEN = null;
        const LOCAL_DB_KEY = 'scms_frontend_db_v1';
        const LOCAL_SESSION_KEY = 'scms_frontend_session_v1';
        let ALL_MEMBERS = [];
        const SCMS_STATE = {
            tasks: [], events: [], members: [], meetings: [], finances: [], grievances: [],
            currentPage: 'dashboard',
            editing: null
        };

        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.innerHTML = `<i class="fa-solid ${type === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation'}"></i> ${message}`;
            container.appendChild(toast);
            setTimeout(() => { toast.style.opacity = '0'; toast.style.transform = 'translateX(100%)'; setTimeout(() => toast.remove(), 300); }, 3000);
        }

        function openModal(id) { document.getElementById(id).classList.remove('hide'); setTimeout(() => document.getElementById(id).classList.add('show'), 10); }
        function closeModal(id) { document.getElementById(id).classList.remove('show'); setTimeout(() => document.getElementById(id).classList.add('hide'), 300); }


        /* =========================================================
           v4.2 CORE PRODUCTIVITY FEATURES
           ========================================================= */
        let AUTO_REFRESH_TIMER = null;
        let CHAT_ACTIVE_ID = 'general';
        const CHAT_KEY = 'scms_chat_v42';
        const CHAT_CHANNELS = [
            {id:'general',name:'Council General',subtitle:'Council channel',icon:'fa-users',theme:'team'},
            {id:'leadership',name:'Leadership',subtitle:'Executive coordination',icon:'fa-crown',theme:''},
            {id:'events',name:'Events Desk',subtitle:'Events & activities',icon:'fa-calendar-check',theme:'green'},
            {id:'welfare',name:'Student Welfare',subtitle:'Welfare & grievances',icon:'fa-shield-heart',theme:'green'}
        ];

        function safeDate(v){
            const d=v?new Date(v):null;
            return d && !isNaN(d) ? d : null;
        }
        function formatDate(v){
            const d=safeDate(v); return d ? d.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) : (v||'');
        }

        function initSIHLogoSlot(){
            const slot=document.getElementById('sih-logo-slot'), input=document.getElementById('sih-logo-input'), preview=document.getElementById('sih-logo-preview'), clear=document.getElementById('sih-logo-clear');
            if(!slot||!input||!preview)return;
            const saved=localStorage.getItem('scms_sih_logo');
            if(saved) preview.innerHTML=`<img src="${saved}" alt="SIH logo">`;
            slot.addEventListener('click',e=>{if(e.target.closest('#sih-logo-clear'))return;input.click();});
            input.addEventListener('change',()=>{
                const file=input.files?.[0]; if(!file)return;
                if(!file.type.startsWith('image/')){showToast('Please choose an image file.','error');return;}
                const reader=new FileReader();
                reader.onload=()=>{localStorage.setItem('scms_sih_logo',reader.result);preview.innerHTML=`<img src="${reader.result}" alt="SIH logo">`;showToast('SIH logo saved on this browser.');};
                reader.readAsDataURL(file);
            });
            clear?.addEventListener('click',e=>{e.stopPropagation();localStorage.removeItem('scms_sih_logo');preview.innerHTML='<i class="fa-solid fa-image"></i>';input.value='';showToast('SIH logo removed.');});
        }

        function updateNotifications(){
            const notices=[];
            const now=new Date();
            SCMS_STATE.tasks.filter(t=>t.status!=='Completed').slice(0,8).forEach(t=>{
                const d=safeDate(t.due_date);
                const overdue=d && d < now;
                notices.push({icon:overdue?'fa-triangle-exclamation':'fa-clipboard-check',title:overdue?`Overdue: ${t.title}`:`Task: ${t.title}`,text:`${t.assigned_name||'Unassigned'} · ${t.status||'Pending'}`});
            });
            SCMS_STATE.finances.filter(f=>f.status==='Pending').slice(0,5).forEach(f=>notices.push({icon:'fa-indian-rupee-sign',title:`Finance approval: ${f.title}`,text:`₹${Number(f.amount||0).toLocaleString('en-IN')}`}));
            SCMS_STATE.grievances.filter(g=>g.status==='Open').slice(0,5).forEach(g=>notices.push({icon:'fa-shield',title:`Open grievance: ${g.subject}`,text:`Priority: ${g.priority||'Normal'}`}));
            const list=document.getElementById('notification-list');
            if(list) list.innerHTML=notices.length ? notices.slice(0,15).map(n=>`<div class="scms-notice"><i class="fa-solid ${n.icon}"></i><div><strong>${escapeHtml(n.title)}</strong><small>${escapeHtml(n.text)}</small></div></div>`).join('') : emptyState('fa-bell-slash','All clear','No urgent operational notifications.');
            const count=document.getElementById('notification-count');
            if(count){count.textContent=Math.min(notices.length,99);count.style.display=notices.length?'grid':'none';}
        }

        function markNotificationsRead(){
            const c=document.getElementById('notification-count'); if(c){c.textContent='0';c.style.display='none';}
            toggleNotifications(false);
        }
        function toggleNotifications(force){
            const p=document.getElementById('notification-panel'); if(!p)return;
            const show=force===undefined?!p.classList.contains('show'):force;
            p.classList.toggle('show',show); p.setAttribute('aria-hidden',String(!show));
            if(show){toggleSettings(false);updateNotifications();}
        }
        function toggleSettings(force){
            const p=document.getElementById('settings-panel'); if(!p)return;
            const show=force===undefined?!p.classList.contains('show'):force;
            p.classList.toggle('show',show);p.setAttribute('aria-hidden',String(!show));
            if(show){toggleNotifications(false);loadPreferences();}
        }
        function toggleDarkMode(enabled){
            document.documentElement.classList.toggle('scms-dark',enabled);
            localStorage.setItem('scms_dark_mode',enabled?'1':'0');
        }
        function loadPreferences(){
            const dark=localStorage.getItem('scms_dark_mode')==='1';
            const auto=localStorage.getItem('scms_auto_refresh')==='1';
            const d=document.getElementById('dark-mode-toggle'),a=document.getElementById('auto-refresh-toggle');
            if(d)d.checked=dark;if(a)a.checked=auto;
        }
        function toggleAutoRefresh(enabled){
            localStorage.setItem('scms_auto_refresh',enabled?'1':'0');
            if(AUTO_REFRESH_TIMER) clearInterval(AUTO_REFRESH_TIMER);
            if(enabled) AUTO_REFRESH_TIMER=setInterval(()=>refreshAll(true),60000);
            showToast(enabled?'Auto refresh enabled.':'Auto refresh disabled.');
        }
        function changeApiEndpoint(){ showToast('ASTRA cloud sync is enabled through the existing Supabase bridge.','success'); }
        function clearLocalWorkspace(){
            if(!confirm('Clear locally stored chat, theme and preferences? Server records will not be deleted.'))return;
            [CHAT_KEY,'scms_dark_mode','scms_auto_refresh'].forEach(k=>localStorage.removeItem(k));
            showToast('Local workspace data cleared. Reloading...');
            setTimeout(()=>location.reload(),600);
        }
        function printCurrentView(){toggleSettings(false);window.print();}
        function exportFullSnapshot(){
            const payload={exported_at:new Date().toISOString(),user:CURRENT_USER,records:SCMS_STATE,teams:typeof COUNCIL_TEAMS!=='undefined'?COUNCIL_TEAMS:[]};
            downloadBlob(JSON.stringify(payload,null,2),'SCMS_Full_Snapshot.json','application/json');
            showToast('Full snapshot exported.');
        }
        function exportDataset(name){
            const rows=SCMS_STATE[name]||[];
            downloadBlob(toCSV(rows),`SCMS_${name}.csv`,'text/csv');
            showToast(`${name} CSV exported.`);
        }

        function refreshAnalyticsBoard(){
            const t=SCMS_STATE.tasks||[],g=SCMS_STATE.grievances||[],m=SCMS_STATE.members||[];
            const completed=t.filter(x=>x.status==='Completed').length;
            const resolved=g.filter(x=>x.status==='Resolved').length;
            const pct=(n,d)=>d?Math.round(n/d*100):0;
            const set=(id,v)=>{const el=document.getElementById(id);if(el)el.textContent=v;};
            set('an-task-pct',`${pct(completed,t.length)}%`);
            set('an-grievance-pct',`${pct(resolved,g.length)}%`);
            set('an-members',m.length);
            set('an-activities',t.length+(SCMS_STATE.events||[]).length+(SCMS_STATE.meetings||[]).length);
            const counts=[['Tasks',t.length],['Events',SCMS_STATE.events.length],['Meetings',SCMS_STATE.meetings.length],['Finance',SCMS_STATE.finances.length],['Grievances',g.length]];
            const max=Math.max(1,...counts.map(x=>x[1]));
            const bars=document.getElementById('an-bars');
            if(bars)bars.innerHTML=counts.map(([label,val])=>`<div class="bar-col"><div class="bar-value">${val}</div><div class="bar" style="height:${Math.max(6,val/max*78)}%"></div><div class="bar-label">${label}</div></div>`).join('');
            const donut=document.getElementById('an-donut'); if(donut)donut.style.background=`conic-gradient(var(--accent-blue) 0 ${pct(completed,t.length)}%,#e5e7eb ${pct(completed,t.length)}% 100%)`;
            set('an-donut-text',`${pct(completed,t.length)}%`);
            const legend=document.getElementById('an-task-legend');
            if(legend)legend.innerHTML=`<div class="legend-row"><span><span class="legend-dot" style="background:var(--accent-blue)"></span>Completed</span><b>${completed}</b></div><div class="legend-row"><span><span class="legend-dot" style="background:#e5e7eb"></span>Remaining</span><b>${Math.max(0,t.length-completed)}</b></div>`;
            const health=document.getElementById('an-health');
            if(health)health.innerHTML=[['Task completion',pct(completed,t.length)],['Grievance resolution',pct(resolved,g.length)],['Meeting coverage',pct(SCMS_STATE.meetings.length,Math.max(1,SCMS_STATE.events.length))]].map(([x,v])=>`<div class="analytics-stat"><div style="flex:1"><span>${x}</span><div class="analytics-progress"><span style="width:${v}%"></span></div></div><b>${v}%</b></div>`).join('');
            const alerts=document.getElementById('an-alerts');
            const alertRows=[];
            t.filter(x=>x.status!=='Completed' && safeDate(x.due_date) && safeDate(x.due_date)<new Date()).slice(0,3).forEach(x=>alertRows.push(['fa-triangle-exclamation',`Overdue task: ${x.title}`,'Immediate follow-up recommended.']));
            g.filter(x=>x.status==='Open').slice(0,3).forEach(x=>alertRows.push(['fa-shield',`Open grievance: ${x.subject}`,'Welfare review required.']));
            alertRows.push(['fa-indian-rupee-sign','Finance & Budget','Coming in a future update.']);
            if(alerts)alerts.innerHTML=alertRows.length?alertRows.map(a=>`<div class="analytics-alert"><i class="fa-solid ${a[0]}"></i><div><strong>${escapeHtml(a[1])}</strong><small>${escapeHtml(a[2])}</small></div></div>`).join(''):emptyState('fa-circle-check','No smart alerts','Operational signals look healthy.');
            const mix=document.getElementById('an-mix');
            if(mix)mix.innerHTML=counts.map(([x,v])=>`<div class="analytics-stat"><span>${x}</span><b>${v}</b></div>`).join('');
            const workload={};
            t.forEach(x=>{const n=x.assigned_name||'Unassigned';workload[n]=(workload[n]||0)+1;});
            const total=Math.max(1,t.length);
            const lb=document.getElementById('an-leaderboard');
            if(lb)lb.innerHTML=Object.entries(workload).sort((a,b)=>b[1]-a[1]).slice(0,10).map(([n,v],i)=>`<tr><td class="analytics-rank">#${i+1}</td><td>${escapeHtml(n)}</td><td>${v}</td><td>${Math.round(v/total*100)}%</td></tr>`).join('')||'<tr><td colspan="4">No task workload data.</td></tr>';
        }
        function exportAnalyticsCSV(){
            const rows=[
                ['Metric','Value'],
                ['Task Completion',document.getElementById('an-task-pct')?.textContent||'0%'],
                ['Grievances Resolved',document.getElementById('an-grievance-pct')?.textContent||'0%'],
                ['Council Members',document.getElementById('an-members')?.textContent||'0'],
                ['Total Activities',document.getElementById('an-activities')?.textContent||'0']
            ];
            downloadBlob(rows.map(r=>r.map(v=>`"${String(v).replaceAll('"','""')}"`).join(',')).join('\n'),'SCMS_Analytics.csv','text/csv');
            showToast('Analytics CSV exported.');
        }

        function getChatStore(){
            try{return JSON.parse(localStorage.getItem(CHAT_KEY)||'{}')||{};}catch{return {};}
        }
        function saveChatStore(store){localStorage.setItem(CHAT_KEY,JSON.stringify(store));}
        function getChatMessages(id){
            const store=getChatStore();
            if(!store[id])store[id]=[
                {sender:'Council System',text:'Welcome to Council Connect. Use this channel for coordination updates.',time:new Date().toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}),mine:false}
            ];
            saveChatStore(store); return store[id];
        }
        function renderChatList(query=''){
            const q=(query||'').toLowerCase().trim(), list=document.getElementById('chat-list');if(!list)return;
            list.innerHTML=CHAT_CHANNELS.filter(c=>!q||c.name.toLowerCase().includes(q)||c.subtitle.toLowerCase().includes(q)).map(c=>{
                const msgs=getChatMessages(c.id), last=msgs[msgs.length-1];
                return `<div class="chat-item ${CHAT_ACTIVE_ID===c.id?'active':''}" onclick="openChatChannel('${c.id}')"><div class="chat-avatar ${c.theme||''}"><i class="fa-solid ${c.icon}"></i></div><div class="chat-item-main"><div class="chat-item-top"><strong>${escapeHtml(c.name)}</strong><span class="chat-time">${escapeHtml(last?.time||'')}</span></div><div class="chat-preview">${escapeHtml(last?.text||'No messages')}</div></div></div>`;
            }).join('')||emptyState('fa-comments','No channels','Try another search.');
        }
        function openChatChannel(id){
            CHAT_ACTIVE_ID=id; const c=CHAT_CHANNELS.find(x=>x.id===id)||CHAT_CHANNELS[0];
            document.getElementById('chat-head-title').textContent=c.name;
            document.getElementById('chat-head-subtitle').innerHTML=`<span class="scms-live-dot" style="width:7px;height:7px;margin-right:5px;"></span> ${escapeHtml(c.subtitle)}`;
            document.getElementById('chat-head-avatar').innerHTML=`<i class="fa-solid ${c.icon}"></i>`;
            renderChatMessages();renderChatList(document.getElementById('chat-search-input')?.value||'');
        }
        function renderChatMessages(){
            const box=document.getElementById('chat-messages');if(!box)return;
            const msgs=getChatMessages(CHAT_ACTIVE_ID);
            box.innerHTML=`<div class="chat-day">Today</div>`+msgs.map(m=>`<div class="chat-row ${m.mine?'mine':''}"><div class="chat-mini-avatar">${initials(m.sender||'U')}</div><div class="chat-bubble-wrap">${!m.mine?`<div class="chat-sender">${escapeHtml(m.sender)}</div>`:''}<div class="chat-bubble">${escapeHtml(m.text).replace(/\n/g,'<br>')}</div><div class="chat-meta">${escapeHtml(m.time||'')}</div></div></div>`).join('');
            box.scrollTop=box.scrollHeight;
        }
        function sendChatMessage(){
            const input=document.getElementById('chat-input'),text=(input?.value||'').trim();if(!text)return;
            const store=getChatStore(),arr=store[CHAT_ACTIVE_ID]||[];
            arr.push({sender:CURRENT_USER?.name||'You',text,time:new Date().toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}),mine:true});
            store[CHAT_ACTIVE_ID]=arr;saveChatStore(store);input.value='';autoGrowChat(input);updateChatCounter();renderChatMessages();renderChatList();
        }
        function chatKeydown(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendChatMessage();}}
        function autoGrowChat(el){el.style.height='auto';el.style.height=Math.min(el.scrollHeight,100)+'px';updateChatCounter();}
        function updateChatCounter(){const x=document.getElementById('chat-input'),c=document.getElementById('chat-counter');if(x&&c)c.textContent=`${x.value.length} / 1000`;}
        function filterChatList(v){renderChatList(v);}
        function focusChatSearch(){document.getElementById('chat-search-input')?.focus();}
        function clearActiveChat(){if(!confirm('Clear messages in this channel?'))return;const s=getChatStore();delete s[CHAT_ACTIVE_ID];saveChatStore(s);renderChatMessages();renderChatList();showToast('Chat cleared.');}

        const COMMANDS=[
            ['operations','Operations Hub','fa-toolbox',()=>goToPage('operations')],
            ['dashboard','Dashboard','fa-border-all',()=>goToPage('dashboard')],
            ['tasks','Task Center','fa-clipboard-check',()=>goToPage('tasks')],
            ['events','Event Management','fa-calendar',()=>goToPage('events')],
            ['members','Member Directory','fa-users',()=>goToPage('members')],
            ['meetings','Meeting Management','fa-handshake',()=>goToPage('meetings')],
            ['finance','Finance & Budget • Future Update','fa-chart-pie',()=>goToPage('finance')],
            ['grievances','Student Grievances','fa-shield',()=>goToPage('grievances')],
            ['analytics','Analytics Board','fa-chart-line',()=>goToPage('analytics')],
            ['chat','Council Connect','fa-comments',()=>goToPage('chat')],
            ['power','SCMS Power Suite','fa-bolt',()=>goToPage('power')],
            ['briefing','Generate daily council briefing','fa-wand-magic-sparkles',()=>generateSCMSBriefing()],
            ['refresh','Refresh all data','fa-rotate',()=>refreshAll()],
            ['export','Export full snapshot','fa-file-export',()=>exportFullSnapshot()],
            ['print','Print current page','fa-print',()=>printCurrentView()],
            ['settings','Open settings','fa-gear',()=>toggleSettings(true)]
        ];
        function goToPage(page){
            const link=document.querySelector(`.nav-item[data-page="${page}"]`);
            if(link)link.click();else showToast('You do not have access to this page.','error');
            closeCommandPalette();
        }
        function renderCommandPalette(q=''){
            const box=document.getElementById('command-list');if(!box)return;
            const rows=COMMANDS.filter(c=>!q||`${c[0]} ${c[1]}`.toLowerCase().includes(q.toLowerCase())).map((c,i)=>`<div class="command-item ${i===0?'active':''}" onclick="COMMANDS.find(x=>x[0]==='${c[0]}')[3]();closeCommandPalette()"><i class="fa-solid ${c[2]}"></i><span>${escapeHtml(c[1])}</span><span class="command-hint">Enter</span></div>`).join('');
            box.innerHTML=rows||emptyState('fa-magnifying-glass','No commands','Try another keyword.');
        }
        function openCommandPalette(){toggleSettings(false);toggleNotifications(false);const o=document.getElementById('command-overlay');o?.classList.add('show');const i=document.getElementById('command-input');if(i){i.value='';renderCommandPalette();setTimeout(()=>i.focus(),30);}}
        function closeCommandPalette(){document.getElementById('command-overlay')?.classList.remove('show');}
        function wireEnhancedUI(){
            document.getElementById('header-notification-btn')?.addEventListener('click',()=>toggleNotifications());
            document.getElementById('header-settings-btn')?.addEventListener('click',()=>toggleSettings());
            document.getElementById('header-chat-btn')?.addEventListener('click',()=>goToPage('chat'));
            document.getElementById('command-input')?.addEventListener('input',e=>renderCommandPalette(e.target.value));
            document.getElementById('command-input')?.addEventListener('keydown',e=>{if(e.key==='Escape')closeCommandPalette();if(e.key==='Enter')document.querySelector('.command-item.active')?.click();});
            document.getElementById('chat-input')?.addEventListener('input',updateChatCounter);
            renderChatList();openChatChannel('general');loadPreferences();
            initSIHLogoSlot();
            updateNotifications();
        }
        document.addEventListener('keydown',e=>{
            if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();openCommandPalette();}
            if(e.key==='Escape'){closeCommandPalette();toggleSettings(false);toggleNotifications(false);}
            if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='r'&&!e.shiftKey){ /* browser refresh remains native */ }
        });
        window.addEventListener('click',e=>{
            const n=document.getElementById('notification-panel'),s=document.getElementById('settings-panel');
            if(n?.classList.contains('show')&&!e.target.closest('#notification-panel,#header-notification-btn'))toggleNotifications(false);
            if(s?.classList.contains('show')&&!e.target.closest('#settings-panel,#header-settings-btn'))toggleSettings(false);
        });

        
        const FEATURE_CATALOG={
            attendance:{title:'Attendance Center',icon:'fa-user-check',body:`<div class="form-grid-compact"><label>Session/Event<select id="feat-att-event"><option>Meeting / Event</option></select></label><label>Date<input id="feat-att-date" type="date"></label><label>Student/Member<input id="feat-att-person" placeholder="Search participant"></label><label>Status<select id="feat-att-status"><option>Present</option><option>Late</option><option>Absent</option></select></label></div><div class="report-actions" style="margin-top:1rem"><button class="small-btn" onclick="saveFeatureRecord('attendance')"><i class="fa-solid fa-check"></i> Save Attendance</button><button class="small-btn" onclick="generateQR()"><i class="fa-solid fa-qrcode"></i> Generate QR</button><button class="small-btn" onclick="exportFeature('attendance')"><i class="fa-solid fa-file-csv"></i> Export</button></div><div id="feat-qr" style="margin-top:1rem"></div>`},
            approvals:{title:'Approval Center',icon:'fa-stamp',body:`<div class="form-grid-compact"><label>Request title<input id="feat-app-title" placeholder="e.g. Annual Fest Budget"></label><label>Type<select id="feat-app-type"><option>Event</option><option>Finance</option><option>Purchase</option><option>Announcement</option></select></label><label class="full-span">Notes<textarea id="feat-app-notes" rows="3"></textarea></label></div><div class="report-actions" style="margin-top:1rem"><button class="small-btn" onclick="saveFeatureRecord('approvals')">Submit for Approval</button><button class="small-btn" onclick="exportFeature('approvals')">Export Queue</button></div>`},
            documents:{title:'Document Center',icon:'fa-folder-open',body:`<div class="form-grid-compact"><label>Document name<input id="feat-doc-name" placeholder="Meeting Minutes - Aug 2026"></label><label>Category<select id="feat-doc-cat"><option>Meeting Minutes</option><option>Event Proposal</option><option>Event Report</option><option>Finance</option><option>Circular</option><option>Certificate</option></select></label><label class="full-span">Description<textarea id="feat-doc-desc" rows="3"></textarea></label><label class="full-span">File<input id="feat-doc-file" type="file"></label></div><div class="report-actions" style="margin-top:1rem"><button class="small-btn" onclick="saveFeatureRecord('documents')">Register Document</button><button class="small-btn" onclick="exportFeature('documents')">Export Index</button></div><div id="feat-doc-list" class="timeline" style="margin-top:1rem"></div>`},
            students:{title:'Student Directory',icon:'fa-graduation-cap',body:`<div class="form-grid-compact"><label>Name<input id="feat-st-name"></label><label>Roll No<input id="feat-st-roll"></label><label>Department<input id="feat-st-dept"></label><label>Year<select id="feat-st-year"><option>FY</option><option>SY</option><option>TY</option><option>Final Year</option></select></label><label class="full-span">Email<input id="feat-st-email" type="email"></label></div><div class="report-actions" style="margin-top:1rem"><button class="small-btn" onclick="saveFeatureRecord('students')">Add Student</button><button class="small-btn" onclick="exportFeature('students')">Export Directory</button></div><div id="feat-st-list" class="timeline" style="margin-top:1rem"></div>`},
            elections:{title:'Election Center',icon:'fa-check-to-slot',body:`<div class="form-grid-compact"><label>Election name<input id="feat-el-name" placeholder="Student Council Election 2026"></label><label>Position<select id="feat-el-position"><option>President</option><option>Vice President</option><option>Secretary</option><option>Treasurer</option><option>Coordinator</option></select></label><label>Candidate<input id="feat-el-candidate"></label><label>Manifesto<textarea id="feat-el-manifesto" rows="2"></textarea></label></div><div class="report-actions" style="margin-top:1rem"><button class="small-btn" onclick="saveFeatureRecord('elections')">Register Candidate</button><button class="small-btn" onclick="showElectionResults()">View Results</button></div><div id="feat-el-results" class="timeline" style="margin-top:1rem"></div>`},
            reports:{title:'Reports Center',icon:'fa-file-lines',body:`<div class="module-grid"><div class="module-tile" onclick="generateReport('monthly')"><i class="fa-solid fa-calendar-days"></i><strong>Monthly Report</strong><small>Activities, tasks and finance</small></div><div class="module-tile" onclick="generateReport('semester')"><i class="fa-solid fa-graduation-cap"></i><strong>Semester Report</strong><small>Participation and outcomes</small></div><div class="module-tile" onclick="generateReport('finance')"><i class="fa-solid fa-indian-rupee-sign"></i><strong>Finance Report</strong><small>Budget and spending • Future Update</small></div></div>`},
            certificates:{title:'Certificate Generator',icon:'fa-certificate',body:`<div class="form-grid-compact"><label>Student name<input id="feat-cert-name"></label><label>Certificate type<select id="feat-cert-type"><option>Event Participation</option><option>Volunteer Service</option><option>Leadership</option><option>Appreciation</option></select></label><label class="full-span">Achievement<input id="feat-cert-achievement" placeholder="For outstanding contribution to..."></label></div><div class="report-actions" style="margin-top:1rem"><button class="small-btn" onclick="generateCertificate()">Generate Certificate</button></div>`},
            announcements:{title:'Announcement Publisher',icon:'fa-bullhorn',body:`<div class="form-grid-compact"><label>Title<input id="feat-ann-title"></label><label>Audience<select id="feat-ann-audience"><option>All Students</option><option>Council Members</option><option>Faculty</option><option>Event Participants</option></select></label><label class="full-span">Message<textarea id="feat-ann-msg" rows="5"></textarea></label></div><div class="report-actions" style="margin-top:1rem"><button class="small-btn" onclick="saveFeatureRecord('announcements')">Publish Announcement</button></div>`},
            audit:{title:'Audit Log',icon:'fa-shield-halved',body:`<div class="report-actions"><button class="small-btn" onclick="exportFeature('audit')">Export Audit Log</button></div><div id="feat-audit-list" class="timeline" style="margin-top:1rem"></div>`}
        };
        function featureStore(){try{return JSON.parse(localStorage.getItem('scms_feature_store')||'{}')||{};}catch{return {};}}
        function saveFeatureStore(x){localStorage.setItem('scms_feature_store',JSON.stringify(x));}
        function audit(action,detail){const s=featureStore();s.audit=s.audit||[];s.audit.unshift({action,detail,user:CURRENT_USER?.name||'System',time:new Date().toISOString()});saveFeatureStore(s);}
        function openFeatureModal(type){const f=FEATURE_CATALOG[type];if(!f)return;document.getElementById('feature-title').innerHTML=`<i class="fa-solid ${f.icon}"></i> ${f.title}`;document.getElementById('feature-body').innerHTML=f.body;document.getElementById('feature-modal').classList.remove('hide');renderFeature(type);}
        function renderFeature(type){const s=featureStore();if(type==='documents')renderSimpleList('feat-doc-list',s.documents||[],'name','category');if(type==='students')renderSimpleList('feat-st-list',s.students||[],'name','roll');if(type==='elections')showElectionResults();if(type==='audit')renderSimpleList('feat-audit-list',s.audit||[],'action','detail');}
        function renderSimpleList(id,rows,a,b){const el=document.getElementById(id);if(!el)return;el.innerHTML=rows.length?rows.slice(0,20).map(x=>`<div class="timeline-item"><div><strong>${escapeHtml(String(x[a]||''))}</strong><br><small>${escapeHtml(String(x[b]||''))}</small></div></div>`).join(''):'<div class="empty-state">No records yet.</div>';}
        function saveFeatureRecord(type){const s=featureStore();s[type]=s[type]||[];let row={created_at:new Date().toISOString()};if(type==='attendance')row={...row,event:document.getElementById('feat-att-event')?.value,date:document.getElementById('feat-att-date')?.value,person:document.getElementById('feat-att-person')?.value,status:document.getElementById('feat-att-status')?.value};if(type==='approvals')row={...row,title:document.getElementById('feat-app-title')?.value,type:document.getElementById('feat-app-type')?.value,notes:document.getElementById('feat-app-notes')?.value,status:'Pending'};if(type==='documents')row={...row,name:document.getElementById('feat-doc-name')?.value,category:document.getElementById('feat-doc-cat')?.value,description:document.getElementById('feat-doc-desc')?.value};if(type==='students')row={...row,name:document.getElementById('feat-st-name')?.value,roll:document.getElementById('feat-st-roll')?.value,department:document.getElementById('feat-st-dept')?.value,year:document.getElementById('feat-st-year')?.value,email:document.getElementById('feat-st-email')?.value};if(type==='elections')row={...row,election:document.getElementById('feat-el-name')?.value,position:document.getElementById('feat-el-position')?.value,candidate:document.getElementById('feat-el-candidate')?.value,manifesto:document.getElementById('feat-el-manifesto')?.value,votes:0};if(type==='announcements')row={...row,title:document.getElementById('feat-ann-title')?.value,audience:document.getElementById('feat-ann-audience')?.value,message:document.getElementById('feat-ann-msg')?.value};s[type].unshift(row);saveFeatureStore(s);audit(`Created ${type}`,JSON.stringify(row).slice(0,180));renderFeature(type);updateOperationsHealth();showToast(`${type[0].toUpperCase()+type.slice(1)} saved successfully.`);}
        function exportFeature(type){const rows=featureStore()[type]||[];downloadBlob(toCSV(rows),`SCMS_${type}.csv`,'text/csv');showToast(`${type} exported.`);}
        function generateQR(){document.getElementById('feat-qr').innerHTML='<div class="qr-box"></div><p style="text-align:center;font-size:.7rem;color:var(--text-muted);margin-top:.5rem">Session QR token generated for council check-in. Cloud attendance records are persisted through the configured backend.</p>';}
        function showElectionResults(){const el=document.getElementById('feat-el-results');if(!el)return;const rows=featureStore().elections||[];el.innerHTML=rows.length?rows.map(x=>`<div class="timeline-item"><div><strong>${escapeHtml(x.candidate||'Candidate')}</strong> · ${escapeHtml(x.position||'')}</div><span class="status-chip">${x.votes||0} votes</span></div>`).join(''):'<div class="empty-state">No candidates registered.</div>';}
        function generateCertificate(){
    const name=document.getElementById('feat-cert-name')?.value||'Student';
    const type=document.getElementById('feat-cert-type')?.value||'Participation';
    const ach=document.getElementById('feat-cert-achievement')?.value||'valuable contribution';
    const w=window.open('','_blank','width=900,height=650');
    if(!w){showToast('Please allow pop-ups to generate the certificate.','error');return;}
    const safeName=escapeHtml(name), safeType=escapeHtml(type), safeAch=escapeHtml(ach);
    w.document.write(`<!doctype html><html><head><title>SCMS Certificate</title><style>body{font-family:Arial,sans-serif;text-align:center;padding:70px;border:16px solid #7a1f3d;margin:20px;color:#1e293b}h1{font-size:40px}h2{font-size:30px;margin:40px}p{font-size:20px}button{padding:12px 20px;border:0;border-radius:10px;background:#7a1f3d;color:#fff;cursor:pointer}</style></head><body><h1>CERTIFICATE OF ${safeType.toUpperCase()}</h1><p>This certificate is proudly presented to</p><h2>${safeName}</h2><p>For ${safeAch}</p><p>Student Council Management System</p><button onclick="print()">Print Certificate</button></body></html>`);
    w.document.close();
    audit('Generated certificate',`${name} • ${type}`);
    showToast('Certificate generated.','success');
}


        function generateReport(type){const payload={report:type,generated_at:new Date().toISOString(),user:CURRENT_USER,summary:{tasks:SCMS_STATE.tasks.length,events:SCMS_STATE.events.length,meetings:SCMS_STATE.meetings.length,grievances:SCMS_STATE.grievances.length,finance:SCMS_STATE.finances.length,members:SCMS_STATE.members.length},records:SCMS_STATE};downloadBlob(JSON.stringify(payload,null,2),`SCMS_${type}_report.json`,'application/json');showToast(`${type} report generated.`);}
        function updateOperationsHealth(){const s=featureStore(),pending=(s.approvals||[]).filter(x=>x.status==='Pending').length,open=(s.audit||[]).length;const upcoming=(SCMS_STATE.events||[]).filter(x=>{const d=safeDate(x.date||x.event_date);return d&&d>=new Date()}).length;const set=(id,v)=>{const e=document.getElementById(id);if(e)e.textContent=v};set('op-pending',pending);set('op-open',open);set('op-events',upcoming);}
const MENU_CONFIG = {
            super_admin: [{ id: 'principal-dashboard', icon: 'fa-user-shield', label: 'Principal Dashboard' }, { id: 'dashboard', icon: 'fa-border-all', label: 'Council Dashboard' }, { id: 'tasks', icon: 'fa-clipboard-check', label: 'Tasks' }, { id: 'events', icon: 'fa-calendar', label: 'Events' }, { id: 'members', icon: 'fa-user-group', label: 'Leadership & Members' }, { id: 'meetings', icon: 'fa-handshake', label: 'Meetings' }, { id: 'grievances', icon: 'fa-shield', label: 'Grievance Command' }],
            lead: [{ id: 'dashboard', icon: 'fa-border-all', label: 'Council Dashboard' }, { id: 'tasks', icon: 'fa-clipboard-check', label: 'Tasks' }, { id: 'events', icon: 'fa-calendar', label: 'Events' }, { id: 'members', icon: 'fa-user-group', label: 'Members' }, { id: 'meetings', icon: 'fa-handshake', label: 'Meetings' }, { id: 'grievances', icon: 'fa-shield', label: 'Grievances' }],
            member: [{ id: 'dashboard', icon: 'fa-border-all', label: 'Council Dashboard' }, { id: 'tasks', icon: 'fa-clipboard-check', label: 'My Tasks' }, { id: 'events', icon: 'fa-calendar', label: 'Events' }, { id: 'members', icon: 'fa-user-group', label: 'Directory' }, { id: 'meetings', icon: 'fa-handshake', label: 'Meetings' }, { id: 'grievances', icon: 'fa-shield', label: 'Grievances' }],
            default: [{ id: 'dashboard', icon: 'fa-border-all', label: 'Council Dashboard' }, { id: 'tasks', icon: 'fa-clipboard-check', label: 'My Tasks' }, { id: 'events', icon: 'fa-calendar', label: 'Events' }, { id: 'members', icon: 'fa-user-group', label: 'Directory' }]
        };

        // ---------- CLIENT SESSION UI ----------
        function slugifyName(name){ return name.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g,'.').replace(/^\.|\.$/g,''); }
        function roleKey(role){
            const map={'Principal':'super_admin','President':'president','Vice-President':'vice_president','General Secretary':'general_secretary','Joint Secretary':'secretary','Treasurer':'treasurer','Faculty Coordinator':'faculty_coordinator','Student Welfare Secretary':'student_welfare_representative',"Women\'s Representative":"women_representative",'Training & Placement Representative':'tnp_representative'};
            return map[role] || 'committee_member';
        }
        function makeFrontendCredentials(){
            const roster=OFFICIAL_ROSTER.map((m,i)=>{
                const email=slugifyName(m.name)+'@scms.local';
                const base=m.name.split(/\s+/)[0].toUpperCase().replace(/[^A-Z]/g,'').slice(0,8)||'SCMS';
                const password=`SCMS-${base}-2026`;
                return {...m,email,password,role:'member'};
            });
            roster.push({id:'principal',name:'Principal Administrator',role_name:'Principal / Super Admin',team:'Administration',department:'Principal Office',email:'principal@orbita.local',password:'Principal@2026',role:'super_admin'});
            return roster;
        }
        function seedLocalDB(){
            let db; try{db=JSON.parse(localStorage.getItem(LOCAL_DB_KEY)||'null');}catch{db=null;}
            // Clean operational database: preserve official roster, but NEVER seed demo tasks/events/meetings.
            const members=makeFrontendCredentials().map((m,i)=>({...m,id:i+1,department:m.department||m.team}));
            if(!db || db.__schema_version !== 2){
                db={members,tasks:[],events:[],meetings:[],finances:[],grievances:[],announcements:[],goals:[],documents:[],approvals:[],notifications:[],audit_logs:[],team_budgets:{},budget_transactions:[],projects:[],version:2,__schema_version:2};
                localStorage.setItem(LOCAL_DB_KEY,JSON.stringify(db));
            } else {
                db.members=members;
                db.tasks=Array.isArray(db.tasks)?db.tasks:[]; db.events=Array.isArray(db.events)?db.events:[]; db.meetings=Array.isArray(db.meetings)?db.meetings:[];
                db.finances=Array.isArray(db.finances)?db.finances:[]; db.grievances=Array.isArray(db.grievances)?db.grievances:[];
                db.announcements=Array.isArray(db.announcements)?db.announcements:[]; db.goals=Array.isArray(db.goals)?db.goals:[];
                db.documents=Array.isArray(db.documents)?db.documents:[]; db.approvals=Array.isArray(db.approvals)?db.approvals:[];
                db.notifications=Array.isArray(db.notifications)?db.notifications:[]; db.audit_logs=Array.isArray(db.audit_logs)?db.audit_logs:[];
                db.budget_transactions=Array.isArray(db.budget_transactions)?db.budget_transactions:[]; db.projects=Array.isArray(db.projects)?db.projects:[];
                db.team_budgets=db.team_budgets||{}; db.__schema_version=2;
                localStorage.setItem(LOCAL_DB_KEY,JSON.stringify(db));
            }
            return db;
        }
        function saveLocalDB(db){ localStorage.setItem(LOCAL_DB_KEY,JSON.stringify(db)); }
        function getLocalDB(){ return seedLocalDB(); }
        function currentSession(){ try{return JSON.parse(localStorage.getItem(LOCAL_SESSION_KEY)||'null');}catch{return null;} }
        function saveSession(user){ localStorage.setItem(LOCAL_SESSION_KEY,JSON.stringify({user,loginAt:new Date().toISOString()})); }
        function clearSession(){ localStorage.removeItem(LOCAL_SESSION_KEY); localStorage.removeItem('scms_auth_token_v2'); CURRENT_USER=null; AUTH_TOKEN=null; }
        function localProfileById(id){ return getLocalDB().members.find(m=>Number(m.id)===Number(id))||null; }


        let LOGIN_MODE='council';
        function openLogin(mode='council'){
            LOGIN_MODE=mode;
            document.getElementById('home-screen')?.classList.add('hide');
            document.getElementById('login-screen')?.classList.remove('hide');
            const principal=mode==='principal';
            const title=document.getElementById('login-title'),sub=document.getElementById('login-subtitle');
            if(title)title.textContent=principal?'Principal / Super Admin Login':'Council Portal';
            if(sub)sub.textContent=principal?'Authorized institutional access':'Sign in to your council account';
            document.getElementById('principal-login-tab')?.classList.toggle('active',principal);
            document.getElementById('council-login-tab')?.classList.toggle('active',!principal);
            const email=document.getElementById('email'),pass=document.getElementById('password');
            email.value='';pass.value='';
            setTimeout(()=>email?.focus(),30);
        }
        function showPublicHome(){document.getElementById('login-screen')?.classList.add('hide');document.getElementById('app-container')?.classList.add('hide');document.getElementById('home-screen')?.classList.remove('hide');renderPublicHome();}
        function renderPublicHome(){
            const list=document.getElementById('home-leadership-list'); if(list){const leads=OFFICIAL_ROSTER.filter(x=>['President','Vice-President','General Secretary','Treasurer'].includes(x.role_name));list.innerHTML=leads.map(m=>`<div class="home-lead"><img src="https://ui-avatars.com/api/?name=${encodeURIComponent(m.name)}&background=f3e4d7&color=7a1f3d"><div><strong>${escapeHtml(m.name)}</strong><small>${escapeHtml(m.role_name)}</small></div></div>`).join('');}
            const gallery=document.getElementById('home-gallery'); if(gallery){const db=getLocalDB();const photos=(db.events||[]).flatMap(e=>(e.photos||[]).map(p=>({p,e}))).filter(x=>x.e.is_public).slice(-8).reverse();gallery.innerHTML=photos.length?photos.map(x=>`<img src="${x.p.data}" alt="${escapeHtml(x.e.title||'Event photo')}">`).join(''):'<div style="grid-column:1/-1;font-size:.7rem;color:var(--text-muted)">No public event photos yet.</div>'; }
        }
        function refreshPrincipalDashboard(){
            if(CURRENT_USER?.role!=='super_admin')return;
            const finance=SCMS_STATE.finances||[],tasks=SCMS_STATE.tasks||[],events=SCMS_STATE.events||[],grievances=SCMS_STATE.grievances||[];
            document.getElementById('principal-pending-finance').textContent=finance.filter(x=>String(x.status||'Pending')==='Pending').length;
            document.getElementById('principal-open-grievances').textContent=grievances.filter(x=>!['resolved','closed'].includes(String(x.status||'Open').toLowerCase())).length;
            document.getElementById('principal-active-tasks').textContent=tasks.filter(x=>x.status!=='Completed').length;
            document.getElementById('principal-upcoming-events').textContent=events.filter(x=>x.date&&new Date(x.date)>=new Date()).length;
            const q=document.getElementById('principal-approval-queue');
            if(q){const pending=finance.filter(x=>String(x.status||'Pending')==='Pending').slice(0,10);q.innerHTML=pending.length?pending.map(f=>`<div class="queue-item"><div><strong>${escapeHtml(f.title||'Finance request')}</strong><small>₹${Number(f.amount||0).toLocaleString('en-IN')} • ${escapeHtml(f.type||'Budget')} • ${'Awaiting Principal review'}</small></div><div class="queue-actions"><button class="small-btn" onclick="principalApproveFinance(${f.id})"><i class="fa-solid fa-check"></i> Approve</button><button class="small-btn" onclick="principalRejectFinance(${f.id})"><i class="fa-solid fa-xmark"></i> Reject</button></div></div>`).join(''):'<div class="empty-state">No pending approvals. Council workflow is clear.</div>'; }
        }
        function principalApproveFinance(id){patchData('/finances/'+id,{status:'Pending Treasury',principal_approved:true,principal_approved_at:new Date().toISOString(),principal_approved_by:CURRENT_USER?.name||'Principal'},()=>{loadFinances();refreshPrincipalDashboard()},'Principal approval recorded. Sent to Treasury for final budget approval.')}
        function principalRejectFinance(id){patchData('/finances/'+id,{status:'Rejected',principal_approved:false,principal_rejected_at:new Date().toISOString(),principal_rejected_by:CURRENT_USER?.name||'Principal'},()=>{loadFinances();refreshPrincipalDashboard()},'Finance request rejected.')}
        function canCompleteTask(t){return CURRENT_USER?.role==='super_admin'||(t?.assigned_to!=null && Number(t.assigned_to)===Number(CURRENT_USER?.id));}
        function toggleTaskCompletion(id){const t=(SCMS_STATE.tasks||[]).find(x=>Number(x.id)===Number(id));if(!t)return;if(!canCompleteTask(t)){showToast('Only the assigned member can mark this task complete.','error');return;}const next=t.status==='Completed'?'Pending':'Completed';patchData('/tasks/'+id,{status:next,completed_by:CURRENT_USER?.id,completed_at:next==='Completed'?new Date().toISOString():null},loadTasks,next==='Completed'?'Task marked complete.':'Task reopened.')}
        function generateMonthlyReport(){const t=SCMS_STATE.tasks||[],e=SCMS_STATE.events||[],m=SCMS_STATE.meetings||[],f=SCMS_STATE.finances||[],g=SCMS_STATE.grievances||[];const w=window.open('','_blank');if(!w){showToast('Please allow pop-ups for report generation.','error');return;}const done=t.filter(x=>x.status==='Completed').length,approved=f.filter(x=>x.status==='Approved').length,resolved=g.filter(x=>['Resolved','Closed','resolved','closed'].includes(x.status)).length;w.document.write(`<html><head><title>ASTRA SCMS Monthly Council Report</title><style>body{font-family:Arial;padding:34px;color:#3b1725}h1,h2{color:#7a1f3d}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.k{padding:14px;background:#fbf4ec;border:1px solid #e8d8cf;border-radius:10px}.k b{display:block;font-size:22px;color:#7a1f3d}table{width:100%;border-collapse:collapse;margin-top:22px}th,td{border:1px solid #ddd;padding:8px;font-size:11px}th{background:#f3e4d7}</style></head><body><h1>ASTRA • ORBITA MINI</h1><h2>Monthly Student Council Report</h2><p>${new Date().toLocaleString('en-IN',{month:'long',year:'numeric'})}</p><div class="grid"><div class="k"><b>${t.length}</b>Tasks</div><div class="k"><b>${done}</b>Completed</div><div class="k"><b>${e.length}</b>Events</div><div class="k"><b>${m.length}</b>Meetings</div><div class="k"><b>${f.length}</b>Finance Requests</div><div class="k"><b>${approved}</b>Approved Finance</div><div class="k"><b>${g.length}</b>Grievances</div><div class="k"><b>${resolved}</b>Resolved</div></div><h2>Task Summary</h2><table><tr><th>Task</th><th>Assignee</th><th>Status</th><th>Priority</th></tr>${t.map(x=>`<tr><td>${escapeHtml(x.title||'')}</td><td>${escapeHtml(x.assigned_name||'')}</td><td>${escapeHtml(x.status||'')}</td><td>${escapeHtml(x.priority||'')}</td></tr>`).join('')}</table><p>Generated by ASTRA • ORBITA MINI. Use Print → Save as PDF.</p><script>window.onload=()=>window.print()<\/script></body></html>`);w.document.close();}
        function exportTasksPDF(){
            const rows=SCMS_STATE.tasks||[]; const w=window.open('','_blank'); if(!w){showToast('Please allow pop-ups for PDF export.','error');return;}
            const completed=rows.filter(x=>x.status==='Completed').length, pending=rows.length-completed;
            w.document.write(`<html><head><title>ASTRA SCMS Task Report</title><style>body{font-family:Arial,sans-serif;padding:32px;color:#3b1725}h1{color:#7a1f3d}table{width:100%;border-collapse:collapse;margin-top:20px}th,td{padding:9px;border:1px solid #ddd;text-align:left;font-size:12px}th{background:#f3e4d7}.summary{padding:12px;background:#fbf4ec;border:1px solid #e8d8cf;border-radius:10px}</style></head><body><h1>ASTRA • ORBITA MINI</h1><h2>Task Report</h2><div class="summary">Total: ${rows.length} &nbsp; | &nbsp; Completed: ${completed} &nbsp; | &nbsp; Pending: ${pending} &nbsp; | &nbsp; Completion: ${rows.length?Math.round(completed/rows.length*100):0}%</div><table><tr><th>Task</th><th>Assignee</th><th>Team</th><th>Due</th><th>Status</th><th>Priority</th></tr>${rows.map(x=>`<tr><td>${escapeHtml(x.title)}</td><td>${escapeHtml(x.assigned_name||'')}</td><td>${escapeHtml(x.assigned_team||'')}</td><td>${escapeHtml(x.due_date||'')}</td><td>${escapeHtml(x.status||'Pending')}</td><td>${escapeHtml(x.priority||'')}</td></tr>`).join('')}</table><p style="margin-top:20px;color:#777">Generated ${new Date().toLocaleString('en-IN')}. Use Print → Save as PDF.</p><script>window.onload=()=>window.print()<\/script></body></html>`); w.document.close();
        }
        function collectEventFeedback(id){const text=prompt('Student feedback:');if(!text)return;const db=getLocalDB(),e=(db.events||[]).find(x=>Number(x.id)===Number(id));if(!e)return;e.feedback=Array.isArray(e.feedback)?e.feedback:[];e.feedback.push({text,created_at:new Date().toISOString(),by:CURRENT_USER?.id||null});saveLocalDB(db);loadEvents();showToast('Event feedback recorded.')}
        function exportMeetingsPDF(){const rows=SCMS_STATE.meetings||[];const w=window.open('','_blank');if(!w){showToast('Please allow pop-ups for PDF export.','error');return;}w.document.write(`<html><head><title>ASTRA SCMS Meeting Report</title><style>body{font-family:Arial;padding:32px;color:#3b1725}h1{color:#7a1f3d}table{width:100%;border-collapse:collapse}th,td{border:1px solid #ddd;padding:9px;font-size:12px}th{background:#f3e4d7}
/* Mobile-device safety overrides: also apply when Android Chrome requests Desktop Site. */
@media (hover: none) and (pointer: coarse) {
  html, body { width:100%; max-width:100%; overflow-x:hidden; }
  .home-shell { width:100%; min-height:100svh; box-sizing:border-box; padding:12px !important; align-items:flex-start; }
  .home-card { width:100% !important; max-width:100% !important; grid-template-columns:1fr !important; border-radius:22px; }
  .home-hero { padding:28px 22px !important; min-width:0; }
  .home-side { padding:24px 20px !important; border-left:0 !important; border-top:1px solid rgba(122,31,61,.10); min-width:0; }
  .home-grid { grid-template-columns:1fr 1fr; }
  .home-hero h1 { font-size:clamp(2rem,8vw,2.7rem); }
  .home-hero p { font-size:.9rem; }
  .student-gallery { grid-template-columns:repeat(2,1fr); }

  .app-wrapper { width:100% !important; max-width:100% !important; min-height:100svh; height:auto !important; margin:0 !important; padding:0 !important; border-radius:0 !important; }
  .app-inner { width:100%; min-width:0; border-radius:0 !important; }
  .app-inner > #main-header { width:100%; box-sizing:border-box; }
  .app-inner > main { width:100%; box-sizing:border-box; min-width:0; }
  .dash-layout, .dash-two-col, .power-two, .power-three, .team-layout, .finance-control-grid { grid-template-columns:1fr !important; }
  .dash-kpi-grid, .team-budget-grid, .team-performance { grid-template-columns:1fr 1fr; }
  .data-table { min-width:0; }
  .table-wrap { max-width:100%; overflow-x:auto; }
}
@media (hover: none) and (pointer: coarse) and (max-width: 600px) {
  .home-grid, .dash-kpi-grid, .team-budget-grid, .team-performance { grid-template-columns:1fr !important; }
  .home-actions { flex-direction:column; }
  .home-actions > * { width:100%; }
  .header-actions { flex-wrap:wrap; }
  .search-bar { width:100% !important; }
  .form-grid { grid-template-columns:1fr !important; }
  .modal-content { width:calc(100vw - 20px) !important; max-width:none !important; box-sizing:border-box; }
}
</style></head><body><h1>ASTRA • ORBITA MINI</h1><h2>Meeting Report</h2><table><tr><th>Meeting</th><th>Date</th><th>Time</th><th>Location</th><th>Type</th><th>Agenda</th></tr>${rows.map(x=>`<tr><td>${escapeHtml(x.title||'')}</td><td>${escapeHtml(x.date||'')}</td><td>${escapeHtml(x.time||'')}</td><td>${escapeHtml(x.location||'')}</td><td>${escapeHtml(x.type||'')}</td><td>${escapeHtml(x.agenda||'')}</td></tr>`).join('')}</table><p>Generated ${new Date().toLocaleString('en-IN')}. Use Print → Save as PDF.</p><script>window.onload=()=>window.print()<\/script></body></html>`);w.document.close();}


        window.onload = async () => {
            const CLEAN_RESET='scms_clean_state_v14';
            if(localStorage.getItem(CLEAN_RESET)!=='1'){
                ['scms_frontend_db_v1','scms_frontend_session_v1','scms_cloud_meta_v1'].forEach(k=>localStorage.removeItem(k));
                localStorage.setItem(CLEAN_RESET,'1');
            }
            AUTH_TOKEN=localStorage.getItem('scms_auth_token_v2')||'';
            toggleDarkMode(localStorage.getItem('scms_dark_mode')==='1');
            if(AUTH_TOKEN){
                try { const user=await getCurrentProfile(); if(user){ initApp(user); return; } } catch(_) { clearSession(); }
            }
            showPublicHome();
        };

        document.getElementById('login-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn=e.target.querySelector('button'),errBox=document.getElementById('login-error');
            btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Signing in...'; errBox.style.display='none';
            const email=document.getElementById('email').value.trim();
            const password=document.getElementById('password').value;
            try {
                const result = await apiFetch('/auth/login',{method:'POST',body:{email,password},skipAuth:true});
                if(!result?.token || !result?.user) throw new Error('Invalid credentials.');
                AUTH_TOKEN=result.token;
                localStorage.setItem('scms_auth_token_v2',AUTH_TOKEN);
                saveSession(result.user);
                initApp(result.user);
                showToast(`Welcome, ${result.user.name || email}!`);
            } catch(err) {
                errBox.innerHTML='<i class="fa-solid fa-circle-exclamation"></i> '+escapeHtml(err?.message || 'Invalid email or password.');
                errBox.style.display='block';
            } finally { btn.innerHTML='Access System'; }
        });

        async function logoutFrontend(){ try{ await apiFetch('/auth/logout',{method:'POST'}); }catch(_){} clearSession(); document.getElementById('app-container').classList.add('hide'); document.getElementById('password').value=''; showPublicHome(); }
        async function getCurrentProfile(){ if(!AUTH_TOKEN) return null; return await apiFetch('/auth/me',{skipAuth:false}); }
        async function fetchMe(){ const user=await getCurrentProfile(); if(user) initApp(user); }

        function initTaskAssignmentControls(){const team=document.getElementById('task-team');const assignee=document.getElementById('task-assignee');if(!team||!assignee)return;team.innerHTML='<option value="">Individual / no team</option>'+(typeof COUNCIL_TEAMS!=='undefined'?COUNCIL_TEAMS.map(t=>`<option value="${t.id}">${escapeHtml(t.name||t.title||t.id)}</option>`).join(''):'');const refresh=()=>{const tv=team.value;const teamObj=(typeof COUNCIL_TEAMS!=='undefined'?(COUNCIL_TEAMS.find(t=>t.id===tv)||null):null);const names=teamObj?[teamObj.lead,...(teamObj.members||[]).map(x=>x[0]),...(teamObj.facultyCoordinators||[]).map(x=>x[0]),teamObj.faculty].filter(Boolean).map(String):[];const members=(ALL_MEMBERS||[]).filter(m=>m.role!=='super_admin'&&(!tv||names.includes(m.name)||String(m.team||'').toLowerCase()===String(tv).toLowerCase()));assignee.innerHTML=members.map(m=>`<option value="${m.id}">${escapeHtml(m.name)} — ${escapeHtml(m.role_name||'Member')}</option>`).join('')||'<option value="">No members in this team</option>';};team.addEventListener('change',refresh);refresh();}

        function initApp(user) {
            CURRENT_USER = user;
            document.getElementById('login-screen').classList.add('hide'); 
            document.getElementById('home-screen')?.classList.add('hide');
            document.getElementById('app-container').classList.remove('hide'); 
            
            document.getElementById('user-name').innerText = user.name; 
            document.getElementById('user-role').innerText = user.role_name;
            document.getElementById('user-avatar').src = `https://ui-avatars.com/api/?name=${user.name.split(' ').map(n=>n[0]).join('')}&background=e0e7ff&color=4f46e5`;
            const dashName=document.getElementById('dash-user-name'); if(dashName) dashName.textContent=user.name; const dashRole=document.getElementById('dash-role-subtitle'); if(dashRole) dashRole.textContent=(user.role_name||'Council Member')+' Dashboard'; const dashDate=document.getElementById('dash-date-label'); if(dashDate) dashDate.textContent=new Date().toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'});

            if(user.role === 'committee_member') { document.getElementById('btn-show-task').style.display = 'none'; document.getElementById('btn-show-event').style.display = 'none'; }
            
            document.getElementById('btn-show-task')?.addEventListener('click', () => openModal('task-modal'));
            document.getElementById('btn-show-event')?.addEventListener('click', () => openModal('event-modal'));
            document.getElementById('btn-show-grievance')?.addEventListener('click', () => openModal('grievance-modal'));

            buildSidebar(user.role); wireEnhancedUI(); initTaskAssignmentControls(); loadData(); if(user.role==='super_admin'){setTimeout(()=>goToPage('principal-dashboard'),20);setTimeout(refreshPrincipalDashboard,80);}
        }

        function buildSidebar(role) {
            const nav = document.getElementById('sidebar-nav');
            const items = [...(MENU_CONFIG[role] || MENU_CONFIG['default']), { id: 'teams', icon: 'fa-people-group', label: 'Leadership & Teams' }, { id: 'analytics', icon: 'fa-chart-line', label: 'Analytics Board' }, { id: 'chat', icon: 'fa-comments', label: 'Council Chat' }, { id: 'power', icon: 'fa-bolt', label: 'Power Suite' }];
            nav.innerHTML = items.map((i, idx) => `<a href="#" class="nav-item ${idx===0?'active':''}" data-page="${i.id}"><i class="fa-solid ${i.icon}"></i> ${i.label}</a>`).join('') + `<a href="#" class="nav-item logout-btn" onclick="logoutFrontend(); return false;"><i class="fa-solid fa-arrow-right-from-bracket"></i> Logout</a>`;
            
            document.querySelectorAll('.nav-item[data-page]').forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    const page=link.getAttribute('data-page');
                    document.querySelectorAll('.nav-item[data-page]').forEach(n => n.classList.remove('active'));
                    link.classList.add('active');
                    document.querySelectorAll('.view-section').forEach(v => v.classList.add('hide'));
                    const view=document.getElementById(`view-${page}`);
                    if(view)view.classList.remove('hide');
                    SCMS_STATE.currentPage=page;
                    localStorage.setItem('scms_last_page',page);
                    if(page==='principal-dashboard')refreshPrincipalDashboard(); if(page==='analytics')refreshAnalyticsBoard();
                    if(page==='teams'){setTimeout(()=>{renderTeamDirectory(document.getElementById('team-search')?.value||'');if(!ACTIVE_TEAM_ID)showAllTeams();},20);}
                    if(page==='finance')setTimeout(()=>renderFinanceCenter(),20);
                    if(page==='chat'){renderChatList();renderChatMessages();}
                });
            });
            document.getElementById('view-dashboard').classList.remove('hide'); if(role==='super_admin'){document.getElementById('view-dashboard').classList.add('hide');document.getElementById('view-principal-dashboard')?.classList.remove('hide');}
            const last=localStorage.getItem('scms_last_page'); if(last && last!=='dashboard') setTimeout(()=>goToPage(last),50);
        }

        function loadData() { loadTasks(); loadEvents(); loadMembers(); loadMeetings(); loadFinances(); loadGrievances(); }

        async function loadTasks() {
            const tasks = await apiFetch('/tasks'); SCMS_STATE.tasks = Array.isArray(tasks) ? tasks : [];
            document.getElementById('stat-total').innerText = tasks.length; document.getElementById('stat-pending').innerText = tasks.filter(t => t.status === 'Pending').length; document.getElementById('stat-completed').innerText = tasks.filter(t => t.status === 'Completed').length;
            const pendingCount=tasks.filter(t=>String(t.status||'').toLowerCase()==='pending').length;
            const completedCount=tasks.filter(t=>String(t.status||'').toLowerCase()==='completed').length;
            const inProgressCount=tasks.filter(t=>String(t.status||'').toLowerCase().replace(/\s+/g,' ')==='in progress').length;
            const overdueCount=tasks.filter(t=>String(t.status||'').toLowerCase()==='overdue').length;
            const setDash=(id,val)=>{const el=document.getElementById(id);if(el)el.textContent=val;};
            setDash('stat-overdue',overdueCount); setDash('dash-donut-total',tasks.length);
            setDash('legend-pending',pendingCount); setDash('legend-progress',inProgressCount); setDash('legend-completed',completedCount); setDash('legend-overdue',overdueCount);
            [['legend-pending-pct',pendingCount],['legend-progress-pct',inProgressCount],['legend-completed-pct',completedCount],['legend-overdue-pct',overdueCount]].forEach(([id,n])=>setDash(id, tasks.length?Math.round(n/tasks.length*100)+'%':'0%'));
            const mine=document.getElementById('dash-my-tasks');
            if(mine) mine.innerHTML=tasks.slice(0,4).map((t,i)=>`<div class="dash-mytask"><span class="num">${i+1}</span><div><strong>${escapeHtml(t.title||'Untitled task')}</strong><small>Due: ${escapeHtml(t.due_date||'TBA')}</small></div><span class="dash-priority">${escapeHtml(t.priority||'Medium')}</span></div>`).join('') || '<div class="empty-state">No tasks assigned.</div>';

            document.getElementById('tasks-container').innerHTML = tasks.map((t) => `<div class="record-card"><div class="item-info"><span class="item-title">${escapeHtml(t.title)}</span><div class="record-meta"><span><i class="fa-solid fa-user"></i> ${escapeHtml(t.assigned_name || '-')}</span><span><i class="fa-regular fa-calendar"></i> ${escapeHtml(t.due_date || '-')}</span><span><i class="fa-solid fa-flag"></i> ${escapeHtml(t.priority || 'Medium')}</span></div><span class="item-sub">${escapeHtml(t.description || 'No description provided')}</span></div><div class="record-actions"><button class="small-btn" onclick="editTask(${t.id})" title="Edit task"><i class="fa-solid fa-pen"></i></button><button class="small-btn" onclick="deleteData('/tasks/${t.id}',loadTasks)" title="Delete task"><i class="fa-solid fa-trash"></i></button><button class="pill-badge ${t.status==='Completed'?'pill-green':'pill-orange'}" style="border:none;cursor:pointer" onclick="toggleTaskCompletion(${t.id})" title="Only the assigned member can complete this task">${escapeHtml(t.status)}${canCompleteTask(t)?'':' 🔒'}</button></div></div>`).join('') || emptyState('fa-clipboard-check','No tasks found','Create a task to start tracking council work.');
        }

        async function loadEvents() {
            const events = await apiFetch('/events'); SCMS_STATE.events = Array.isArray(events) ? events : [];
            
            // Populate Main Events
            document.getElementById('events-container').innerHTML = events.map(e => `<div class="record-card"><div class="item-info"><span class="item-title">${escapeHtml(e.title)}</span><div class="record-meta"><span><i class="fa-solid fa-calendar"></i> ${escapeHtml(e.date || 'TBA')}</span><span><i class="fa-solid fa-location-dot"></i> ${escapeHtml(e.location || 'TBA')}</span><span><i class="fa-solid fa-tag"></i> ${escapeHtml(e.type || 'Council Event')}</span></div><span class="item-sub">${escapeHtml(e.description || 'No additional details')}</span>${e.feedback_prompt?`<span class="item-sub"><i class="fa-solid fa-comment"></i> Feedback: ${escapeHtml(e.feedback_prompt)}</span>`:''}${Array.isArray(e.photos)&&e.photos.length?`<div class="event-media-grid">${e.photos.slice(0,6).map(p=>`<img src="${p.data}" alt="Event photo">`).join('')}</div>`:''}</div><span class="pill-badge pill-blue">${e.is_public?'Published':'Scheduled'}</span><button class="small-btn" onclick="collectEventFeedback(${e.id})"><i class="fa-solid fa-comment-dots"></i> Feedback</button></div>`).join('') || emptyState('fa-calendar-xmark','No events','Schedule the next council activity.');
            
            // Populate Dashboard Mini Events (Matches the Image perfectly)
            const badges = ['pill-blue', 'pill-orange', 'pill-red'];
            const dashEvents=document.getElementById('dash-events-container');
            if(dashEvents) dashEvents.innerHTML = events.slice(0,3).map((e,i)=>{const raw=String(e.date||''); const d=new Date(raw); const day=!isNaN(d)?d.getDate():''; const mon=!isNaN(d)?d.toLocaleString('en-IN',{month:'short'}).toUpperCase():'TBA'; return `<div class="dash-event"><div class="dash-event-date"><b>${day||'—'}</b><small>${mon}</small></div><div><span class="dash-event-title">${escapeHtml(e.title||'Untitled event')}</span><span class="dash-event-sub">${escapeHtml(e.type||e.location||'Council Department')}</span></div><span class="pill-badge ${badges[i%3]}">Upcoming</span></div>`;}).join('') || '<div class="empty-state">No upcoming events.</div>';
        }

        async function loadMembers() {
            const remoteMembers = await apiFetch('/members');
            ALL_MEMBERS = Array.isArray(remoteMembers) ? remoteMembers : [];
            SCMS_STATE.members = ALL_MEMBERS;
            const dash=document.getElementById('dash-members-container');
            if(dash) dash.innerHTML = ALL_MEMBERS.filter(m=>m.role_name!=='Faculty Coordinator').slice(0,4).map(m => `<div class="list-item" style="padding:0.5rem 0.2rem; background:transparent;"><div class="avatar-list-item"><div class="avatar-wrap"><img src="https://ui-avatars.com/api/?name=${encodeURIComponent(m.name)}&background=e0e7ff&color=4f46e5"><div class="online-dot"></div></div><div class="item-info"><span class="item-title" style="font-size:0.85rem">${escapeHtml(m.name)}</span><span class="item-sub" style="font-size:0.7rem; color:var(--accent-green)">${escapeHtml(m.role_name)}</span></div></div><i class="fa-solid fa-ellipsis" style="color:var(--text-muted)"></i></div>`).join('');
            const ass=document.getElementById('task-assignee');
            if(ass) ass.innerHTML = '<option value="">Select Member...</option>' + ALL_MEMBERS.filter(m=>m.role_name!=='Faculty Coordinator').map(m => `<option value="${m.id}">${escapeHtml(m.name)} — ${escapeHtml(m.role_name)}</option>`).join('');
            const mc=document.getElementById('members-container');
            if(mc) mc.innerHTML = ALL_MEMBERS.map(m => `<div class="record-card"><div class="avatar-list-item"><div class="avatar-wrap"><img src="https://ui-avatars.com/api/?name=${encodeURIComponent(m.name)}&background=e0e7ff&color=4f46e5"></div><div class="item-info"><span class="item-title">${escapeHtml(m.name)}</span><span class="item-sub">${escapeHtml(m.role_name)}</span><div class="record-meta"><span><i class="fa-solid fa-layer-group"></i> ${escapeHtml(m.team)}</span><span><i class="fa-solid fa-graduation-cap"></i> ${escapeHtml([m.class,m.branch].filter(Boolean).join(' • ') || m.department)}</span></div></div></div><span class="pill-badge ${m.role_name==='Faculty Coordinator'?'pill-blue':'pill-green'}">${m.role_name==='Faculty Coordinator'?'Faculty':'Council'}</span></div>`).join('');
        }

        async function loadMeetings() { 
            const meetings = await apiFetch('/meetings'); SCMS_STATE.meetings = Array.isArray(meetings) ? meetings : []; 
            document.getElementById('meetings-container').innerHTML = meetings.map(m => {
                const done = ['Completed','Complete','Closed','Done'].includes(m.status);
                const badge = done ? 'pill-green' : 'pill-purple';
                const status = m.status || 'Scheduled';
                const actions = done
                    ? `<span class="pill-badge ${badge}"><i class="fa-solid fa-circle-check"></i> Completed</span>`
                    : `<button class="small-btn" onclick="completeMeeting(${m.id})"><i class="fa-solid fa-circle-check"></i> Mark completed</button>`;
                return `<div class="record-card meeting-record ${done?'meeting-completed':''}">
                    <div class="item-info">
                        <span class="item-title">${escapeHtml(m.title)}</span>
                        <div class="record-meta">
                            <span><i class="fa-regular fa-calendar"></i> ${escapeHtml(m.date || 'TBA')}</span>
                            <span><i class="fa-regular fa-clock"></i> ${escapeHtml(m.time || 'TBA')}</span>
                            <span><i class="fa-solid fa-location-dot"></i> ${escapeHtml(m.location || 'TBA')}</span>
                            <span><i class="fa-solid fa-tag"></i> ${escapeHtml(m.type || 'Regular')}</span>
                        </div>
                        <span class="item-sub">${escapeHtml(m.agenda || 'No agenda provided')}</span>
                    </div>
                    <div class="record-actions"><span class="pill-badge ${badge}">${escapeHtml(status)}</span>${actions}</div>
                </div>`;
            }).join('') || emptyState('fa-handshake','No meetings scheduled','Schedule a meeting to keep the council aligned.'); 
        } 
 
        async function completeMeeting(id){
            const meeting=(SCMS_STATE.meetings||[]).find(m=>Number(m.id)===Number(id));
            if(!meeting)return;
            if(!confirm(`Mark "${meeting.title}" as completed?`))return;
            await patchData(`/meetings/${id}`,{status:'Completed'},async()=>{await loadMeetings();updateKpis();},'Meeting marked as completed!');
        }

        async function loadFinances() {
            SCMS_STATE.finances = [];
            return [];
        }

        function refreshFinanceCenter(){
            loadFinances().then(()=>showToast('Finance center refreshed.'));
        }

        function renderFinanceCenter(){
            const finances = Array.isArray(SCMS_STATE.finances) ? SCMS_STATE.finances : [];
            const q = (document.getElementById('finance-search')?.value || '').toLowerCase().trim();
            const statusFilter = document.getElementById('finance-status-filter')?.value || '';
            const typeFilter = document.getElementById('finance-type-filter')?.value || '';
            const visible = finances.filter(f => {
                const blob = [f.title,f.requester,f.type,f.department,f.vendor,f.status].join(' ').toLowerCase();
                return (!q || blob.includes(q)) && (!statusFilter || String(f.status||'Pending')===statusFilter) && (!typeFilter || String(f.type||'General')===typeFilter);
            });

            const total = finances.reduce((n,f)=>n+Number(f.amount||0),0);
            const approved = finances.filter(f=>f.status==='Approved').reduce((n,f)=>n+Number(f.amount||0),0);
            const pending = finances.filter(f=>f.status==='Pending').reduce((n,f)=>n+Number(f.amount||0),0);
            const rejected = finances.filter(f=>f.status==='Rejected').reduce((n,f)=>n+Number(f.amount||0),0);
            const count = finances.length;
            const fmt=n=>`₹${Number(n||0).toLocaleString('en-IN',{maximumFractionDigits:0})}`;

            const k=document.getElementById('finance-kpis');
            if(k) k.innerHTML = `
                <div class="finance-kpi"><span><i class="fa-solid fa-wallet"></i> Total requested</span><strong>${fmt(total)}</strong><small>${count} requests</small></div>
                <div class="finance-kpi"><span><i class="fa-solid fa-circle-check"></i> Approved</span><strong>${fmt(approved)}</strong><small>${finances.filter(f=>f.status==='Approved').length} approved</small></div>
                <div class="finance-kpi"><span><i class="fa-solid fa-hourglass-half"></i> Pending</span><strong>${fmt(pending)}</strong><small>${finances.filter(f=>f.status==='Pending').length} awaiting review</small></div>
                <div class="finance-kpi"><span><i class="fa-solid fa-circle-xmark"></i> Rejected</span><strong>${fmt(rejected)}</strong><small>${finances.filter(f=>f.status==='Rejected').length} rejected</small></div>`;

            const label=document.getElementById('finance-total-label'); if(label) label.textContent=fmt(total);
            const breakdown=document.getElementById('finance-breakdown');
            if(breakdown){
                const pct=v=>total?Math.round(v/total*100):0;
                breakdown.innerHTML=`
                    <div class="finance-meter"><div><span>Approved</span><b>${pct(approved)}%</b></div><div class="analytics-progress"><span style="width:${pct(approved)}%"></span></div></div>
                    <div class="finance-meter"><div><span>Pending</span><b>${pct(pending)}%</b></div><div class="analytics-progress"><span style="width:${pct(pending)}%"></span></div></div>
                    <div class="finance-meter"><div><span>Rejected</span><b>${pct(rejected)}%</b></div><div class="analytics-progress"><span style="width:${pct(rejected)}%"></span></div></div>`;
            }

            const typeSelect=document.getElementById('finance-type-filter');
            if(typeSelect){
                const current=typeSelect.value;
                const types=[...new Set(finances.map(f=>f.type||'General'))].sort();
                typeSelect.innerHTML='<option value="">All categories</option>'+types.map(t=>`<option value="${escapeHtml(t)}">${escapeHtml(t)}</option>`).join('');
                if(types.includes(current)) typeSelect.value=current;
            }

            const box=document.getElementById('finance-container');
            if(!box)return;
            const canReview=['super_admin','treasurer','president','faculty_coordinator','admin'].includes(CURRENT_USER?.role); const isTreasury=['super_admin','treasurer'].includes(CURRENT_USER?.role);
            box.innerHTML = visible.map(f=>{
                const status=f.status||'Pending';
                const badge=status==='Approved'?'pill-green':status==='Rejected'?'pill-red':'pill-orange';
                const review = canReview && ((status==='Pending' && CURRENT_USER?.role==='super_admin') || (status==='Pending Treasury' && isTreasury)) ? `
                    <button class="small-btn finance-approve" onclick="patchData('/finances/${f.id}',{status:'${status==='Pending Treasury'?'Approved':'Pending Treasury'}'},loadFinances,'${status==='Pending Treasury'?'Treasury approval completed!':'Sent to Treasury for final approval!'}')"><i class="fa-solid fa-check"></i> ${status==='Pending Treasury'?'Treasury Approve':'Principal Approve'}</button>
                    <button class="small-btn finance-reject" onclick="patchData('/finances/${f.id}',{status:'Rejected'},loadFinances,'Request rejected.')"><i class="fa-solid fa-xmark"></i> Reject</button>` : '';
                return `<div class="record-card finance-record">
                    <div class="finance-record-main">
                        <div class="finance-icon"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                        <div class="item-info">
                            <span class="item-title">${escapeHtml(f.title)} <strong>${fmt(f.amount)}</strong></span>
                            <div class="record-meta">
                                <span><i class="fa-solid fa-user"></i> ${escapeHtml(f.requester || '-')}</span>
                                <span><i class="fa-solid fa-layer-group"></i> ${escapeHtml(f.type || 'General')}</span>
                                ${f.department?`<span><i class="fa-solid fa-building"></i> ${escapeHtml(f.department)}</span>`:''}
                                ${f.vendor?`<span><i class="fa-solid fa-store"></i> ${escapeHtml(f.vendor)}</span>`:''}
                            </div>
                            ${f.justification?`<span class="item-sub">${escapeHtml(f.justification)}</span>`:''}
                        </div>
                    </div>
                    <div class="record-actions"><span class="pill-badge ${badge}">${escapeHtml(status)}</span>${review}</div>
                </div>`;
            }).join('') || emptyState('fa-receipt','No finance records','Create a funding request to start the finance workflow.');

            const vc=document.getElementById('finance-visible-count'); if(vc)vc.textContent=`${visible.length} of ${finances.length} records`;
        }

 
        async function loadGrievances() { 
            const rawGrievances = await apiFetch('/grievances'); const grievances=Array.isArray(rawGrievances)?rawGrievances:[]; SCMS_STATE.grievances=grievances; 
            document.getElementById('grievances-container').innerHTML = grievances.map(g => { 
                let badge = g.status === 'Resolved' ? 'pill-green' : 'pill-orange'; 
                const canResolve = ['lead','super_admin'].includes(CURRENT_USER?.role);
                let actions = (g.status === 'Open' && canResolve) ? `<button class="pill-badge pill-green" style="border:none; cursor:pointer;" onclick="patchData('/grievances/${g.id}', {status:'Resolved'}, loadGrievances)">Mark Resolved</button>` : `<span class="pill-badge ${badge}">${g.status}</span>`; 
                const reporter = g.is_anonymous ? 'Anonymous submission' : (g.created_by ? `Submitted by member #${g.created_by}` : 'Submitted by council member');
                return `<div class="record-card"><div class="item-info"><span class="item-title">${escapeHtml(g.subject)}</span><div class="record-meta"><span><i class="fa-solid fa-user-shield"></i> ${escapeHtml(reporter)}</span></div><span class="item-sub">${escapeHtml(g.description)}</span></div><div class="record-actions">${actions}</div></div>`; 
            }).join('') || '<p style="color:var(--text-muted);">No active grievances.</p>'; 
        } 
 
        // ---------- FASTAPI DATA ADAPTER ----------
        // The frontend UI remains unchanged; all persistent application reads/writes go through FastAPI.
        async function apiFetch(endpoint, options={}){
            const method=(options.method||'GET').toUpperCase();
            const headers={'Content-Type':'application/json',...(options.headers||{})};
            if(AUTH_TOKEN && options.skipAuth!==true) headers.Authorization=`Bearer ${AUTH_TOKEN}`;
            let body=options.body;
            if(body!==undefined && typeof body!=='string') body=JSON.stringify(body);
            const base=(window.ORBITA_API_BASE||'').replace(/\/$/,'');
            if(!base){ throw new Error('Backend API URL is not configured. Set ORBITA_API_BASE for this deployment.'); }
            let response;
            try {
                response=await fetch(base+'/api'+endpoint,{method,headers,body,cache:'no-store'});
            } catch(e) { throw new Error('Backend unavailable. Start the Orbita FastAPI server and try again.'); }
            const data=await response.json().catch(()=>({}));
            if(!response.ok) {
                if(response.status===401) clearSession();
                throw new Error(data.detail || data.error || `API request failed (${response.status})`);
            }
            return data;
        }

        async function postData(endpoint, payload, callback, successMsg){
            try{
                await apiFetch(endpoint,{method:'POST',body:payload});
                if(callback) await callback();
                showToast(successMsg || 'Created successfully.');
                updateNotifications();
            }catch(e){ showToast(e.message || 'Operation failed.','error'); }
        }

        async function patchData(endpoint, payload, callback, successMsg='Updated successfully!'){
            try{
                await apiFetch(endpoint,{method:'PATCH',body:payload});
                if(callback) await callback();
                showToast(successMsg);
                updateNotifications();
            }catch(e){ showToast(e.message || 'Permission denied or update failed.','error'); }
        }

        async function deleteData(endpoint, callback, successMsg='Deleted successfully.'){
            if(!confirm('Delete this record? This action cannot be undone.')) return;
            try{
                await apiFetch(endpoint,{method:'DELETE'});
                if(callback) await callback();
                showToast(successMsg);
                updateNotifications();
            }catch(e){ showToast(e.message || 'Delete failed. The local data store may not allow deletion.','error'); }
        }

        function downloadDataUrl(data,filename){const a=document.createElement('a');a.href=data;a.download=filename;a.click();}
        function downloadBlob(content, filename, type='text/plain'){
            const url=URL.createObjectURL(new Blob([content],{type}));
            const a=document.createElement('a'); a.href=url; a.download=filename; a.click();
            setTimeout(()=>URL.revokeObjectURL(url),500);
        }

        function toCSV(rows){
            if(!rows || !rows.length) return '';
            const keys=[...new Set(rows.flatMap(r=>Object.keys(r||{})))];
            return [keys,...rows.map(r=>keys.map(k=>r?.[k] ?? ''))]
                .map(row=>row.map(v=>`"${String(v??'').replaceAll('"','""')}"`).join(',')).join('\\n');
        }

        function escapeHtml(value=''){ 
            return String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c])); 
        } 
 
        function emptyState(icon,title,text){ 
            return `<div class="empty-state"><i class="fa-solid ${icon}"></i><strong>${escapeHtml(title)}</strong><span>${escapeHtml(text)}</span></div>`; 
        } 
 
        function filterList(containerId, query){ 
            const q = (query || '').toLowerCase().trim(); 
            document.querySelectorAll(`#${containerId} > *`).forEach(el => { 
                el.style.display = !q || el.innerText.toLowerCase().includes(q) ? '' : 'none'; 
            }); 
        } 
 
        async function refreshAll(){ 
            showToast('Refreshing council data...'); 
            await loadData(); 
            showToast('Dashboard refreshed.'); 
        } 
 
        function exportCouncilData(){ 
            const payload = { 
                exported_at: new Date().toISOString(), 
                user: CURRENT_USER, 
                note: 'SCMS client-side export snapshot' 
            }; 
            const blob = new Blob([JSON.stringify(payload,null,2)],{type:'application/json'}); 
            const url = URL.createObjectURL(blob); 
            const a = document.createElement('a'); 
            a.href=url; a.download='scms-council-snapshot.json'; a.click(); 
            URL.revokeObjectURL(url); 
            showToast('Export created.'); 
        } 
 
        async function loadData(){ 
            await Promise.allSettled([loadTasks(),loadEvents(),loadMembers(),loadMeetings(),loadFinances(),loadGrievances()]); 
            updateKpis(); 
        } 
 

        function updateCouncilPulse(){
            const tasks=SCMS_STATE.tasks||[], events=SCMS_STATE.events||[], meetings=SCMS_STATE.meetings||[];
            const members=SCMS_STATE.members||[], grievances=SCMS_STATE.grievances||[];
            const completed=tasks.filter(t=>String(t.status||'').toLowerCase()==='completed').length;
            const openGrievances=grievances.filter(g=>!['resolved','closed'].includes(String(g.status||'').toLowerCase())).length;
            const delivery=tasks.length?Math.round((completed/tasks.length)*100):0;
            const engagement=Math.max(0,Math.min(100,Math.round(48 + Math.min(28,members.length*1.5) + Math.min(14,events.length*4) + Math.min(10,meetings.length*3))));
            const response=grievances.length?Math.round(((grievances.length-openGrievances)/grievances.length)*100):100;
            const clamp=n=>Math.max(8,Math.min(96,n));
            const set=(id,val)=>{const el=document.getElementById(id);if(el)el.textContent=`${val}%`};
            set('pulse-engagement',engagement); set('pulse-delivery',delivery);
            const valuesA=[engagement*.78,engagement*.94,delivery*.72,Math.max(delivery,engagement)*.92,response*.82,Math.max(engagement,response)*.9,Math.max(engagement,delivery,response)];
            const valuesB=[delivery*.72,response*.9,engagement*.78,Math.max(delivery,response)*.86,engagement*.88,Math.max(engagement,response)*.82,Math.max(engagement,delivery)*.96];
            const makePath=(vals,base=138)=>{const pts=vals.map((v,i)=>({x:i*83.3333333333,y:clamp(base-(v/100)*112)}));let d=`M${pts[0].x},${pts[0].y}`;for(let i=1;i<pts.length;i++){const p=pts[i-1],q=pts[i],mx=(p.x+q.x)/2;d+=` C${mx},${p.y} ${mx},${q.y} ${q.x},${q.y}`}return {d,pts}};
            const a=makePath(valuesA),b=makePath(valuesB,144);
            const area=(path,base)=>`${path} L500,${base} L0,${base} Z`;
            const setAttr=(id,name,val)=>document.getElementById(id)?.setAttribute(name,val);
            setAttr('pulse-line-a','d',a.d);setAttr('pulse-area-a','d',area(a.d,150));
            setAttr('pulse-line-b','d',b.d);setAttr('pulse-area-b','d',area(b.d,150));
            const point=a.pts[4]; setAttr('pulse-dot','cx',point.x);setAttr('pulse-dot','cy',point.y);
            setAttr('pulse-dot-ring','cx',point.x);setAttr('pulse-dot-ring','cy',point.y);
        }

        async function updateKpis(){ 
            const getCount = id => document.querySelectorAll(`#${id} .record-card`).length; 
            const taskOpen = document.querySelectorAll('#tasks-container .pill-orange').length; 
            const eventCount = getCount('events-container'); 
            const meetingCount = getCount('meetings-container'); 
            const grievanceOpen = document.querySelectorAll('#grievances-container .pill-orange').length; 
            const a=document.getElementById('kpi-open'), b=document.getElementById('kpi-events'), c=document.getElementById('kpi-meetings'), d=document.getElementById('kpi-grievances'); 
            if(a)a.innerText=taskOpen; if(b)b.innerText=eventCount; if(c)c.innerText=meetingCount; if(d)d.innerText=grievanceOpen; 
            updateCouncilPulse();
        } 
 

        function editTask(id){
            const t=SCMS_STATE.tasks.find(x=>String(x.id)===String(id)); if(!t)return;
            document.getElementById('task-title').value=t.title||'';
            document.getElementById('task-desc').value=t.description||'';
            document.getElementById('task-date').value=t.due_date||'';
            const team=document.getElementById('task-team'); if(team)team.value=t.assigned_team||''; const ass=document.getElementById('task-assignee'); if(team)team.dispatchEvent(new Event('change')); if(ass)ass.value=t.assigned_to||'';
            document.getElementById('task-status').value=t.status||'Pending';
            document.getElementById('task-priority').value=t.priority||'Medium';
            SCMS_STATE.editing={type:'task',id:t.id};
            openModal('task-modal');
        }

        document.getElementById('form-task').addEventListener('submit', e => { 
            e.preventDefault(); 
            const assigned = document.getElementById('task-assignee').value; 
            if(!assigned){ showToast('Please select an assignee.','error'); return; } 
            postData('/tasks', { 
                title: document.getElementById('task-title').value.trim(), 
                description: document.getElementById('task-desc').value.trim(), 
                assigned_to: parseInt(assigned),
                assigned_team: document.getElementById('task-team')?.value || '',
                category: document.getElementById('task-category')?.value || 'Other',
                priority: document.getElementById('task-priority')?.value || 'Medium',
                status: document.getElementById('task-status')?.value || 'Pending',
                due_date: document.getElementById('task-date').value 
            }, async ()=>{ await loadTasks(); updateKpis(); }, 'Task assigned successfully!'); 
            closeModal('task-modal'); e.target.reset(); 
        }); 
 
        document.getElementById('form-event').addEventListener('submit', async e => {
            e.preventDefault();
            const files=[...(document.getElementById('event-photos')?.files||[])].slice(0,8);
            const photos=[];
            for(const file of files){ if(!file.type.startsWith('image/')) continue; if(file.size>4*1024*1024){showToast('Each event photo must be 4MB or smaller.','error');return;} photos.push({name:file.name,type:file.type,data:await new Promise(resolve=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.readAsDataURL(file);})}); }
            postData('/events', { title:document.getElementById('event-title').value.trim(), date:document.getElementById('event-date').value, location:document.getElementById('event-location').value.trim(), description:document.getElementById('event-desc').value.trim(), type:document.getElementById('event-type').value, priority:document.getElementById('event-priority').value, organizer:document.getElementById('event-organizer').value.trim(), is_public:document.getElementById('event-public').checked, registration_enabled:document.getElementById('event-registration').checked, feedback_prompt:document.getElementById('event-feedback-prompt').value.trim(), photos }, async()=>{await loadEvents();renderPublicHome();updateKpis();}, 'Event scheduled successfully!');
            closeModal('event-modal'); e.target.reset();
        }); 
 
        document.getElementById('form-meeting').addEventListener('submit', e => { 
            e.preventDefault(); 
            postData('/meetings', {
                title: document.getElementById('meeting-title').value.trim(),
                date: document.getElementById('meeting-date').value,
                time: document.getElementById('meeting-time')?.value || '',
                location: document.getElementById('meeting-location')?.value.trim() || '',
                type: document.getElementById('meeting-type')?.value || 'Regular',
                agenda: document.getElementById('meeting-agenda').value.trim()
            }, async ()=>{ await loadMeetings(); updateKpis(); }, 'Meeting scheduled!'); 
            closeModal('meeting-modal'); e.target.reset(); 
        }); 
 
        document.getElementById('form-finance').addEventListener('submit', e => { 
            e.preventDefault(); 
            const amount = parseFloat(document.getElementById('finance-amount').value); 
            if(!amount || amount <= 0){ showToast('Enter a valid amount.','error'); return; } 
            postData('/finances', { 
                title: document.getElementById('finance-title').value.trim(), 
                amount, 
                type: document.getElementById('finance-type').value 
            }, loadFinances, 'Funds requested successfully!'); 
            closeModal('finance-modal'); e.target.reset(); 
        }); 
 
        document.getElementById('form-grievance').addEventListener('submit', e => { 
            e.preventDefault(); 
            postData('/grievances', { 
                subject: document.getElementById('g-subject').value.trim(), 
                description: document.getElementById('g-desc').value.trim(), 
                is_anonymous: document.getElementById('g-anon').checked 
            }, async ()=>{ await loadGrievances(); updateKpis(); }, 'Grievance submitted successfully!'); 
            closeModal('grievance-modal'); e.target.reset(); 
        }); 
 
        // Global search: searches the currently visible workspace. 
        document.querySelector('.search-bar input')?.addEventListener('input', e => { 
            const q=e.target.value.toLowerCase().trim(); 
            const active=document.querySelector('.view-section:not(.hide)'); 
            if(!active)return; 
            active.querySelectorAll('.record-card,.list-item').forEach(el=>{ 
                el.style.display=!q || el.innerText.toLowerCase().includes(q)?'':'none'; 
            }); 
        }); 
 
        // Escape key closes open dialogs. 
        document.addEventListener('keydown', e => { 
            if(e.key === 'Escape') document.querySelectorAll('.modal.show').forEach(m=>closeModal(m.id)); 
        }); 
 
