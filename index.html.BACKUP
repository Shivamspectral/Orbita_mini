          <button id="btn-show-task"><i class="fa-solid fa-plus"></i>Assign Task</button>
          <button id="btn-show-event"><i class="fa-regular fa-calendar"></i>Create Event</button>
          <button onclick="document.querySelector('[data-page=\'members\']').click()"><i class="fa-solid fa-users"></i>Add Member</button>
          <button onclick="document.querySelector('[data-page=\'announcements\']')?.click()"><i class="fa-solid fa-bullhorn"></i>New Announcement</button>
          <button onclick="addPowerDocument()"><i class="fa-solid fa-folder-open"></i>Upload Document</button>
          <button onclick="generateMonthlyReport()"><i class="fa-solid fa-chart-column"></i>Monthly Report</button>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="view-operations" class="view-section hide">
                    <div class="card"><div class="section-header"><div><h3>Operations Hub</h3><p style="color:var(--text-muted);font-size:.75rem">Manage governance, students, attendance, approvals and documents from one place.</p></div><div class="report-actions"><button class="small-btn" onclick="exportFullSnapshot()"><i class="fa-solid fa-download"></i> Backup</button><button class="small-btn" onclick="printCurrentView()"><i class="fa-solid fa-print"></i> Print</button></div></div>
                        <div class="module-grid">
                            <div class="module-tile" onclick="openFeatureModal('attendance')"><i class="fa-solid fa-user-check"></i><strong>Attendance</strong><small>Meetings, events, QR check-in</small></div>
                            <div class="module-tile" onclick="openFeatureModal('approvals')"><i class="fa-solid fa-stamp"></i><strong>Approvals</strong><small>Events, budgets and purchases</small></div>
                            <div class="module-tile" onclick="openFeatureModal('documents')"><i class="fa-solid fa-folder-open"></i><strong>Documents</strong><small>Minutes, proposals, bills</small></div>
                            <div class="module-tile" onclick="openFeatureModal('students')"><i class="fa-solid fa-graduation-cap"></i><strong>Student Directory</strong><small>Profiles, participation, certificates</small></div>
                            <div class="module-tile" onclick="openFeatureModal('elections')"><i class="fa-solid fa-check-to-slot"></i><strong>Elections</strong><small>Candidates, voting and results</small></div>
                            <div class="module-tile" onclick="openFeatureModal('reports')"><i class="fa-solid fa-file-lines"></i><strong>Reports Center</strong><small>Monthly and semester reports</small></div>
                            <div class="module-tile" onclick="openFeatureModal('certificates')"><i class="fa-solid fa-certificate"></i><strong>Certificates</strong><small>Generate participation certificates</small></div>
                            <div class="module-tile" onclick="openFeatureModal('announcements')"><i class="fa-solid fa-bullhorn"></i><strong>Announcements</strong><small>Publish council-wide updates</small></div>
                            <div class="module-tile" onclick="openFeatureModal('audit')"><i class="fa-solid fa-shield-halved"></i><strong>Audit Log</strong><small>Track sensitive system actions</small></div>
                        </div>
                    </div>
                    <div class="bottom-row" style="display:grid;grid-template-columns:1.4fr 1fr;gap:1rem;margin-top:1rem"><div class="card"><div class="section-header"><h3>Approval Pipeline</h3></div><div class="approval-flow"><div class="approval-step done">Proposal<br><b>Submitted</b></div><span class="approval-arrow">→</span><div class="approval-step">Faculty<br><b>Review</b></div><span class="approval-arrow">→</span><div class="approval-step">Council<br><b>Approval</b></div><span class="approval-arrow">→</span><div class="approval-step">Execution<br><b>Ready</b></div></div></div><div class="card"><div class="section-header"><h3>Operations Health</h3></div><div class="form-grid-compact"><div class="kpi-mini"><b id="op-pending">0</b><span>Pending approvals</span></div><div class="kpi-mini"><b id="op-open">0</b><span>Open issues</span></div><div class="kpi-mini"><b id="op-events">0</b><span>Upcoming events</span></div><div class="kpi-mini"><b id="op-attendance">—</b><span>Attendance</span></div></div></div></div>
                </div>

                <div id="feature-modal" class="modal hide"><div class="modal-content" style="max-width:760px"><div class="modal-head"><h3 id="feature-title">Module</h3><button class="small-btn" onclick="closeModal('feature-modal')"><i class="fa-solid fa-xmark"></i></button></div><div id="feature-body"></div></div></div>

                <!-- OTHER VIEWS (Tasks, Events, etc.) styled universally -->
                <div id="view-tasks" class="view-section hide"><div class="card"><div class="view-toolbar"><div><div class="section-header" style="margin:0"><h3>Task Center</h3></div><p style="color:var(--text-muted);font-size:.78rem">Assign, monitor and close council work.</p></div><div class="toolbar-actions"><input class="toolbar-input" id="task-search" placeholder="Search tasks..." oninput="filterList('tasks-container',this.value)"><button class="small-btn" onclick="exportDataset('tasks')"><i class="fa-solid fa-file-csv"></i> CSV</button><button class="small-btn" onclick="exportTasksPDF()"><i class="fa-solid fa-file-pdf"></i> PDF Report</button><button class="small-btn" onclick="openModal('task-modal')"><i class="fa-solid fa-plus"></i> New Task</button></div></div><div class="list-group" id="tasks-container"></div></div></div>
                <div id="view-events" class="view-section hide"><div class="card"><div class="view-toolbar"><div><div class="section-header" style="margin:0"><h3>Event Management</h3></div><p style="color:var(--text-muted);font-size:.78rem">Plan and track all council activities.</p></div><div class="toolbar-actions"><input class="toolbar-input" id="event-search" placeholder="Search events..." oninput="filterList('events-container',this.value)"><button class="small-btn" onclick="exportDataset('events')"><i class="fa-solid fa-file-csv"></i> Export</button><button class="small-btn" onclick="openModal('event-modal')"><i class="fa-solid fa-plus"></i> New Event</button></div></div><div class="list-group" id="events-container"></div></div></div>
                <div id="view-members" class="view-section hide"><div class="card"><div class="view-toolbar"><div><div class="section-header" style="margin:0"><h3>Member Directory</h3></div><p style="color:var(--text-muted);font-size:.78rem">Council leadership, committee members and roles.</p></div><input class="toolbar-input" id="member-search" placeholder="Search members..." oninput="filterList('members-container',this.value)"></div><div id="members-container" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:1rem;"></div></div></div>
                <div id="view-meetings" class="view-section hide"><div class="card"><div class="view-toolbar"><div><div class="section-header" style="margin:0"><h3>Meeting Management</h3></div><p style="color:var(--text-muted);font-size:.78rem">Schedule discussions and keep the council aligned.</p></div><div class="toolbar-actions"><input class="toolbar-input" id="meeting-search" placeholder="Search meetings..." oninput="filterList('meetings-container',this.value)"><button class="small-btn" onclick="exportDataset('meetings')"><i class="fa-solid fa-file-csv"></i> CSV</button><button class="small-btn" onclick="exportMeetingsPDF()"><i class="fa-solid fa-file-pdf"></i> PDF Report</button><button class="small-btn" onclick="openModal('meeting-modal')"><i class="fa-solid fa-plus"></i> Schedule</button></div></div><div class="list-group" id="meetings-container"></div></div></div>
                <div id="view-finance" class="view-section hide">
                    <div class="card" style="padding:2.2rem;text-align:center;max-width:900px;margin:2rem auto">
                        <div style="width:64px;height:64px;border-radius:18px;display:grid;place-items:center;background:rgba(122,31,61,.08);color:var(--wine);margin:0 auto 1rem;font-size:1.5rem"><i class="fa-solid fa-chart-pie"></i></div>
                        <div class="profile-chip" style="display:inline-flex">Future Module</div>
                        <h2 style="margin:.75rem 0 .4rem">Finance &amp; Budget</h2>
                        <p style="color:var(--text-muted);max-width:620px;margin:0 auto;line-height:1.6">Finance requests, budgets, approvals, treasury workflows and spending analytics will come in a future update. The current release keeps these controls disabled while the finance module is being developed.</p>
                    </div>
                </div>
                <div id="view-grievances" class="view-section hide"><div class="card"><div class="view-toolbar"><div><div class="section-header" style="margin:0"><h3>Student Grievances</h3></div><p style="color:var(--text-muted);font-size:.78rem">Securely review and resolve student concerns.</p></div><div class="toolbar-actions"><input class="toolbar-input" id="grievance-search" placeholder="Search grievances..." oninput="filterList('grievances-container',this.value)"><button class="small-btn" onclick="exportDataset('grievances')"><i class="fa-solid fa-file-csv"></i> Export</button><button class="small-btn" onclick="openModal('grievance-modal')"><i class="fa-solid fa-plus"></i> New Ticket</button></div></div><div class="list-group" id="grievances-container"></div></div></div>


