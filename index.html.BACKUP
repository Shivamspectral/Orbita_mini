<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#7a1f3d">
    <link rel="manifest" href="manifest.webmanifest">
    <title>Siddhant College — Student Council Management System</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* --- IMAGE-MATCHING COLOR PALETTE & GLASSMORPHISM --- */
        :root {
            --bg-body: #f4eadf; /* Soft background from image */
            --bg-glass-outer: rgba(255, 255, 255, 0.4);
            --bg-glass-inner: rgba(255, 255, 255, 0.65);
            --bg-card: rgba(255, 255, 255, 0.85);
            
            --text-main: #1e293b;
            --text-muted: #64748b;
            
            --accent-blue: #7a1f3d;
            --accent-purple: #a64d68;
            --accent-light-blue: #c49a45;
            --accent-green: #10b981;
            --accent-orange: #f59e0b;
            --accent-red: #ef4444;

            --border-glass: rgba(255, 255, 255, 0.8);
            --shadow-glass: 0 8px 32px rgba(31, 38, 135, 0.1);
            --shadow-card: 0 4px 15px rgba(0, 0, 0, 0.03);
            
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Outfit', sans-serif; }
        
        body { 
            display: flex; flex-direction: column; height: 100vh; 
            background: radial-gradient(circle at top left, #ffffff, #f4eadf 50%, #ead9ce); 
            color: var(--text-main); overflow: hidden; 
        }
        
        a { text-decoration: none; color: inherit; }
        .hide { display: none !important; }

        /* --- TOAST NOTIFICATIONS --- */
        #toast-container { position: fixed; bottom: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px; }
        .toast { padding: 1rem 1.5rem; border-radius: 12px; color: white; font-weight: 500; box-shadow: var(--shadow-glass); animation: slideInRight 0.3s ease-out; display: flex; align-items: center; gap: 10px; min-width: 250px; background: rgba(255,255,255,0.9); backdrop-filter: blur(10px); color: var(--text-main); border: 1px solid var(--border-glass); }
        .toast.success i { color: var(--accent-green); }
        .toast.error i { color: var(--accent-red); }
        @keyframes slideInRight { from { transform: translateX(100%); } to { transform: translateX(0); } }

        /* --- MODALS (Adapted to Glassmorphism) --- */
        .modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(228, 234, 245, 0.7); display: flex; align-items: center; justify-content: center; z-index: 2000; backdrop-filter: blur(8px); opacity: 0; visibility: hidden; transition: var(--transition); }
        .modal.show { opacity: 1; visibility: visible; }
        .modal-content { background: rgba(255, 255, 255, 0.9); padding: 2.5rem; border-radius: 24px; width: 100%; max-width: 450px; border: 1px solid var(--border-glass); box-shadow: 0 25px 50px rgba(31, 38, 135, 0.15); transform: translateY(-20px); transition: var(--transition); }
        .modal.show .modal-content { transform: translateY(0); }
        .modal-content h3 { color: var(--text-main); margin-bottom: 1.5rem; font-size: 1.4rem; display: flex; align-items: center; gap: 10px; }
        .modal-content input, .modal-content select, .modal-content textarea { width: 100%; padding: 0.85rem 1rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 12px; font-size: 1rem; margin-bottom: 1rem; background: #f8fafc; transition: var(--transition); color: var(--text-main); }
        .modal-content input:focus, .modal-content select:focus, .modal-content textarea:focus { outline: none; border-color: var(--accent-blue); box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1); background: white; }
        .modal-actions { display: flex; gap: 1rem; margin-top: 1rem; }
        .modal-btn { flex: 1; padding: 0.85rem; border-radius: 12px; font-weight: 600; cursor: pointer; transition: var(--transition); border: none; font-size: 1rem; }
        .btn-submit { background: var(--accent-blue); color: white; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3); }
        .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(79, 70, 229, 0.4); }
        .btn-cancel { background: #f1f5f9; color: var(--text-muted); }
        .btn-cancel:hover { background: #e2e8f0; }


        /* =========================================================
           ADDITIVE SCMS ANALYTICS + IMPORTANT DASHBOARD LAYER
           Existing styles/workflows are preserved.
        ========================================================== */
        .scms-important-board{display:grid;grid-template-columns:1.35fr 1fr;gap:1.25rem;margin-top:1.25rem}
        .scms-info-card{background:rgba(255,255,255,.78);border:1px solid rgba(79,70,229,.10);border-radius:18px;padding:1.1rem;box-shadow:0 10px 30px rgba(31,38,135,.07);transition:.25s ease;position:relative;overflow:hidden}
        .scms-info-card:hover{transform:translateY(-3px);box-shadow:0 16px 36px rgba(31,38,135,.11)}
        .scms-info-card::after{content:'';position:absolute;width:110px;height:110px;border-radius:50%;right:-45px;top:-45px;background:linear-gradient(135deg,rgba(79,70,229,.12),rgba(139,92,246,.04))}
        .scms-info-title{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:.8rem}
        .scms-info-title h3{font-size:.95rem;margin:0}.scms-info-title i{color:var(--accent-blue)}
        .scms-static-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem}
        .scms-static-item{padding:.85rem;border-radius:14px;background:rgba(248,250,252,.9);border:1px solid rgba(0,0,0,.04)}
        .scms-static-item small{display:block;color:var(--text-muted);font-size:.68rem;margin-bottom:.3rem}.scms-static-item strong{font-size:.84rem}
        .scms-focus-list{display:grid;gap:.55rem}.scms-focus{display:flex;align-items:center;gap:.7rem;padding:.65rem .75rem;border-radius:12px;background:#f8fafc}.scms-focus i{width:28px;height:28px;display:grid;place-items:center;border-radius:9px;background:#f6e8df;color:var(--accent-blue);font-size:.75rem}.scms-focus span{font-size:.75rem;color:var(--text-main)}
        .analytics-grid{display:grid;grid-template-columns:1.25fr .85fr;gap:1.25rem;margin-top:1.25rem}.analytics-grid.three{grid-template-columns:repeat(3,1fr)}
        .analytics-card{background:rgba(255,255,255,.82);border:1px solid rgba(0,0,0,.06);border-radius:18px;padding:1.1rem;box-shadow:0 10px 28px rgba(31,38,135,.06);transition:.25s ease}.analytics-card:hover{transform:translateY(-2px)}
        .analytics-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem}.analytics-head h3{margin:0;font-size:.95rem}.analytics-head span{font-size:.68rem;color:var(--text-muted)}
        .bar-chart{height:190px;display:flex;align-items:flex-end;gap:.75rem;padding:.5rem .25rem 0;border-bottom:1px solid #e5e7eb}.bar-col{height:100%;flex:1;display:flex;align-items:center;justify-content:flex-end;flex-direction:column;gap:.35rem}.bar{width:70%;max-width:38px;border-radius:8px 8px 3px 3px;background:linear-gradient(180deg,var(--accent-blue),var(--accent-purple));min-height:6px;animation:barRise .8s ease both}.bar-label{font-size:.65rem;color:var(--text-muted)}.bar-value{font-size:.65rem;font-weight:700}
        @keyframes barRise{from{height:0;opacity:.2}to{opacity:1}}
        .donut-wrap{display:flex;align-items:center;gap:1rem}.analytics-donut{width:128px;height:128px;border-radius:50%;background:conic-gradient(var(--accent-blue) 0 70%,#e5e7eb 70% 100%);display:grid;place-items:center;flex-shrink:0;animation:spinIn .8s ease}.analytics-donut::after{content:'';width:82px;height:82px;background:white;border-radius:50%}.donut-center{position:absolute;font-size:1.1rem;font-weight:800}.donut-box{position:relative;display:grid;place-items:center}.legend{display:grid;gap:.6rem}.legend-row{display:flex;align-items:center;justify-content:space-between;gap:1.2rem;font-size:.72rem}.legend-dot{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:.35rem}.analytics-stat{display:flex;justify-content:space-between;align-items:center;padding:.75rem 0;border-bottom:1px solid #eef2f7}.analytics-stat:last-child{border-bottom:0}.analytics-stat b{font-size:.9rem}.analytics-progress{height:8px;background:#eef2f7;border-radius:20px;overflow:hidden;margin-top:.35rem}.analytics-progress span{display:block;height:100%;border-radius:20px;background:linear-gradient(90deg,var(--accent-blue),var(--accent-purple));animation:progressIn 1s ease}.analytics-alert{display:flex;gap:.7rem;padding:.7rem;border-radius:12px;background:#f8fafc;margin-bottom:.55rem}.analytics-alert i{margin-top:.15rem;color:var(--accent-blue)}.analytics-alert strong{font-size:.74rem;display:block}.analytics-alert small{font-size:.65rem;color:var(--text-muted)}
        @keyframes progressIn{from{width:0}}@keyframes spinIn{from{transform:scale(.75) rotate(-40deg);opacity:.2}}
        .analytics-table{width:100%;border-collapse:collapse;font-size:.72rem}.analytics-table th,.analytics-table td{text-align:left;padding:.65rem;border-bottom:1px solid #eef2f7}.analytics-table th{color:var(--text-muted);font-weight:600}.analytics-rank{font-weight:800;color:var(--accent-blue)}
        .analytics-toolbar{display:flex;gap:.55rem;flex-wrap:wrap}.analytics-btn{border:0;border-radius:10px;padding:.55rem .75rem;background:#f6e8df;color:#6d1b36;font-weight:700;cursor:pointer;font-size:.7rem}.analytics-btn:hover{transform:translateY(-1px)}
        @media(max-width:900px){.scms-important-board,.analytics-grid,.analytics-grid.three{grid-template-columns:1fr}.scms-static-grid{grid-template-columns:repeat(2,1fr)}}
        @media(max-width:560px){.scms-static-grid{grid-template-columns:1fr}.bar-chart{gap:.3rem}.analytics-card{padding:.85rem}}

        /* --- LOGIN SCREEN --- */
        #login-screen { display: flex; justify-content: center; align-items: center; height: 100vh; background: transparent; z-index: 1000; position: absolute; width: 100%; top: 0; left: 0; }
        .login-box { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(20px); padding: 3.5rem 3rem; border-radius: 24px; box-shadow: var(--shadow-glass); width: 100%; max-width: 400px; text-align: center; border: 1px solid var(--border-glass); }
        .login-box h2 { color: var(--text-main); margin-bottom: 0.5rem; font-size: 1.8rem; font-weight: 700; }
        .login-box p { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 2rem; }
        .login-box input { width: 100%; padding: 1rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 12px; font-size: 1rem; margin-bottom: 1.2rem; background: rgba(255,255,255,0.8); transition: var(--transition); }
        .login-box input:focus { outline: none; border-color: var(--accent-blue); box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1); }
        .login-box button { width: 100%; background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple)); color: white; border: none; padding: 1rem; border-radius: 12px; font-size: 1.1rem; font-weight: 600; cursor: pointer; transition: var(--transition); box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3); }
        .login-box button:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(79, 70, 229, 0.4); }
        #login-error { color: var(--accent-red); font-size: 0.9rem; margin-top: 1.2rem; display: none; font-weight: 500; }

        /* --- MASTER APP WRAPPER (The Image Frame) --- */
        .app-wrapper {
            margin: 2vh auto;
            width: 96vw; height: 96vh;
            border-radius: 30px;
            background: var(--bg-glass-outer);
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 25px 50px -12px rgba(31, 38, 135, 0.25);
            position: relative;
            display: flex; align-items: center; justify-content: center;
            padding: 12px; /* Inner gap from image */
        }
        
        /* The beautiful gradient border ring */
        .app-wrapper::before {
            content: ''; position: absolute; inset: 0; border-radius: 30px; padding: 3px;
            background: linear-gradient(135deg, var(--accent-light-blue), var(--accent-blue), var(--accent-purple));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none;
        }

        .app-inner {
            background: var(--bg-glass-inner);
            width: 100%; height: 100%;
            border-radius: 20px;
            display: flex; overflow: hidden;
            border: 1px solid var(--border-glass);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,0.4);
        }

        /* --- SIDEBAR --- */
        aside { width: 240px; display: flex; flex-direction: column; padding: 1.5rem 1rem; flex-shrink: 0; border-right: 1px solid rgba(0,0,0,0.05); }
        
        .brand-logo { display: flex; align-items: center; gap: 10px; margin-bottom: 2.5rem; padding-left: 10px; }
        .brand-logo i { font-size: 1.8rem; background: linear-gradient(135deg, var(--accent-light-blue), var(--accent-blue)); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .brand-titles h1 { font-size: 1.2rem; font-weight: 700; color: var(--text-main); margin: 0; letter-spacing: -0.5px; }
        .brand-titles p { font-size: 0.7rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }

        .nav-item { display: flex; align-items: center; gap: 1rem; padding: 0.8rem 1rem; color: var(--text-muted); font-weight: 500; cursor: pointer; transition: var(--transition); border-radius: 12px; margin-bottom: 0.2rem; }
        .nav-item i { width: 20px; text-align: center; font-size: 1.1rem; transition: var(--transition); }
        .nav-item:hover { background: rgba(255,255,255,0.5); color: var(--text-main); }
        .nav-item.active { background: white; color: var(--text-main); box-shadow: var(--shadow-card); font-weight: 600; }
        .nav-item.active i { color: var(--accent-blue); }
        
        .logout-btn { margin-top: auto; color: var(--text-muted); }
        .logout-btn:hover { background: #fee2e2; color: var(--accent-red); }

        /* --- MAIN CONTENT AREA --- */
        main { flex: 1; display: flex; flex-direction: column; overflow-y: auto; padding: 1.5rem 2.5rem; }

        /* --- HEADER (Inside Main) --- */
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
        
        .header-profile { display: flex; align-items: center; gap: 1rem; }
        .header-profile img { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 2px solid white; box-shadow: var(--shadow-card); }
        .header-profile-text p { font-size: 0.85rem; color: var(--text-muted); margin: 0; }
        .header-profile-text h4 { font-size: 1.2rem; font-weight: 700; color: var(--text-main); margin: 0; }

        .header-actions { display: flex; align-items: center; gap: 1rem; }
        .search-bar { display: flex; align-items: center; background: rgba(255,255,255,0.7); border: 1px solid var(--border-glass); border-radius: 99px; padding: 0.6rem 1.2rem; width: 250px; box-shadow: var(--shadow-card); }
        .search-bar i { color: var(--text-muted); margin-right: 8px; }
        .search-bar input { border: none; background: transparent; width: 100%; outline: none; font-size: 0.9rem; }
        
        .icon-btn { width: 40px; height: 40px; border-radius: 12px; background: rgba(255,255,255,0.7); border: 1px solid var(--border-glass); color: var(--text-muted); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: var(--transition); box-shadow: var(--shadow-card); position: relative; }
        .icon-btn:hover { background: white; color: var(--accent-blue); transform: translateY(-2px); }
        .notification-dot { position: absolute; top: 8px; right: 10px; width: 8px; height: 8px; background: var(--accent-red); border-radius: 50%; border: 2px solid white; }

        /* --- DASHBOARD GRID SYSTEM --- */
        .view-section { animation: fadeIn 0.4s ease-out; }
        
        .top-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 1.5rem; }
        .card { background: var(--bg-card); border: 1px solid var(--border-glass); border-radius: 20px; padding: 1.5rem; box-shadow: var(--shadow-card); backdrop-filter: blur(10px); }
        
        .stat-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; }
        .stat-header span { font-size: 0.9rem; font-weight: 600; color: var(--text-main); }
        .stat-header i { color: var(--text-muted); font-size: 1.2rem; }
        .stat-content { display: flex; align-items: center; gap: 15px; }
        .stat-value { font-size: 2.5rem; font-weight: 700; color: var(--text-main); line-height: 1; }
        .stat-badge { font-size: 0.8rem; font-weight: 600; color: var(--accent-green); display: flex; align-items: center; gap: 2px; }
        
        /* Specific Top Cards visuals matching image */
        .mini-chart { display: flex; align-items: flex-end; gap: 4px; height: 30px; margin-left: auto; }
        .mini-bar { width: 4px; background: var(--accent-blue); border-radius: 4px; opacity: 0.6; }
        .mini-bar:nth-child(even) { background: var(--accent-light-blue); }
        .mini-bar:nth-child(1){height:40%} .mini-bar:nth-child(2){height:70%} .mini-bar:nth-child(3){height:50%} .mini-bar:nth-child(4){height:90%} .mini-bar:nth-child(5){height:60%}
        
        .donut-placeholder { width: 50px; height: 50px; border-radius: 50%; background: conic-gradient(var(--accent-orange) 0% 25%, var(--accent-purple) 25% 60%, var(--accent-blue) 60% 85%, var(--accent-green) 85% 100%); position: relative; margin-left: auto; }
        .donut-placeholder::after { content:''; position: absolute; inset: 12px; background: white; border-radius: 50%; }

        .middle-row { display: grid; grid-template-columns: 2fr 1.1fr; gap: 1.5rem; margin-bottom: 1.5rem; }
        
        /* The beautiful SVG Chart Card */
        .chart-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
        .chart-title { font-weight: 600; font-size: 1rem; }
        .chart-legend { display: flex; gap: 1.5rem; text-align: right; }
        .chart-legend-item { display: flex; flex-direction: column; }
        .chart-legend-label { font-size: 0.75rem; color: var(--text-muted); }
        .chart-legend-val { font-size: 1.2rem; font-weight: 700; }
        
        /* Lists styling */
        .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem; }
        .section-header h3 { font-size: 1rem; font-weight: 600; }
        .dots { display: flex; gap: 3px; cursor: pointer; }
        .dots span { width: 4px; height: 4px; background: var(--text-muted); border-radius: 50%; }

        .list-group { display: flex; flex-direction: column; gap: 1rem; }
        .list-item { display: flex; justify-content: space-between; align-items: center; padding: 0.8rem; background: rgba(255,255,255,0.5); border-radius: 12px; transition: var(--transition); border: 1px solid transparent; }
        .list-item:hover { background: white; border-color: var(--border-glass); box-shadow: var(--shadow-card); transform: translateX(5px); }
        
        .item-info { display: flex; flex-direction: column; }
        .item-title { font-size: 0.95rem; font-weight: 600; color: var(--text-main); margin-bottom: 2px; }
        .item-sub { font-size: 0.75rem; color: var(--text-muted); }
        
        .pill-badge { padding: 0.3rem 0.8rem; border-radius: 99px; font-size: 0.75rem; font-weight: 600; }
        .pill-blue { background: #f3e4d7; color: var(--accent-blue); }
        .pill-orange { background: #fef3c7; color: var(--accent-orange); }
        .pill-red { background: #fee2e2; color: var(--accent-red); }
        .pill-green { background: #d1fae5; color: var(--accent-green); }

        .avatar-list-item { display: flex; align-items: center; gap: 12px; }
        .avatar-wrap { position: relative; }
        .avatar-wrap img { width: 36px; height: 36px; border-radius: 50%; border: 2px solid white; object-fit: cover;}
        .online-dot { position: absolute; bottom: 0; right: 0; width: 10px; height: 10px; background: var(--accent-green); border: 2px solid white; border-radius: 50%; }

        .btn-view-all { width: 100%; padding: 0.8rem; border-radius: 12px; background: var(--accent-blue); color: white; border: none; font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: var(--transition); box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2); margin-top: 1rem; }
        .btn-view-all:hover { background: #6d1b36; transform: translateY(-2px); }

        .action-btn-outline { background: white; border: 1px solid rgba(0,0,0,0.1); padding: 0.8rem; border-radius: 12px; display: flex; align-items: center; gap: 10px; cursor: pointer; font-weight: 600; color: var(--text-main); transition: var(--transition); width: 100%; box-shadow: 0 2px 5px rgba(0,0,0,0.02); }
        .action-btn-outline i { color: var(--accent-blue); font-size: 1.1rem; }
        .action-btn-outline:hover { border-color: var(--accent-blue); color: var(--accent-blue); transform: translateY(-2px); box-shadow: var(--shadow-card); }

    
/* =========================================================
   ENHANCED SCMS UI SYSTEM
   ========================================================= */
:root{
    --bg-body:#f6e8df;
    --surface:rgba(255,255,255,.78);
    --surface-solid:#ffffff;
    --surface-soft:#f8faff;
    --text-main:#172033;
    --text-muted:#68738a;
    --line:rgba(99,102,241,.13);
    --accent-blue:#7a1f3d;
    --accent-purple:#7c3aed;
    --accent-cyan:#0891b2;
    --accent-green:#059669;
    --accent-orange:#d97706;
    --accent-red:#dc2626;
    --shadow-soft:0 10px 35px rgba(31,41,90,.08);
    --shadow-hover:0 18px 45px rgba(31,41,90,.14);
    --radius-xl:24px;
    --radius-lg:18px;
    --radius-md:14px;
    --transition:all .25s cubic-bezier(.4,0,.2,1);
}

body{
    background:
      radial-gradient(circle at 8% 5%,rgba(129,140,248,.23),transparent 28%),
      radial-gradient(circle at 90% 8%,rgba(56,189,248,.16),transparent 24%),
      linear-gradient(135deg,#f8faff 0%,#f6e8df 52%,#e8eefb 100%);
}

.app-wrapper{
    width:min(97vw,1720px);
    height:min(96vh,1080px);
    margin:2vh auto;
    border-radius:32px;
    padding:10px;
    background:rgba(255,255,255,.34);
    box-shadow:0 30px 80px rgba(39,48,110,.18);
}

.app-inner{
    border-radius:24px;
    background:rgba(255,255,255,.64);
}

aside{
    width:255px;
    padding:1.25rem .9rem;
    background:rgba(248,250,255,.45);
}

.brand-logo{
    padding:10px 12px 18px;
    margin-bottom:1rem;
}

.brand-logo i{
    width:42px;height:42px;
    display:grid;place-items:center;
    border-radius:14px;
    color:white;
    background:linear-gradient(135deg,var(--accent-blue),var(--accent-purple));
    -webkit-text-fill-color:white;
    box-shadow:0 10px 24px rgba(79,70,229,.24);
}

.nav-item{
    padding:.82rem .95rem;
    margin-bottom:.35rem;
    border:1px solid transparent;
}

.nav-item:hover{
    background:rgba(255,255,255,.78);
    border-color:var(--line);
    transform:translateX(2px);
}

.nav-item.active{
    background:linear-gradient(135deg,rgba(255,255,255,.98),rgba(238,242,255,.96));
    border-color:rgba(79,70,229,.12);
    box-shadow:0 8px 22px rgba(31,41,90,.07);
}

main{
    padding:1.35rem 1.65rem 2rem;
    scrollbar-width:thin;
    scrollbar-color:#c7d2fe transparent;
}

header{
    position:sticky;
    top:0;
    z-index:20;
    padding:.8rem .1rem 1rem;
    margin-bottom:1rem;
    background:linear-gradient(180deg,rgba(248,250,255,.92),rgba(248,250,255,.55),transparent);
    backdrop-filter:blur(14px);
}

.header-profile img{
    width:52px;height:52px;
    border:3px solid rgba(255,255,255,.9);
}

.search-bar{
    width:320px;
    height:44px;
    border-radius:14px;
    background:rgba(255,255,255,.82);
    border-color:var(--line);
}

.search-bar:focus-within{
    border-color:rgba(79,70,229,.35);
    box-shadow:0 0 0 4px rgba(79,70,229,.08);
}

.icon-btn{
    width:44px;height:44px;
    border-radius:14px;
}

.card{
    border-radius:var(--radius-lg);
    padding:1.35rem;
    background:rgba(255,255,255,.84);
    border:1px solid rgba(255,255,255,.95);
    box-shadow:var(--shadow-soft);
    transition:var(--transition);
}

.card:hover{
    box-shadow:var(--shadow-hover);
}

.top-row,.middle-row,.bottom-row{
    gap:1rem;
}

.stat-value{
    font-size:2.25rem;
    letter-spacing:-1px;
}

.stat-badge{
    padding:.3rem .55rem;
    background:#ecfdf5;
    border-radius:99px;
}

.action-btn-outline{
    min-height:52px;
    border-radius:14px;
    background:linear-gradient(180deg,#fff,#f8faff);
}

.btn-submit{
    background:linear-gradient(135deg,var(--accent-blue),var(--accent-purple));
}

.btn-submit:hover{
    background:linear-gradient(135deg,#6d1b36,#6d28d9);
}

.modal-content{
    max-width:720px;
    max-height:90vh;
    overflow:auto;
    border-radius:26px;
    padding:1.7rem;
    background:rgba(255,255,255,.96);
}

.modal-content form{
    display:flex;
    flex-direction:column;
}

.modal-content input,
.modal-content select,
.modal-content textarea{
    min-height:46px;
    border:1px solid #dbe2f0;
    background:#f8faff;
}

.modal-content textarea{
    resize:vertical;
    min-height:105px;
}

.modal-content input:hover,
.modal-content select:hover,
.modal-content textarea:hover{
    border-color:#c7d2fe;
}

.modal-content input:focus,
.modal-content select:focus,
.modal-content textarea:focus{
    border-color:var(--accent-blue);
    background:#fff;
    box-shadow:0 0 0 4px rgba(79,70,229,.08);
}

.form-section{
    margin:.4rem 0 .75rem;
    padding:.8rem 0 .35rem;
    border-bottom:1px solid #edf0f7;
    color:#3b4560;
    font-size:.78rem;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.08em;
}

.form-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:.85rem;
}

.form-field{
    display:flex;
    flex-direction:column;
    gap:.38rem;
}

.form-field.full{
    grid-column:1/-1;
}

.form-field label{
    font-size:.78rem;
    font-weight:700;
    color:#4b5870;
}

.form-field input,
.form-field select,
.form-field textarea{
    margin:0;
}

.field-help{
    color:#8a94a8;
    font-size:.7rem;
}

.required-star{color:var(--accent-red)}

.form-checks{
    display:flex;
    flex-wrap:wrap;
    gap:1rem;
    padding:.35rem 0;
}

.form-check{
    display:flex;
    align-items:center;
    gap:.45rem;
    color:var(--text-muted);
    font-size:.85rem;
}

.form-check input{
    width:17px!important;
    height:17px!important;
    min-height:17px!important;
    margin:0!important;
}

.modal-actions{
    position:sticky;
    bottom:0;
    background:rgba(255,255,255,.94);
    padding-top:1rem;
}

.view-toolbar{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    justify-content:space-between;
    gap:.75rem;
    margin-bottom:1rem;
}

.toolbar-actions{
    display:flex;
    flex-wrap:wrap;
    gap:.55rem;
}

.toolbar-input,
.toolbar-select{
    min-height:42px;
    border:1px solid #dbe2f0;
    border-radius:12px;
    padding:.65rem .8rem;
    background:#fff;
    color:var(--text-main);
    outline:none;
}

.toolbar-input:focus,
.toolbar-select:focus{
    border-color:#a5b4fc;
    box-shadow:0 0 0 3px rgba(79,70,229,.08);
}

.small-btn{
    border:1px solid #e0e6f2;
    background:#fff;
    color:#39445a;
    border-radius:11px;
    padding:.65rem .8rem;
    cursor:pointer;
    font-weight:700;
    transition:var(--transition);
}

.small-btn:hover{
    border-color:#a5b4fc;
    color:var(--accent-blue);
    transform:translateY(-1px);
}

.record-card{
    display:grid;
    grid-template-columns:1fr auto;
    gap:1rem;
    align-items:center;
    padding:1rem;
    border:1px solid #edf0f7;
    background:linear-gradient(180deg,#fff,#fafbff);
    border-radius:15px;
    transition:var(--transition);
}

.record-card:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 24px rgba(31,41,90,.07);
    border-color:#dfe5f4;
}

.record-meta{
    display:flex;
    flex-wrap:wrap;
    gap:.45rem .8rem;
    margin-top:.4rem;
    color:var(--text-muted);
    font-size:.75rem;
}

.record-actions{
    display:flex;
    align-items:center;
    justify-content:flex-end;
    gap:.5rem;
    flex-wrap:wrap;
}

.empty-state{
    padding:2.5rem 1rem;
    text-align:center;
    color:var(--text-muted);
}

.empty-state i{
    display:block;
    font-size:2rem;
    margin-bottom:.65rem;
    color:#a5b4fc;
}

.empty-state strong{
    display:block;
    color:#46516a;
    margin-bottom:.25rem;
}

.loading-state{
    padding:1.5rem;
    text-align:center;
    color:var(--text-muted);
}

.loading-state i{margin-right:.4rem}

.kpi-grid{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:.8rem;
    margin-bottom:1rem;
}

.kpi{
    padding:1rem;
    border:1px solid #edf0f7;
    border-radius:15px;
    background:linear-gradient(180deg,#fff,#f9faff);
}

.kpi-label{
    color:var(--text-muted);
    font-size:.72rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.05em;
}

.kpi-value{
    margin-top:.25rem;
    font-size:1.35rem;
    font-weight:800;
}

.profile-chip{
    display:inline-flex;
    align-items:center;
    gap:.45rem;
    padding:.4rem .65rem;
    border-radius:99px;
    background:#f6e8df;
    color:#6d1b36;
    font-size:.72rem;
    font-weight:800;
}

.status-dot{
    width:7px;height:7px;border-radius:50%;
    background:var(--accent-green);
}

.table-wrap{overflow:auto}
.data-table{
    width:100%;
    border-collapse:collapse;
    min-width:700px;
}
.data-table th{
    text-align:left;
    padding:.75rem;
    color:#68738a;
    font-size:.72rem;
    text-transform:uppercase;
    letter-spacing:.05em;
    border-bottom:1px solid #e9edf5;
}
.data-table td{
    padding:.85rem .75rem;
    border-bottom:1px solid #f0f2f7;
    font-size:.84rem;
}

#toast-container{
    right:24px;
    bottom:24px;
}

.toast{
    border-radius:15px;
    min-width:290px;
    padding:.9rem 1.05rem;
    box-shadow:0 15px 35px rgba(31,41,90,.16);
}

@media(max-width:1100px){
    .app-wrapper{width:99vw;height:98vh;margin:1vh auto}
    aside{width:220px}
    .search-bar{width:220px}
    .top-row{grid-template-columns:1fr}
    .middle-row,.bottom-row{grid-template-columns:1fr!important}
    .kpi-grid{grid-template-columns:repeat(2,1fr)}
}

@media(max-width:780px){
    body{overflow:auto}
    .app-wrapper{height:auto;min-height:100vh;margin:0;width:100%;padding:0;border-radius:0}
    .app-inner{border-radius:0;min-height:100vh}
    aside{width:74px;padding:.8rem .45rem}
    .brand-titles,.nav-item{font-size:0}
    .brand-logo{justify-content:center;padding-left:0}
    .nav-item{justify-content:center;padding:.8rem}
    .nav-item i{font-size:1rem;margin:0}
    main{padding:1rem}
    header{align-items:flex-start;gap:.8rem}
    .header-actions{flex-wrap:wrap;justify-content:flex-end}
    .search-bar{width:min(100%,260px)}
    .header-profile-text h4{font-size:1rem}
    .form-grid{grid-template-columns:1fr}
    .form-field.full{grid-column:auto}
    .kpi-grid{grid-template-columns:1fr 1fr}
    .record-card{grid-template-columns:1fr}
}

@media(max-width:520px){
    .kpi-grid{grid-template-columns:1fr}
    .search-bar{width:100%}
    header{flex-direction:column}
    .header-actions{width:100%}
}


/* TEAM COMMAND CENTER */
.team-layout{display:grid;grid-template-columns:360px minmax(0,1fr);gap:1rem}
.team-directory{display:flex;flex-direction:column;gap:.65rem;max-height:62vh;overflow:auto;padding-right:.2rem}
.team-lead-card{display:grid;grid-template-columns:auto 1fr auto;gap:.75rem;align-items:center;padding:.8rem;border:1px solid #edf0f7;border-radius:15px;background:linear-gradient(180deg,#fff,#fafbff);cursor:pointer;transition:var(--transition)}
.team-lead-card:hover{transform:translateX(3px);border-color:#c7d2fe;box-shadow:0 8px 20px rgba(31,41,90,.07)}
.team-lead-card.active{border-color:rgba(79,70,229,.28);background:linear-gradient(135deg,#f6e8df,#fff);box-shadow:0 8px 22px rgba(79,70,229,.1)}
.team-avatar{width:45px;height:45px;border-radius:14px;display:grid;place-items:center;color:#fff;font-weight:800;box-shadow:0 8px 16px rgba(31,41,90,.1)}
.team-small{font-size:.7rem;color:var(--text-muted)}
.team-workspace{min-height:520px}
.team-hero{padding:1.2rem;border-radius:18px;background:linear-gradient(135deg,#f6e8df,#fafaff 52%,#fff);border:1px solid #e1e7f5;margin-bottom:1rem}
.team-hero-top{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}
.team-identity{display:flex;align-items:center;gap:.9rem}
.team-identity .team-avatar{width:64px;height:64px;border-radius:18px;font-size:1.15rem}
.team-identity h2{font-size:1.35rem;margin-bottom:.2rem}
.team-role{color:#59657c;font-size:.82rem;font-weight:700}
.team-meta{display:flex;gap:.45rem;flex-wrap:wrap;margin-top:.65rem}
.team-meta .pill-badge{background:#fff;border:1px solid #e7eaf3}
.team-actions{display:flex;flex-wrap:wrap;gap:.5rem}
.team-action{border:1px solid #dfe4ef;background:#fff;padding:.62rem .75rem;border-radius:12px;font-size:.76rem;font-weight:800;color:#39445a;cursor:pointer;transition:var(--transition)}
.team-action:hover{color:var(--accent-blue);border-color:#a5b4fc;transform:translateY(-1px)}
.team-tabs{display:flex;flex-wrap:wrap;gap:.4rem;padding-bottom:.8rem;margin-bottom:.9rem;border-bottom:1px solid #edf0f7}
.team-tab{border:1px solid #e3e7f0;background:#fff;border-radius:11px;padding:.55rem .75rem;font-size:.74rem;font-weight:800;color:#657087;cursor:pointer}
.team-tab.active{background:#f6e8df;border-color:#c7d2fe;color:#6d1b36}
.team-tab-panel{display:none}.team-tab-panel.active{display:block}
.team-member-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}
.team-member-card{border:1px solid #edf0f7;border-radius:15px;padding:.85rem;background:#fff;display:flex;align-items:center;justify-content:space-between;gap:.75rem}
.team-member-main{display:flex;align-items:center;gap:.7rem}
.member-mini{width:38px;height:38px;border-radius:12px;background:#f6e8df;color:#6d1b36;display:grid;place-items:center;font-size:.74rem;font-weight:800}
.team-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem;margin-bottom:1rem}
.team-stat{padding:.8rem;border-radius:14px;background:#fafbff;border:1px solid #edf0f7}
.team-stat-label{color:#7b8498;font-size:.68rem;text-transform:uppercase;letter-spacing:.05em;font-weight:800}
.team-stat-value{font-size:1.2rem;font-weight:900;margin-top:.25rem}
.team-log{display:flex;flex-direction:column;gap:.55rem}
.team-log-item{display:flex;gap:.7rem;padding:.75rem;border:1px solid #edf0f7;border-radius:13px;background:#fff}
.team-log-icon{width:32px;height:32px;border-radius:10px;display:grid;place-items:center;background:#f6e8df;color:#6d1b36;flex:0 0 auto}
.team-note{padding:.75rem;background:#f8faff;border-radius:12px;border:1px dashed #dbe2f0;color:#667189;font-size:.78rem}
.team-blue .team-avatar{background:linear-gradient(135deg,#7a1f3d,#7c3aed)}
.team-purple .team-avatar{background:linear-gradient(135deg,#7c3aed,#c026d3)}
.team-green .team-avatar{background:linear-gradient(135deg,#059669,#0d9488)}
.team-cyan .team-avatar{background:linear-gradient(135deg,#0891b2,#2563eb)}
.team-orange .team-avatar{background:linear-gradient(135deg,#d97706,#ea580c)}
.team-red .team-avatar{background:linear-gradient(135deg,#dc2626,#e11d48)}
.team-pink .team-avatar{background:linear-gradient(135deg,#db2777,#9333ea)}
.team-rose .team-avatar{background:linear-gradient(135deg,#e11d48,#be123c)}
.team-teal .team-avatar{background:linear-gradient(135deg,#0f766e,#0d9488)}
@media(max-width:1000px){.team-layout{grid-template-columns:1fr}.team-directory{max-height:none}}
@media(max-width:700px){.team-member-grid,.team-stats{grid-template-columns:1fr}.team-hero-top{flex-direction:column}}


/* === LEAD COMMAND + BUDGET UI === */
.team-budget-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.8rem;margin:.9rem 0}
.budget-card{padding:1rem;border:1px solid #e7ebf5;border-radius:16px;background:linear-gradient(180deg,#fff,#f8faff);box-shadow:0 8px 24px rgba(31,41,90,.05)}
.budget-card .label{font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;font-weight:800;color:#7a8498}
.budget-card .value{font-size:1.45rem;font-weight:850;margin-top:.3rem}
.budget-card.highlight{background:linear-gradient(135deg,#f6e8df,#f5f3ff);border-color:#c7d2fe}
.budget-progress{height:9px;border-radius:99px;background:#e9edf7;overflow:hidden;margin-top:.65rem}
.budget-progress > span{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,#7a1f3d,#7c3aed);width:0%;transition:width .5s ease}
.budget-actions{display:flex;flex-wrap:wrap;gap:.55rem;align-items:center;justify-content:space-between;margin-bottom:.7rem}
.budget-forms{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
.budget-form{padding:1rem;border:1px solid #edf0f7;border-radius:15px;background:#fff}
.budget-form h4{margin-bottom:.7rem}
.budget-form input,.budget-form select,.budget-form textarea{width:100%;padding:.7rem;border:1px solid #dbe2f0;border-radius:11px;margin-bottom:.55rem;outline:none;background:#f8faff}
.budget-form input:focus,.budget-form select:focus,.budget-form textarea:focus{border-color:#a5b4fc;box-shadow:0 0 0 3px rgba(79,70,229,.08);background:#fff}
.team-performance{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.8rem;margin-top:.85rem}
.performance-card{padding:1rem;border-radius:15px;border:1px solid #edf0f7;background:#fff}
.performance-card .metric{font-size:1.3rem;font-weight:850;margin-top:.2rem}
.performance-card small{color:#7b869a}
@media(max-width:1000px){.team-budget-grid{grid-template-columns:repeat(2,1fr)}.team-performance{grid-template-columns:repeat(2,1fr)}.budget-forms{grid-template-columns:1fr}}
@media(max-width:600px){.team-budget-grid,.team-performance{grid-template-columns:1fr}}


        /* --- ASTRA™ BRANDING --- */
        .ssav-brand {
            display:flex;
            align-items:center;
            gap:.45rem;
            margin-top:auto;
            padding:.7rem .65rem .2rem;
            color:#667189;
            font-size:.64rem;
            font-weight:800;
            letter-spacing:.06em;
            text-transform:uppercase;
            opacity:.82;
        }
        .ssav-brand .tm-mark{
            color:#7a1f3d;
            font-size:.7rem;
            vertical-align:super;
        }
        .ssav-footer{
            margin-top:1rem;
            padding:.8rem .9rem .1rem;
            text-align:center;
            color:#7a8498;
            font-size:.62rem;
            font-weight:700;
            letter-spacing:.04em;
            border-top:1px solid rgba(99,102,241,.1);
        }
        .ssav-watermark{
            position:fixed;
            left:14px;
            bottom:10px;
            z-index:3000;
            pointer-events:none;
            color:rgba(67,56,202,.18);
            font-size:.58rem;
            font-weight:900;
            letter-spacing:.08em;
            text-transform:uppercase;
        }


        /* SIDDHANT COLLEGE ENHANCEMENT LAYER */
        @keyframes scmsFadeUp { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
        @keyframes scmsFloat { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-5px)} }
        @keyframes scmsPulse { 0%,100%{box-shadow:0 0 0 0 rgba(79,70,229,.18)} 50%{box-shadow:0 0 0 9px rgba(79,70,229,0)} }
        .view-section:not(.hide){animation:scmsFadeUp .35s ease both}
        .record-card,.stat-card,.action-card,.team-card{transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}
        .record-card:hover,.stat-card:hover,.action-card:hover,.team-card:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(31,38,135,.10)}
        .brand-logo i{animation:scmsFloat 3.5s ease-in-out infinite}.nav-item:hover i{transform:scale(1.12)}
        .header-actions .icon-btn:hover{transform:translateY(-2px) scale(1.04)}
        .scms-live-dot{width:9px;height:9px;border-radius:50%;background:#10b981;display:inline-block;box-shadow:0 0 0 0 rgba(16,185,129,.4);animation:scmsPulse 2s infinite}
        .chat-shell{height:calc(100vh - 150px);min-height:520px;display:grid;grid-template-columns:280px minmax(0,1fr);background:rgba(255,255,255,.48);border:1px solid rgba(255,255,255,.82);border-radius:24px;overflow:hidden;box-shadow:0 16px 40px rgba(31,38,135,.08)}
        .chat-sidebar{border-right:1px solid rgba(0,0,0,.06);background:rgba(255,255,255,.45);display:flex;flex-direction:column;min-width:0}.chat-side-head{padding:20px 18px 14px}.chat-brand{display:flex;align-items:center;justify-content:space-between;gap:10px}.chat-brand h3{font-size:1.08rem;margin:0}.chat-brand small{color:var(--text-muted);display:block;margin-top:3px}
        .chat-search{margin:0 14px 12px;position:relative}.chat-search i{position:absolute;left:12px;top:11px;color:#94a3b8}.chat-search input{width:100%;border:1px solid rgba(0,0,0,.07);background:rgba(255,255,255,.75);border-radius:12px;padding:10px 12px 10px 34px;outline:none}.chat-list{overflow:auto;padding:4px 10px 14px}
        .chat-item{display:flex;align-items:center;gap:11px;padding:11px 10px;border-radius:14px;cursor:pointer;transition:.22s ease;margin-bottom:3px}.chat-item:hover{background:rgba(255,255,255,.8);transform:translateX(2px)}.chat-item.active{background:#fff;box-shadow:0 5px 16px rgba(31,38,135,.08)}
        .chat-avatar{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;color:#fff;font-weight:700;flex:0 0 auto;background:linear-gradient(135deg,#7a1f3d,#a64d68)}.chat-avatar.team{background:linear-gradient(135deg,#0ea5e9,#7a1f3d)}.chat-avatar.green{background:linear-gradient(135deg,#10b981,#0ea5e9)}.chat-item-main{min-width:0;flex:1}.chat-item-top{display:flex;justify-content:space-between;gap:8px}.chat-item-top strong{font-size:.88rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.chat-time{font-size:.67rem;color:#94a3b8;white-space:nowrap}.chat-preview{font-size:.73rem;color:#94a3b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:3px}
        .chat-main{display:flex;flex-direction:column;min-width:0;background:rgba(255,255,255,.28)}.chat-head{padding:16px 20px;border-bottom:1px solid rgba(0,0,0,.06);display:flex;align-items:center;justify-content:space-between;gap:15px;background:rgba(255,255,255,.55)}.chat-head-left{display:flex;align-items:center;gap:12px;min-width:0}.chat-head-title{min-width:0}.chat-head-title h3{margin:0;font-size:1rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.chat-head-title p{margin:3px 0 0;color:#94a3b8;font-size:.72rem}.chat-head-actions{display:flex;gap:7px}.chat-icon-btn{width:36px;height:36px;border:1px solid rgba(0,0,0,.06);border-radius:11px;background:#fff;color:#64748b;cursor:pointer;transition:.2s}.chat-icon-btn:hover{color:#7a1f3d;transform:translateY(-2px);box-shadow:0 5px 12px rgba(31,38,135,.08)}
        .chat-messages{flex:1;overflow:auto;padding:24px 24px 14px;scroll-behavior:smooth}.chat-day{text-align:center;color:#94a3b8;font-size:.68rem;margin:4px auto 18px;position:relative}.chat-day:before,.chat-day:after{content:'';height:1px;background:rgba(0,0,0,.06);width:28%;position:absolute;top:50%}.chat-day:before{left:0}.chat-day:after{right:0}.chat-row{display:flex;gap:9px;margin:10px 0;animation:scmsFadeUp .28s ease both}.chat-row.mine{justify-content:flex-end}.chat-mini-avatar{width:28px;height:28px;border-radius:9px;display:grid;place-items:center;color:#fff;font-size:.62rem;font-weight:700;background:linear-gradient(135deg,#64748b,#334155);flex:0 0 auto;align-self:flex-end}.chat-bubble-wrap{max-width:min(72%,650px)}.chat-sender{font-size:.68rem;color:#64748b;margin:0 0 4px 3px}.chat-bubble{padding:10px 13px;border-radius:16px 16px 16px 5px;background:#fff;border:1px solid rgba(0,0,0,.045);box-shadow:0 4px 12px rgba(31,38,135,.05);font-size:.84rem;line-height:1.45;word-break:break-word}.chat-row.mine .chat-sender{display:none}.chat-row.mine .chat-bubble{border-radius:16px 16px 5px 16px;background:linear-gradient(135deg,#7a1f3d,#6366f1);color:#fff;border:none;box-shadow:0 8px 20px rgba(79,70,229,.2)}.chat-meta{font-size:.62rem;color:#94a3b8;margin-top:4px;text-align:right}.chat-row.mine .chat-meta{color:#c7d2fe}.chat-composer{padding:14px 18px 18px;border-top:1px solid rgba(0,0,0,.06);background:rgba(255,255,255,.55)}.chat-compose-box{display:flex;align-items:flex-end;gap:9px;background:#fff;border:1px solid rgba(0,0,0,.07);border-radius:17px;padding:8px;box-shadow:0 7px 20px rgba(31,38,135,.05)}.chat-compose-box textarea{flex:1;border:0;outline:0;resize:none;background:transparent;min-height:24px;max-height:100px;padding:7px 5px;font-size:.85rem;line-height:1.4}.chat-send{width:42px;height:42px;border:0;border-radius:13px;background:linear-gradient(135deg,#7a1f3d,#7c3aed);color:#fff;cursor:pointer;box-shadow:0 7px 16px rgba(79,70,229,.25);transition:.2s}.chat-send:hover{transform:translateY(-2px) scale(1.03)}.chat-compose-tools{display:flex;align-items:center;justify-content:space-between;margin-top:7px;padding:0 4px;color:#94a3b8;font-size:.66rem}.chat-typing{height:18px;color:#64748b;font-size:.68rem;opacity:0;transition:.2s}.chat-typing.show{opacity:1}.typing-dots span{display:inline-block;width:4px;height:4px;border-radius:50%;background:#64748b;margin-left:2px;animation:scmsFloat 1s infinite}.typing-dots span:nth-child(2){animation-delay:.15s}.typing-dots span:nth-child(3){animation-delay:.3s}.chat-empty{height:100%;display:grid;place-items:center;text-align:center;color:#94a3b8;padding:40px}.chat-empty-icon{width:74px;height:74px;border-radius:24px;display:grid;place-items:center;background:linear-gradient(135deg,#f6e8df,#f5f3ff);color:#7a1f3d;font-size:1.7rem;margin:0 auto 14px;animation:scmsFloat 3s ease-in-out infinite}.chat-note{font-size:.7rem;color:#94a3b8;margin-top:8px}
        @media(max-width:900px){.chat-shell{grid-template-columns:88px 1fr}.chat-side-head{padding:14px 8px}.chat-brand>div:first-child,.chat-search input,.chat-search i,.chat-item-main,.chat-side-head small{display:none}.chat-search{margin:0 8px 10px}.chat-item{justify-content:center;padding:9px 4px}.chat-bubble-wrap{max-width:82%}}@media(max-width:650px){.chat-shell{height:calc(100vh - 130px);min-height:450px}.chat-head{padding:12px}.chat-messages{padding:18px 12px 10px}.chat-composer{padding:10px}.chat-head-actions .chat-icon-btn:nth-child(2){display:none}}

        /* =========================================================
           SCMS v4.2 PRODUCTIVITY + ADMIN ENHANCEMENT LAYER
           ========================================================= */
        .scms-settings-panel{position:fixed;right:20px;top:78px;width:min(390px,calc(100vw - 40px));z-index:2500;background:rgba(255,255,255,.97);border:1px solid #e4e8f2;border-radius:22px;box-shadow:0 24px 70px rgba(31,41,90,.2);padding:1.1rem;display:none;animation:scmsFadeUp .22s ease}
        .scms-settings-panel.show{display:block}
        .scms-settings-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem}
        .scms-settings-head h3{font-size:1rem}
        .scms-setting{padding:.85rem 0;border-bottom:1px solid #edf0f7}
        .scms-setting:last-child{border-bottom:0}
        .scms-setting-row{display:flex;align-items:center;justify-content:space-between;gap:1rem}
        .scms-setting strong{font-size:.8rem}.scms-setting small{display:block;color:var(--text-muted);font-size:.68rem;margin-top:.2rem}
        .scms-switch{position:relative;width:46px;height:26px;flex:0 0 auto}.scms-switch input{opacity:0;width:0;height:0}
        .scms-slider{position:absolute;inset:0;border-radius:99px;background:#dbe2f0;cursor:pointer;transition:.2s}
        .scms-slider:before{content:'';position:absolute;width:20px;height:20px;left:3px;top:3px;background:#fff;border-radius:50%;box-shadow:0 2px 5px rgba(0,0,0,.12);transition:.2s}
        .scms-switch input:checked + .scms-slider{background:#7a1f3d}.scms-switch input:checked + .scms-slider:before{transform:translateX(20px)}
        .scms-notification-panel{position:fixed;right:20px;top:78px;width:min(420px,calc(100vw - 40px));z-index:2500;background:rgba(255,255,255,.98);border:1px solid #e4e8f2;border-radius:22px;box-shadow:0 24px 70px rgba(31,41,90,.2);padding:1rem;display:none;animation:scmsFadeUp .22s ease}
        .scms-notification-panel.show{display:block}
        .scms-notification-list{max-height:420px;overflow:auto;display:grid;gap:.55rem}
        .scms-notice{display:flex;gap:.7rem;padding:.75rem;border:1px solid #edf0f7;border-radius:14px;background:#fafbff}
        .scms-notice i{width:30px;height:30px;border-radius:10px;background:#f6e8df;color:#6d1b36;display:grid;place-items:center;flex:0 0 auto}
        .scms-notice strong{font-size:.76rem;display:block}.scms-notice small{color:var(--text-muted);font-size:.66rem}
        .scms-unread{position:absolute;top:5px;right:6px;min-width:17px;height:17px;padding:0 4px;border-radius:99px;background:#dc2626;color:#fff;font-size:.58rem;font-weight:900;display:grid;place-items:center;border:2px solid #fff}
        .command-overlay{position:fixed;inset:0;z-index:4000;background:rgba(15,23,42,.35);backdrop-filter:blur(8px);display:none;align-items:flex-start;justify-content:center;padding-top:12vh}
        .command-overlay.show{display:flex}
        .command-box{width:min(720px,calc(100vw - 28px));background:#fff;border-radius:22px;box-shadow:0 30px 90px rgba(15,23,42,.3);overflow:hidden}
        .command-input-wrap{display:flex;align-items:center;gap:.7rem;padding:1rem 1.1rem;border-bottom:1px solid #edf0f7}
        .command-input-wrap i{color:#64748b}.command-input{border:0;outline:0;width:100%;font-size:1rem}
        .command-list{max-height:430px;overflow:auto;padding:.55rem}
        .command-item{display:flex;align-items:center;gap:.75rem;padding:.75rem;border-radius:12px;cursor:pointer}
        .command-item:hover,.command-item.active{background:#f6e8df;color:#6d1b36}
        .command-item i{width:28px;text-align:center}.command-hint{margin-left:auto;font-size:.64rem;color:#94a3b8}
        .scms-dark{--text-main:#e5e7eb;--text-muted:#9ca3af;--surface-solid:#111827}
        .scms-dark body{background:radial-gradient(circle at 8% 5%,rgba(79,70,229,.2),transparent 28%),linear-gradient(135deg,#0f172a,#111827 55%,#172033 100%)}
        .scms-dark .app-inner,.scms-dark .app-wrapper{background:rgba(15,23,42,.72)}
        .scms-dark .card,.scms-dark .record-card,.scms-dark .analytics-card,.scms-dark .team-member-card,.scms-dark .team-stat,.scms-dark .team-log-item,.scms-dark .budget-form,.scms-dark .kpi,.scms-dark .command-box,.scms-dark .scms-settings-panel,.scms-dark .scms-notification-panel{background:#111827;color:#e5e7eb;border-color:#253047}
        .scms-dark .nav-item.active,.scms-dark .list-item,.scms-dark .chat-item.active,.scms-dark .chat-bubble{background:#182235;color:#e5e7eb}
        .scms-dark .toolbar-input,.scms-dark .toolbar-select,.scms-dark .small-btn,.scms-dark .modal-content input,.scms-dark .modal-content select,.scms-dark .modal-content textarea,.scms-dark .chat-compose-box{background:#111827;color:#e5e7eb;border-color:#334155}
        .scms-dark .chat-main,.scms-dark .chat-sidebar,.scms-dark .chat-head,.scms-dark .chat-composer{background:rgba(15,23,42,.72)}
        .scms-dark .scms-notice{background:#182235;border-color:#253047}
        .scms-dark .modal-content{background:#111827;color:#e5e7eb}
        .scms-dark .modal-actions{background:#111827}
        .scms-dark .scms-settings-panel,.scms-dark .scms-notification-panel{color:#e5e7eb}
        .scms-busy{pointer-events:none;opacity:.62!important;position:relative}
        .scms-busy:after{content:'';position:absolute;inset:0;background:rgba(255,255,255,.12);border-radius:inherit}
        .scms-command-key{font-size:.62rem;padding:.15rem .35rem;border:1px solid #dbe2f0;border-radius:5px;background:#f8fafc;color:#64748b}
        @media print{
            body{background:#fff!important;overflow:visible!important}.app-wrapper{width:100%!important;height:auto!important;margin:0!important;box-shadow:none!important;padding:0!important}
            aside,.header-actions,.view-toolbar button,.view-toolbar input,.toolbar-actions,.ssav-watermark,.ssav-footer,.modal,.scms-settings-panel,.scms-notification-panel{display:none!important}
            .app-inner{display:block!important;border:0!important}.view-section.hide{display:none!important}main{padding:0!important;overflow:visible!important}
            .card,.analytics-card,.record-card{box-shadow:none!important;border:1px solid #ddd!important;break-inside:avoid}
        }
        @media(max-width:650px){.scms-settings-panel,.scms-notification-panel{right:10px;width:calc(100vw - 20px)}}


/* v4.3 COMPLETE OPERATIONS MODULES */
.module-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.module-tile{padding:1rem;border:1px solid #e7ebf3;border-radius:16px;background:rgba(255,255,255,.7);cursor:pointer;transition:.2s}.module-tile:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(31,41,90,.08)}.module-tile i{font-size:1.1rem;color:var(--accent-blue);margin-bottom:.65rem}.module-tile strong{display:block;font-size:.82rem}.module-tile small{color:var(--text-muted);font-size:.68rem}.timeline{display:grid;gap:.7rem}.timeline-item{display:flex;gap:.8rem;padding:.75rem;border-left:3px solid var(--accent-blue);background:#f8faff;border-radius:0 12px 12px 0}.timeline-item small{color:var(--text-muted)}.status-chip{display:inline-flex;padding:.25rem .55rem;border-radius:999px;font-size:.62rem;font-weight:700;background:#f6e8df;color:#6d1b36}.empty-state{text-align:center;padding:2rem;color:var(--text-muted)}.empty-state i{font-size:1.5rem;margin-bottom:.6rem}.report-actions{display:flex;flex-wrap:wrap;gap:.5rem}.report-card{border:1px solid #e7ebf3;border-radius:16px;padding:1rem;background:#fff}.form-grid-compact{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.full-span{grid-column:1/-1}.data-table{width:100%;border-collapse:collapse;font-size:.72rem}.data-table th,.data-table td{padding:.65rem;border-bottom:1px solid #edf0f6;text-align:left}.data-table th{color:var(--text-muted);font-weight:600}.qr-box{width:170px;height:170px;border:10px solid #111827;border-radius:8px;margin:auto;background:repeating-linear-gradient(45deg,#111 0 3px,#fff 3px 7px)}.approval-flow{display:flex;align-items:center;gap:.35rem;overflow:auto;padding:.5rem 0}.approval-step{min-width:110px;padding:.6rem;border-radius:12px;background:#f1f5f9;text-align:center;font-size:.65rem}.approval-step.done{background:#dcfce7;color:#166534}.approval-arrow{color:#94a3b8}.kpi-mini{padding:.8rem;border-radius:14px;background:#f8fafc}.kpi-mini b{font-size:1.15rem}.kpi-mini span{display:block;color:var(--text-muted);font-size:.65rem}@media(max-width:900px){.module-grid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.module-grid,.form-grid-compact{grid-template-columns:1fr}.full-span{grid-column:auto}}

        /* --- COUNCIL MOMENTUM: non-financial dashboard visual --- */
        .council-pulse-card{position:relative;overflow:hidden}
        .council-pulse-card::before{content:'';position:absolute;inset:-45% -10% auto auto;width:230px;height:230px;border-radius:50%;background:radial-gradient(circle,rgba(124,58,237,.12),transparent 68%);pointer-events:none}
        .pulse-subtitle{display:flex;align-items:center;gap:6px;margin-top:4px;font-size:.68rem;color:var(--text-muted)}
        .pulse-subtitle .scms-live-dot{width:7px;height:7px}
        .pulse-legend{gap:1.25rem}
        .pulse-chart-wrap{position:relative;margin-top:2px;border-radius:16px;overflow:hidden}
        .pulse-glow{position:absolute;left:22%;top:18%;width:42%;height:55%;background:radial-gradient(circle,rgba(99,102,241,.12),transparent 68%);filter:blur(12px);pointer-events:none;animation:pulseGlow 3.5s ease-in-out infinite}
        .pulse-chart{position:relative;z-index:1;overflow:visible}
        .pulse-line{fill:none;stroke-width:3.2;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:900;stroke-dashoffset:900;animation:pulseDraw 1.6s cubic-bezier(.4,0,.2,1) forwards}
        .pulse-blue-line{stroke:var(--accent-blue);filter:drop-shadow(0 5px 8px rgba(79,70,229,.16))}
        .pulse-purple-line{stroke:var(--accent-purple);filter:drop-shadow(0 5px 8px rgba(124,58,237,.13));animation-delay:.18s}
        .pulse-area{opacity:.85;animation:pulseFade 1.2s ease both}
        .pulse-dot{fill:#fff;stroke:var(--accent-blue);stroke-width:3;filter:drop-shadow(0 4px 7px rgba(79,70,229,.25));transform-box:fill-box;transform-origin:center;animation:pulseDot 2.2s ease-in-out infinite}
        .pulse-dot-ring{fill:none;stroke:rgba(79,70,229,.22);stroke-width:2;transform-box:fill-box;transform-origin:center;animation:pulseRing 2.2s ease-out infinite}
        .pulse-footer{display:grid;grid-template-columns:repeat(4,1fr);gap:.5rem;margin-top:8px;padding-top:9px;border-top:1px solid #eef2f7;color:var(--text-muted);font-size:.67rem}
        .pulse-footer span{display:flex;align-items:center;justify-content:center;gap:5px}
        .pulse-footer i{color:var(--accent-blue)}
        @keyframes pulseDraw{to{stroke-dashoffset:0}}
        @keyframes pulseFade{from{opacity:0;transform:translateY(6px)}to{opacity:.85;transform:translateY(0)}}
        @keyframes pulseDot{0%,100%{transform:scale(1)}50%{transform:scale(1.25)}}
        @keyframes pulseRing{0%{opacity:.8;transform:scale(.65)}70%,100%{opacity:0;transform:scale(1.45)}}
        @keyframes pulseGlow{0%,100%{opacity:.45;transform:scale(.95)}50%{opacity:.9;transform:scale(1.06)}}
        @media(max-width:600px){.pulse-footer{grid-template-columns:repeat(2,1fr)}.pulse-legend{gap:.7rem}.pulse-footer span{justify-content:flex-start}}

    
/* OFFICIAL COUNCIL DIRECTORY */
.official-roster-note{display:flex;align-items:center;gap:.55rem;padding:.65rem .8rem;border:1px solid rgba(128,0,32,.12);background:rgba(128,0,32,.04);border-radius:12px;color:var(--text-muted);font-size:.72rem;margin:.7rem 0 1rem}
.official-roster-note strong{color:#800020}

/* =========================================================
   SCMS ORIGINAL DASHBOARD UX — visual refresh only
   Uses the existing V7 colour tokens; no palette replacement.
   ========================================================= */
.app-inner{
  display:grid !important;
  grid-template-columns:240px minmax(0,1fr);
  grid-template-rows:auto minmax(0,1fr);
}
.app-inner > #main-header{
  grid-column:1 / -1;
  grid-row:1;
  min-height:86px;
  margin:0 !important;
  padding:1rem 1.5rem !important;
  border-bottom:1px solid var(--border-glass);
  background:rgba(255,255,255,.72);
  backdrop-filter:blur(18px);
}
.app-inner > #sidebar-wrapper{
  grid-column:1;
  grid-row:2;
  min-height:0;
  overflow-y:auto;
}
.app-inner > main{
  grid-column:2;
  grid-row:2;
  min-width:0;
  min-height:0;
  padding:1.25rem 1.5rem 1.5rem !important;
}
.scms-original-dashboard{max-width:100%}
.dash-welcome-row{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;margin:.15rem 0 1.15rem}
.dash-eyebrow{display:flex;align-items:center;gap:.45rem;color:var(--accent-blue);font-size:.68rem;font-weight:800;letter-spacing:.1em;margin-bottom:.35rem}
.live-dot{width:7px;height:7px;border-radius:50%;background:var(--accent-green);box-shadow:0 0 0 4px rgba(5,150,105,.1);animation:dashPulse 2s infinite}
.dash-welcome h1{margin:0;color:var(--text-main);font-size:1.55rem;line-height:1.15;letter-spacing:-.025em}
.dash-welcome h1 span:not(.wave){color:var(--accent-blue)}
.dash-welcome .wave{display:inline-block;animation:waveHand 2.2s ease-in-out infinite}
.dash-welcome p{margin:.35rem 0 0;color:var(--text-muted);font-size:.78rem}
.dash-date{display:flex;align-items:center;gap:.55rem;padding:.72rem .9rem;border:1px solid var(--border-glass);background:var(--surface-solid);border-radius:13px;box-shadow:var(--shadow-soft);font-size:.78rem;font-weight:700;color:var(--text-main);white-space:nowrap}
.dash-date i{color:var(--accent-blue)}
.dash-layout{display:grid;grid-template-columns:minmax(0,2.1fr) minmax(280px,.82fr);gap:1rem;align-items:start}
.dash-main-col,.dash-right-col{min-width:0;display:flex;flex-direction:column;gap:1rem}
.dash-kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.8rem}
.dash-kpi{position:relative;min-width:0;padding:1rem;border:1px solid var(--border-glass);border-radius:17px;background:var(--surface-solid);box-shadow:var(--shadow-soft);display:grid;grid-template-columns:auto 1fr;gap:.75rem;align-items:center;overflow:hidden;transition:var(--transition)}
.dash-kpi::after{content:'';position:absolute;right:-24px;top:-28px;width:90px;height:90px;border-radius:50%;background:rgba(79,70,229,.05)}
.dash-kpi:hover{transform:translateY(-3px);box-shadow:var(--shadow-hover)}
.dash-kpi-icon{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent-blue),var(--accent-purple));color:#fff;font-size:1.05rem;box-shadow:0 8px 18px rgba(79,70,229,.2)}
.dash-kpi.success .dash-kpi-icon{background:linear-gradient(135deg,var(--accent-green),#0d9488)}
.dash-kpi.danger .dash-kpi-icon{background:linear-gradient(135deg,var(--accent-red),#e11d48)}
.dash-kpi span{display:block;color:var(--text-muted);font-size:.69rem;font-weight:700}
.dash-kpi strong{display:block;font-size:1.55rem;line-height:1.05;color:var(--text-main);margin-top:.18rem}
.dash-kpi button{grid-column:1/-1;border:0;border-top:1px solid #eef1f7;background:transparent;padding:.55rem 0 0;color:var(--accent-blue);font-size:.68rem;font-weight:800;cursor:pointer;text-align:center}
.dash-kpi button:hover{color:var(--accent-purple)}
.dash-two-col{display:grid;grid-template-columns:1fr 1.08fr;gap:1rem}
.dash-card{background:var(--surface-solid);border:1px solid var(--border-glass);border-radius:18px;padding:1rem;box-shadow:var(--shadow-soft);min-width:0}
.dash-card:hover{box-shadow:var(--shadow-hover)}
.dash-card-head{display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin-bottom:.8rem}
.dash-card-head h3{margin:0;color:var(--text-main);font-size:.93rem;font-weight:800}
.dash-card-head button{border:0;background:transparent;color:var(--accent-blue);font-size:.68rem;font-weight:800;cursor:pointer;white-space:nowrap}
.dash-card-head button:hover{color:var(--accent-purple)}
.task-overview-body{display:grid;grid-template-columns:150px 1fr;align-items:center;gap:1rem;min-height:195px}
.donut-large{width:148px;height:148px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--accent-orange) 0 50%,var(--accent-blue) 50% 75%,var(--accent-green) 75% 88%,var(--accent-red) 88% 100%);position:relative;margin:auto;box-shadow:0 10px 25px rgba(31,41,90,.08)}
.donut-large::before{content:'';position:absolute;inset:11px;border-radius:50%;background:var(--surface-solid)}
.donut-large>div{position:relative;z-index:1;text-align:center}
.donut-large strong{display:block;font-size:1.55rem;color:var(--text-main);line-height:1}
.donut-large span{display:block;color:var(--text-muted);font-size:.68rem;margin-top:.25rem}
.task-legend{display:flex;flex-direction:column;gap:.72rem}
.task-legend>div{display:grid;grid-template-columns:11px 1fr auto auto;gap:.5rem;align-items:center;font-size:.72rem}
.task-legend .legend-dot{width:10px;height:10px;border-radius:3px}
.legend-dot.pending{background:var(--accent-orange)}.legend-dot.progress{background:var(--accent-blue)}.legend-dot.completed{background:var(--accent-green)}.legend-dot.overdue{background:var(--accent-red)}
.task-legend span{color:var(--text-main)}.task-legend b{font-size:.72rem;color:var(--text-main)}.task-legend small{color:var(--text-muted);min-width:34px;text-align:right}
.dash-event-list{display:flex;flex-direction:column;gap:.6rem}
.dash-event{display:grid;grid-template-columns:52px 1fr auto;gap:.65rem;align-items:center;padding:.55rem 0;border-bottom:1px solid #eef1f7}
.dash-event:last-child{border-bottom:0}
.dash-event-date{width:48px;height:48px;border-radius:11px;background:linear-gradient(145deg,var(--accent-blue),var(--accent-purple));color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:800;line-height:1}
.dash-event-date b{font-size:1rem}.dash-event-date small{font-size:.52rem;margin-top:3px;letter-spacing:.04em}
.dash-event-title{font-size:.75rem;font-weight:800;color:var(--text-main);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dash-event-sub{font-size:.62rem;color:var(--text-muted);display:block;margin-top:.2rem}
.dash-event .pill-badge{font-size:.58rem;padding:.35rem .5rem}
.portfolio-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem}
.portfolio-grid button{display:flex;align-items:center;gap:.65rem;text-align:left;border:1px solid #edf0f7;border-radius:14px;background:linear-gradient(180deg,#fff,var(--surface-soft));padding:.65rem;cursor:pointer;transition:var(--transition);color:var(--text-main)}
.portfolio-grid button:hover{transform:translateY(-2px);border-color:rgba(79,70,229,.25);box-shadow:0 8px 20px rgba(31,41,90,.07)}
.portfolio-grid button>i{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;flex:0 0 auto;background:linear-gradient(135deg,var(--accent-blue),var(--accent-purple));color:#fff;font-size:.82rem}
.portfolio-grid span{font-size:.72rem;font-weight:800;min-width:0}.portfolio-grid small{display:block;color:var(--text-muted);font-size:.6rem;font-weight:500;margin-top:.15rem}
.announcement-list,.mytask-list{display:flex;flex-direction:column}
.announcement-list>div{display:flex;gap:.7rem;padding:.7rem 0;border-bottom:1px solid #eef1f7}
.announcement-list>div:last-child{border-bottom:0}
.announcement-list i{color:var(--accent-blue);margin-top:.15rem;width:18px;text-align:center}
.announcement-list span{font-size:.71rem;font-weight:700;color:var(--text-main);line-height:1.25}
.announcement-list small{display:block;color:var(--text-muted);font-size:.61rem;font-weight:500;margin-top:.2rem}
.mytask-list{gap:.1rem}
.dash-mytask{display:grid;grid-template-columns:24px 1fr auto;gap:.5rem;align-items:start;padding:.65rem 0;border-bottom:1px solid #eef1f7}
.dash-mytask:last-child{border-bottom:0}
.dash-mytask .num{font-size:.7rem;color:var(--accent-blue);font-weight:900}
.dash-mytask strong{display:block;font-size:.7rem;color:var(--text-main);line-height:1.3}
.dash-mytask small{display:block;font-size:.59rem;color:var(--text-muted);margin-top:.15rem}
.dash-priority{font-size:.56rem;font-weight:800;border-radius:7px;padding:.28rem .42rem;background:#f6e8df;color:var(--accent-blue)}
.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:.55rem}
.quick-grid button{border:1px solid #dfe5f2;background:#fff;color:var(--text-main);border-radius:11px;padding:.65rem .5rem;display:flex;align-items:center;gap:.45rem;justify-content:center;font-size:.65rem;font-weight:800;cursor:pointer;transition:var(--transition)}
.quick-grid button i{color:var(--accent-blue)}
.quick-grid button:hover{border-color:#a5b4fc;color:var(--accent-blue);transform:translateY(-2px);box-shadow:0 7px 16px rgba(31,41,90,.07)}
@keyframes dashPulse{0%,100%{box-shadow:0 0 0 3px rgba(5,150,105,.08)}50%{box-shadow:0 0 0 6px rgba(5,150,105,.03)}}
@keyframes waveHand{0%,100%{transform:rotate(0)}25%{transform:rotate(12deg)}50%{transform:rotate(-4deg)}75%{transform:rotate(8deg)}}
@media(max-width:1250px){.dash-layout{grid-template-columns:1fr}.dash-right-col{display:grid;grid-template-columns:1fr 1fr}.quick-card{grid-column:1/-1}.dash-two-col{grid-template-columns:1fr 1fr}.portfolio-grid{grid-template-columns:repeat(4,1fr)}}
@media(max-width:1000px){.app-inner{grid-template-columns:80px minmax(0,1fr)}.dash-kpi-grid{grid-template-columns:repeat(2,1fr)}.portfolio-grid{grid-template-columns:repeat(2,1fr)}.dash-right-col{grid-template-columns:1fr}.quick-card{grid-column:auto}}
@media(max-width:700px){.app-inner{display:flex !important;flex-direction:column}.app-inner>#main-header{order:1;position:sticky;top:0;z-index:20}.app-inner>#sidebar-wrapper{order:2;width:100%;height:auto;max-height:none;border-right:0;border-bottom:1px solid var(--border-glass);padding:.45rem .6rem}.app-inner>#sidebar-wrapper .brand-logo,.app-inner>#sidebar-wrapper .sih-logo-slot{display:none}.app-inner>#sidebar-wrapper nav{height:auto!important;flex-direction:row!important;overflow-x:auto;gap:.25rem}.app-inner>#sidebar-wrapper .nav-item{white-space:nowrap;margin:0;font-size:.68rem;padding:.58rem .65rem}.app-inner>#sidebar-wrapper .nav-item i{font-size:.8rem}.app-inner>main{order:3;padding:1rem !important}.header-actions{width:100%}.dash-welcome-row{align-items:flex-start;flex-direction:column}.dash-date{align-self:flex-start}.dash-two-col{grid-template-columns:1fr}.task-overview-body{grid-template-columns:130px 1fr}.donut-large{width:125px;height:125px}.portfolio-grid{grid-template-columns:1fr 1fr}}
@media(max-width:480px){.app-inner>#main-header{padding:.8rem !important}.header-profile img{width:40px;height:40px}.header-actions .search-bar{order:4;width:100%}.dash-kpi-grid{grid-template-columns:1fr}.task-overview-body{grid-template-columns:1fr}.portfolio-grid{grid-template-columns:1fr}.dash-welcome h1{font-size:1.3rem}}


/* =========================================================
   SCMS POWER SUITE — CLIENT EXPERIENCE LAYER
========================================================= */
.power-hero{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start;padding:1.35rem;border-radius:20px;background:linear-gradient(135deg,rgba(255,255,255,.94),rgba(238,242,255,.9));border:1px solid rgba(79,70,229,.12);box-shadow:0 12px 35px rgba(31,38,135,.08);position:relative;overflow:hidden}
.power-hero:after{content:'';position:absolute;width:180px;height:180px;border-radius:50%;right:-60px;top:-90px;background:linear-gradient(135deg,rgba(79,70,229,.14),rgba(139,92,246,.05))}
.power-hero h2{font-size:1.55rem}.power-hero p{margin-top:.3rem;color:var(--text-muted);font-size:.78rem;max-width:700px}
.power-health{min-width:190px;padding:1rem;border-radius:16px;background:rgba(255,255,255,.8);border:1px solid #e6e9f5;z-index:1}.power-health strong{font-size:1.7rem}.power-progress{height:8px;border-radius:20px;background:#edf0f8;overflow:hidden;margin-top:.5rem}.power-progress i{display:block;height:100%;width:82%;background:linear-gradient(90deg,var(--accent-blue),var(--accent-purple));border-radius:20px;transition:width .5s}
.power-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:1rem}.power-card{background:rgba(255,255,255,.9);border:1px solid #e7eaf3;border-radius:17px;padding:1rem;box-shadow:0 8px 24px rgba(31,38,135,.05);transition:.25s;cursor:pointer;min-height:145px}.power-card:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(31,38,135,.1);border-color:#c7d2fe}.power-card .power-icon{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:#f6e8df;color:var(--accent-blue);margin-bottom:.7rem}.power-card h3{font-size:.88rem}.power-card p{font-size:.68rem;color:var(--text-muted);line-height:1.45;margin-top:.25rem}.power-card .power-stat{margin-top:.65rem;font-size:.7rem;font-weight:800;color:var(--accent-blue)}
.power-toolbar{display:flex;gap:.5rem;flex-wrap:wrap;margin:1rem 0}.power-tab{border:1px solid #dfe4f1;background:#fff;border-radius:10px;padding:.6rem .8rem;font-size:.7rem;font-weight:800;color:var(--text-muted);cursor:pointer}.power-tab.active,.power-tab:hover{background:#f6e8df;color:var(--accent-blue);border-color:#c7d2fe}.power-panel{display:none}.power-panel.active{display:block}.power-two{display:grid;grid-template-columns:1.2fr .8fr;gap:1rem}.power-three{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.power-list{display:flex;flex-direction:column;gap:.55rem}.power-row{display:grid;grid-template-columns:32px 1fr auto;gap:.65rem;align-items:center;padding:.7rem;border:1px solid #edf0f6;border-radius:12px;background:#fff}.power-row .mini{width:30px;height:30px;border-radius:9px;background:#f1f5ff;display:grid;place-items:center;color:var(--accent-blue)}.power-row strong{font-size:.72rem}.power-row small{display:block;color:var(--text-muted);font-size:.61rem;margin-top:.15rem}.power-badge{font-size:.58rem;font-weight:800;padding:.28rem .45rem;border-radius:8px;background:#f6e8df;color:var(--accent-blue)}.power-input{width:100%;padding:.65rem .75rem;border:1px solid #e1e5ef;border-radius:10px;background:#fff;font:inherit;font-size:.7rem}.power-form{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}.power-form .full{grid-column:1/-1}.power-actions{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.7rem}.power-empty{padding:1.4rem;text-align:center;color:var(--text-muted);border:1px dashed #d9deea;border-radius:13px;font-size:.72rem}.power-goal{padding:.8rem;border:1px solid #edf0f6;border-radius:12px}.power-goal-head{display:flex;justify-content:space-between;font-size:.7rem;font-weight:800}.power-goal-bar{height:7px;background:#edf0f8;border-radius:20px;margin-top:.5rem;overflow:hidden}.power-goal-bar i{display:block;height:100%;background:linear-gradient(90deg,var(--accent-blue),var(--accent-purple));border-radius:20px}.power-kicker{font-size:.62rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.08em;font-weight:800}.briefing-box{background:#111827;color:#fff;border-radius:16px;padding:1rem;line-height:1.6;font-size:.72rem;white-space:pre-wrap;min-height:150px}.assistant-box{display:grid;grid-template-columns:1fr auto;gap:.5rem}.assistant-output{margin-top:.7rem}
@media(max-width:1100px){.power-grid{grid-template-columns:repeat(2,1fr)}.power-two,.power-three{grid-template-columns:1fr}}
@media(max-width:650px){.power-hero{flex-direction:column}.power-health{width:100%}.power-grid{grid-template-columns:1fr}.power-form{grid-template-columns:1fr}.power-form .full{grid-column:auto}}


/* Restored completion-layer styles */
/* === v4.3 COMPLETION LAYER === */
        .sih-logo-slot{position:relative;display:flex;align-items:center;gap:.7rem;margin:0 .55rem .9rem;padding:.7rem;border:1px dashed rgba(79,70,229,.22);border-radius:15px;background:rgba(255,255,255,.55);cursor:pointer;transition:var(--transition)}
        .sih-logo-slot:hover{background:#fff;border-color:#a5b4fc;transform:translateY(-1px);box-shadow:0 8px 20px rgba(31,41,90,.06)}
        .sih-logo-preview{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#f6e8df,#f5f3ff);display:grid;place-items:center;color:#6366f1;overflow:hidden;flex:0 0 auto}
        .sih-logo-preview img{width:100%;height:100%;object-fit:contain;padding:4px}
        .sih-logo-copy{display:flex;flex-direction:column;gap:2px;min-width:0}
        .sih-logo-copy strong{font-size:.7rem;letter-spacing:.06em}.sih-logo-copy small{font-size:.62rem;color:var(--text-muted)}
        .sih-logo-clear{margin-left:auto;width:25px;height:25px;border:0;background:transparent;color:#94a3b8;border-radius:8px;cursor:pointer}.sih-logo-clear:hover{background:#fee2e2;color:#dc2626}
        .team-filter-row{display:grid;grid-template-columns:minmax(0,1fr) 150px;gap:.55rem;margin-bottom:.8rem}
        .team-search-box{position:relative}.team-search-box i{position:absolute;left:12px;top:13px;color:#94a3b8;z-index:2}.team-search-box input{width:100%;padding-left:34px}
        .team-empty-hero{min-height:520px;display:grid;place-items:center;align-content:center;text-align:center;color:var(--text-muted);padding:2rem}
        .team-empty-icon{width:82px;height:82px;border-radius:26px;display:grid;place-items:center;background:linear-gradient(135deg,#f6e8df,#f5f3ff);color:#7a1f3d;font-size:2rem;margin-bottom:1rem;animation:scmsFloat 3s ease-in-out infinite}
        .team-empty-hero h2{color:var(--text-main);margin-bottom:.35rem}.team-empty-hero p{max-width:420px;font-size:.8rem;margin-bottom:1rem}
        .finance-kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem;margin-bottom:1rem}
        .finance-kpi{padding:1rem;border:1px solid #e9edf6;border-radius:16px;background:linear-gradient(145deg,#fff,#f8faff);box-shadow:0 8px 24px rgba(31,41,90,.05);position:relative;overflow:hidden}
        .finance-kpi::after{content:'';position:absolute;width:85px;height:85px;border-radius:50%;right:-32px;top:-32px;background:radial-gradient(circle,rgba(79,70,229,.12),transparent 70%)}
        .finance-kpi span{display:flex;gap:.45rem;align-items:center;color:var(--text-muted);font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.finance-kpi span i{color:var(--accent-blue)}
        .finance-kpi strong{display:block;font-size:1.35rem;margin-top:.35rem}.finance-kpi small{display:block;color:#8a94a8;font-size:.66rem;margin-top:.2rem}
        .finance-control-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:1rem}
        .finance-meter{margin:.75rem 0}.finance-meter>div:first-child{display:flex;justify-content:space-between;font-size:.72rem;font-weight:700;margin-bottom:.3rem}
        .finance-filter-grid{display:grid;grid-template-columns:1.3fr .8fr .8fr;gap:.55rem}.finance-filter-grid>*{width:100%}
        .finance-quick-actions{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin-top:.8rem}
        .finance-action-card{display:flex;align-items:center;gap:.65rem;text-align:left;border:1px solid #e8edf7;background:#fff;border-radius:13px;padding:.75rem;cursor:pointer;transition:var(--transition)}
        .finance-action-card:hover{border-color:#a5b4fc;transform:translateY(-2px);box-shadow:0 8px 18px rgba(31,41,90,.06)}
        .finance-action-card i{font-size:1rem;color:var(--accent-blue)}.finance-action-card strong{display:block;font-size:.73rem}.finance-action-card small{display:block;color:var(--text-muted);font-size:.62rem;margin-top:2px}
        .finance-record{align-items:center}.finance-record-main{display:flex;align-items:center;gap:.8rem;min-width:0}.finance-icon{width:42px;height:42px;border-radius:13px;display:grid;place-items:center;background:#f6e8df;color:#7a1f3d;flex:0 0 auto}.finance-approve{color:#047857;border-color:#bbf7d0}.finance-reject{color:#b91c1c;border-color:#fecaca}
        .meeting-completed{opacity:.82}.meeting-completed .item-title{text-decoration:line-through;text-decoration-color:#94a3b8}
        @media(max-width:1050px){.finance-kpi-grid{grid-template-columns:repeat(2,1fr)}.finance-control-grid{grid-template-columns:1fr}}
        @media(max-width:720px){.team-filter-row,.finance-filter-grid,.finance-quick-actions{grid-template-columns:1fr}.finance-kpi-grid{grid-template-columns:1fr 1fr}}
        @media(max-width:520px){.finance-kpi-grid{grid-template-columns:1fr}.sih-logo-copy{display:none}.sih-logo-slot{justify-content:center}.sih-logo-clear{position:absolute;right:4px;top:4px}}



/* ORBITA MINI / ASTRA 2026 VISUAL SYSTEM */
:root{--wine:#7a1f3d;--wine-dark:#54152a;--wine-soft:#a64d68;--cream:#fbf4ec;--cream-2:#f3e4d7;--gold:#c49a45;--accent-blue:var(--wine);--accent-purple:var(--wine-soft);--accent-light-blue:var(--gold);--accent-red:#a52a3a;--bg-body:var(--cream);}
body{background:radial-gradient(circle at top left,#fffdf9,var(--cream) 52%,var(--cream-2));}
.brand-logo i,.login-box .brand-mark,.home-brand-mark{color:var(--wine)!important}.brand-logo h1,.brand-logo p{color:var(--wine-dark)}
.small-btn,.analytics-btn{border-color:rgba(122,31,61,.14)}
.btn-submit,.login-box button{background:linear-gradient(135deg,var(--wine),var(--wine-soft))!important}
.nav-item.active,.nav-item:hover{background:rgba(122,31,61,.10)!important;color:var(--wine-dark)!important}
.dash-event-date,.bar,.dash-kpi-icon,.module-tile i,.status-chip,.profile-chip{border-color:rgba(122,31,61,.14)}
.home-shell{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:28px;background:radial-gradient(circle at 15% 10%,#fff 0,transparent 35%),linear-gradient(135deg,var(--cream),var(--cream-2));}
.home-card{width:min(1100px,94vw);background:rgba(255,255,255,.86);border:1px solid rgba(122,31,61,.14);border-radius:30px;box-shadow:0 30px 80px rgba(84,21,42,.12);overflow:hidden;display:grid;grid-template-columns:1.25fr .75fr;}
.home-hero{padding:54px}.home-side{padding:42px;background:linear-gradient(160deg,rgba(122,31,61,.08),rgba(196,154,69,.10));border-left:1px solid rgba(122,31,61,.10);}
.home-logo{width:92px;height:92px;object-fit:contain;border-radius:22px;background:#fff;padding:8px;border:1px solid rgba(122,31,61,.12);box-shadow:0 12px 30px rgba(84,21,42,.10)}
.home-eyebrow{font-size:.72rem;font-weight:900;letter-spacing:.16em;color:var(--wine);text-transform:uppercase;margin:22px 0 10px}.home-hero h1{font-size:clamp(2.2rem,5vw,4.4rem);line-height:1.02;color:var(--wine-dark);margin-bottom:16px}.home-hero h1 span{color:var(--gold)}.home-hero p{max-width:700px;color:var(--text-muted);font-size:1rem;line-height:1.7}.home-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.home-btn{border:0;border-radius:14px;padding:13px 18px;font-weight:800;cursor:pointer}.home-btn.primary{background:var(--wine);color:#fff}.home-btn.secondary{background:#fff;color:var(--wine-dark);border:1px solid rgba(122,31,61,.18)}.home-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:30px}.home-mini{padding:16px;border-radius:16px;background:#fff;border:1px solid rgba(122,31,61,.09)}.home-mini i{color:var(--wine);margin-bottom:8px}.home-mini strong{display:block;font-size:.84rem;color:var(--wine-dark)}.home-mini small{color:var(--text-muted);line-height:1.4}.home-side h3{color:var(--wine-dark);font-size:1.15rem;margin-bottom:8px}.home-side p{color:var(--text-muted);font-size:.82rem;line-height:1.6}.home-lead{display:flex;gap:10px;align-items:center;padding:11px 0;border-bottom:1px solid rgba(122,31,61,.09)}.home-lead img{width:38px;height:38px;border-radius:50%}.home-lead strong{font-size:.78rem;display:block}.home-lead small{font-size:.68rem;color:var(--text-muted)}
.login-logo-img{width:82px;height:82px;object-fit:contain;border-radius:20px;background:#fff;padding:6px;border:1px solid rgba(122,31,61,.12);margin-bottom:12px}.login-switch{display:flex;gap:6px;background:rgba(122,31,61,.06);padding:5px;border-radius:13px;margin-bottom:16px}.login-switch button{flex:1;border:0!important;background:transparent!important;color:var(--wine-dark)!important;box-shadow:none!important;padding:9px!important;font-size:.78rem!important}.login-switch button.active{background:#fff!important;color:var(--wine)!important;box-shadow:0 4px 12px rgba(84,21,42,.10)!important}.principal-view{background:linear-gradient(135deg,rgba(122,31,61,.08),rgba(196,154,69,.08));border:1px solid rgba(122,31,61,.10);border-radius:22px;padding:22px;margin-bottom:18px}.principal-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.principal-kpi{background:#fff;border:1px solid rgba(122,31,61,.10);border-radius:16px;padding:16px}.principal-kpi span{display:block;font-size:.68rem;color:var(--text-muted)}.principal-kpi strong{display:block;font-size:1.5rem;color:var(--wine-dark);margin-top:4px}.principal-queue{display:grid;gap:10px;margin-top:14px}.principal-queue .queue-item{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:13px;border:1px solid rgba(122,31,61,.09);border-radius:14px;background:#fff}.queue-item strong{font-size:.78rem}.queue-item small{display:block;color:var(--text-muted);margin-top:3px}.queue-actions{display:flex;gap:6px;flex-wrap:wrap}
.event-media-grid{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.event-media-grid img{width:72px;height:72px;object-fit:cover;border-radius:10px;border:1px solid rgba(122,31,61,.12)}
.student-gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.student-gallery img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:12px}
@media(max-width:800px){.home-card{grid-template-columns:1fr}.home-side{border-left:0;border-top:1px solid rgba(122,31,61,.10)}.home-hero{padding:32px}.home-side{padding:28px}.principal-grid{grid-template-columns:repeat(2,1fr)}.student-gallery{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.home-shell{padding:10px}.home-hero{padding:24px}.home-hero h1{font-size:2.3rem}.home-grid{grid-template-columns:1fr}.principal-grid{grid-template-columns:1fr}.home-actions>*{width:100%}.login-box{padding:2rem 1.2rem!important;margin:12px}.modal-content{max-width:calc(100vw - 20px)!important;padding:1.25rem!important}.record-card{flex-direction:column;align-items:flex-start!important}.record-actions{width:100%;flex-wrap:wrap}.toolbar-actions{flex-wrap:wrap}.toolbar-actions>*{max-width:100%}}
</style>
</head>
<body>
    

    <div id="toast-container"></div>
    <div id="notification-panel" class="scms-notification-panel" aria-hidden="true">
        <div class="scms-settings-head"><h3><i class="fa-regular fa-bell"></i> Notifications</h3><button class="small-btn" onclick="markNotificationsRead()">Mark read</button></div>
        <div id="notification-list" class="scms-notification-list"></div>
    </div>

    <div id="settings-panel" class="scms-settings-panel" aria-hidden="true">
        <div class="scms-settings-head"><h3><i class="fa-solid fa-sliders"></i> Workspace Settings</h3><button class="small-btn" onclick="toggleSettings(false)"><i class="fa-solid fa-xmark"></i></button></div>
        <div class="scms-setting"><div class="scms-setting-row"><div><strong>Dark mode</strong><small>Use a low-light council workspace.</small></div><label class="scms-switch"><input id="dark-mode-toggle" type="checkbox" onchange="toggleDarkMode(this.checked)"><span class="scms-slider"></span></label></div></div>
        <div class="scms-setting"><div class="scms-setting-row"><div><strong>Auto refresh</strong><small>Refresh operational data every 60 seconds.</small></div><label class="scms-switch"><input id="auto-refresh-toggle" type="checkbox" onchange="toggleAutoRefresh(this.checked)"><span class="scms-slider"></span></label></div></div>
        <div class="scms-setting"><div class="scms-setting-row"><div><strong>Data mode</strong><small>Supabase cloud sync enabled. Local cache keeps the workspace responsive.</small></div><span class="pill-badge pill-green">CLOUD</span></div></div>
        <div class="scms-setting"><div class="toolbar-actions"><button class="small-btn" onclick="printCurrentView()"><i class="fa-solid fa-print"></i> Print</button><button class="small-btn" onclick="exportFullSnapshot()"><i class="fa-solid fa-file-export"></i> Full Export</button><button class="small-btn" onclick="clearLocalWorkspace()"><i class="fa-solid fa-trash"></i> Clear Local Data</button></div></div>
    </div>

    <div id="command-overlay" class="command-overlay" onclick="if(event.target===this)closeCommandPalette()">
        <div class="command-box">
            <div class="command-input-wrap"><i class="fa-solid fa-magnifying-glass"></i><input id="command-input" class="command-input" placeholder="Search pages and actions..." autocomplete="off"></div>
            <div id="command-list" class="command-list"></div>
        </div>
    </div>


    <!-- ENHANCED MODALS -->
    <div id="task-modal" class="modal hide">
      <div class="modal-content">
        <h3><i class="fa-solid fa-clipboard-user"></i> Create / Assign Task</h3>
        <form id="form-task">
          <div class="form-section">Task information</div>
          <div class="form-grid">
            <div class="form-field full"><label>Task title <span class="required-star">*</span></label><input type="text" id="task-title" placeholder="e.g. Prepare Independence Day report" required></div>
            <div class="form-field"><label>Category</label><select id="task-category"><option>Academic</option><option>Event</option><option>Administration</option><option>Sports</option><option>Cultural</option><option>Technical</option><option>Student Welfare</option><option>Other</option></select></div>
            <div class="form-field"><label>Priority</label><select id="task-priority"><option>Low</option><option selected>Medium</option><option>High</option><option>Critical</option></select></div>
            <div class="form-field"><label>Team</label><select id="task-team"><option value="">Individual / no team</option></select></div><div class="form-field"><label>Assignee <span class="required-star">*</span></label><select id="task-assignee" required></select></div>
            <div class="form-field"><label>Due date</label><input type="date" id="task-date"></div>
            <div class="form-field"><label>Due time</label><input type="time" id="task-time"></div>
            <div class="form-field"><label>Status</label><select id="task-status"><option selected>Pending</option><option>In Progress</option><option>Completed</option><option>On Hold</option></select></div>
            <div class="form-field"><label>Reference / Department</label><input type="text" id="task-reference" placeholder="Department, committee or reference"></div>
            <div class="form-field full"><label>Description</label><textarea id="task-desc" placeholder="Add instructions, expected output, links or notes..."></textarea></div>
            <div class="form-field full"><label>Additional options</label><div class="form-checks"><label class="form-check"><input type="checkbox" id="task-notify" checked> Notify assignee</label><label class="form-check"><input type="checkbox" id="task-followup"> Require follow-up</label></div></div>
          </div>
          <div class="modal-actions"><button type="button" class="modal-btn btn-cancel" onclick="closeModal('task-modal')">Cancel</button><button type="submit" class="modal-btn btn-submit"><i class="fa-solid fa-paper-plane"></i> Assign Task</button></div>
        </form>
      </div>
    </div>

    <div id="event-modal" class="modal hide">
      <div class="modal-content">
        <h3><i class="fa-solid fa-calendar-plus"></i> Create Council Event</h3>
        <form id="form-event">
          <div class="form-section">Event details</div>
          <div class="form-grid">
            <div class="form-field full"><label>Event name <span class="required-star">*</span></label><input type="text" id="event-title" placeholder="e.g. Inter-Department Football Tournament" required></div>
            <div class="form-field"><label>Event type</label><select id="event-type"><option>Academic</option><option>Sports</option><option>Cultural</option><option>Technical</option><option>Workshop</option><option>Meeting</option><option>Other</option></select></div>
            <div class="form-field"><label>Priority</label><select id="event-priority"><option>Normal</option><option>High</option><option>Critical</option></select></div>
            <div class="form-field"><label>Date <span class="required-star">*</span></label><input type="date" id="event-date" required></div>
            <div class="form-field"><label>Start time</label><input type="time" id="event-start"></div>
            <div class="form-field"><label>End time</label><input type="time" id="event-end"></div>
            <div class="form-field"><label>Venue / Location</label><input type="text" id="event-location" placeholder="Auditorium / Ground / Lab"></div>
            <div class="form-field"><label>Expected capacity</label><input type="number" id="event-capacity" min="0" placeholder="Number of participants"></div>
            <div class="form-field"><label>Organizer</label><input type="text" id="event-organizer" placeholder="Council / Department / Club"></div>
            <div class="form-field full"><label>Details</label><textarea id="event-desc" placeholder="Agenda, requirements, instructions, guest details..."></textarea></div>
            <div class="form-field full"><label>Event options</label><div class="form-checks"><label class="form-check"><input type="checkbox" id="event-notify" checked> Notify council members</label><label class="form-check"><input type="checkbox" id="event-public"> Publish to student portal</label><label class="form-check"><input type="checkbox" id="event-registration"> Enable registration</label></div></div><div class="form-field full"><label>Event photos</label><input type="file" id="event-photos" accept="image/*" multiple><span class="field-help">Upload multiple photos. Published photos are shown in the Student Portal gallery.</span></div><div class="form-field full"><label>Feedback</label><input type="text" id="event-feedback-prompt" placeholder="Feedback prompt for students (optional)"></div>
          </div>
          <div class="modal-actions"><button type="button" class="modal-btn btn-cancel" onclick="closeModal('event-modal')">Cancel</button><button type="submit" class="modal-btn btn-submit"><i class="fa-solid fa-calendar-check"></i> Save Event</button></div>
        </form>
      </div>
    </div>

    <div id="meeting-modal" class="modal hide">
      <div class="modal-content">
        <h3><i class="fa-solid fa-handshake"></i> Schedule Council Meeting</h3>
        <form id="form-meeting">
          <div class="form-section">Meeting information</div>
          <div class="form-grid">
            <div class="form-field full"><label>Meeting title <span class="required-star">*</span></label><input type="text" id="meeting-title" placeholder="e.g. Monthly Student Council Review" required></div>
            <div class="form-field"><label>Date <span class="required-star">*</span></label><input type="date" id="meeting-date" required></div>
            <div class="form-field"><label>Start time</label><input type="time" id="meeting-time"></div>
            <div class="form-field"><label>Location</label><input type="text" id="meeting-location" placeholder="Principal cabin / Seminar hall"></div>
            <div class="form-field"><label>Meeting type</label><select id="meeting-type"><option>Regular</option><option>Emergency</option><option>Review</option><option>Planning</option><option>Committee</option></select></div>
            <div class="form-field full"><label>Agenda <span class="required-star">*</span></label><textarea id="meeting-agenda" rows="5" placeholder="Agenda items, decisions required and discussion points..." required></textarea></div>
            <div class="form-field full"><label>Meeting options</label><div class="form-checks"><label class="form-check"><input type="checkbox" id="meeting-notify" checked> Notify members</label><label class="form-check"><input type="checkbox" id="meeting-minutes"> Prepare minutes template</label></div></div>
          </div>
          <div class="modal-actions"><button type="button" class="modal-btn btn-cancel" onclick="closeModal('meeting-modal')">Cancel</button><button type="submit" class="modal-btn btn-submit"><i class="fa-solid fa-clock"></i> Schedule Meeting</button></div>
        </form>
      </div>
    </div>

    <div id="finance-modal" class="modal hide">
      <div class="modal-content">
        <h3><i class="fa-solid fa-indian-rupee-sign"></i> Request / Track Funds</h3>
        <form id="form-finance">
          <div class="form-section">Financial request</div>
          <div class="form-grid">
            <div class="form-field full"><label>Expense title <span class="required-star">*</span></label><input type="text" id="finance-title" placeholder="e.g. Football tournament equipment" required></div>
            <div class="form-field"><label>Amount (₹) <span class="required-star">*</span></label><input type="number" id="finance-amount" min="1" step="0.01" placeholder="0.00" required></div>
            <div class="form-field"><label>Expense type</label><select id="finance-type"><option value="Event">Event Budget</option><option value="Operations">Operations</option><option value="Equipment">Equipment</option><option value="Travel">Travel</option><option value="Marketing">Marketing</option><option value="Other">Other</option></select></div>
            <div class="form-field"><label>Requested date</label><input type="date" id="finance-date"></div>
            <div class="form-field"><label>Priority</label><select id="finance-priority"><option>Normal</option><option>High</option><option>Urgent</option></select></div>
            <div class="form-field"><label>Department / Committee</label><input type="text" id="finance-department" placeholder="Committee or department"></div>
            <div class="form-field"><label>Vendor / Payee</label><input type="text" id="finance-vendor" placeholder="Optional"></div>
            <div class="form-field full"><label>Justification</label><textarea id="finance-justification" placeholder="Why is this expense required? Add budget context or supporting details..."></textarea></div>
            <div class="form-field full"><label>Supporting options</label><div class="form-checks"><label class="form-check"><input type="checkbox" id="finance-urgent"> Mark for urgent review</label><label class="form-check"><input type="checkbox" id="finance-receipt"> Receipt / quotation available</label></div></div>
          </div>
          <div class="modal-actions"><button type="button" class="modal-btn btn-cancel" onclick="closeModal('finance-modal')">Cancel</button><button type="submit" class="modal-btn btn-submit"><i class="fa-solid fa-paper-plane"></i> Submit Request</button></div>
        </form>
      </div>
    </div>

    <div id="grievance-modal" class="modal hide">
      <div class="modal-content">
        <h3><i class="fa-solid fa-comment-dots"></i> Submit Student Grievance</h3>
        <form id="form-grievance">
          <div class="form-section">Complaint / grievance details</div>
          <div class="form-grid">
            <div class="form-field full"><label>Subject <span class="required-star">*</span></label><input type="text" id="g-subject" placeholder="Briefly describe the issue" required></div>
            <div class="form-field"><label>Category</label><select id="g-category"><option>Academic</option><option>Infrastructure</option><option>Faculty</option><option>Examination</option><option>Fees / Finance</option><option>Hostel / Transport</option><option>Sports</option><option>Harassment / Safety</option><option>Other</option></select></div>
            <div class="form-field"><label>Priority</label><select id="g-priority"><option>Normal</option><option>High</option><option>Urgent</option><option>Emergency</option></select></div>
            <div class="form-field"><label>Department</label><input type="text" id="g-department" placeholder="Department / class"></div>
            <div class="form-field"><label>Preferred contact</label><select id="g-contact"><option>Portal notification</option><option>Email</option><option>Phone</option><option>No contact</option></select></div>
            <div class="form-field full"><label>Details <span class="required-star">*</span></label><textarea id="g-desc" rows="5" placeholder="Provide complete facts, dates, people involved and requested resolution..." required></textarea></div>
            <div class="form-field full"><label>Privacy</label><div class="form-checks"><label class="form-check"><input type="checkbox" id="g-anon"> Submit anonymously</label><label class="form-check"><input type="checkbox" id="g-followup" checked> Allow follow-up questions</label></div><span class="field-help">Anonymous submissions will not intentionally attach your name to the grievance.</span></div>
          </div>
          <div class="modal-actions"><button type="button" class="modal-btn btn-cancel" onclick="closeModal('grievance-modal')">Cancel</button><button type="submit" class="modal-btn btn-submit"><i class="fa-solid fa-shield-halved"></i> Submit Secure Ticket</button></div>
        </form>
      </div>
    </div>

    <!-- PUBLIC HOME / COUNCIL OVERVIEW -->
    <section id="home-screen" class="home-shell">
      <div class="home-card">
        <div class="home-hero">
          <img class="home-logo" src="./student-council-logo.jpeg" alt="Student Council logo">
          <div class="home-eyebrow">ASTRA • ORBITA MINI • SCMS</div>
          <h1>Student Council<br><span>Command Center</span></h1>
          <p>A professional Student Council Management System for leadership, teams, tasks, events, meetings, finance, documents, grievances, media and achievements — with a dedicated Principal control layer.</p>
          <div class="home-actions">
            <button class="home-btn primary" onclick="openLogin('council')"><i class="fa-solid fa-right-to-bracket"></i> Council Login</button>
            <button class="home-btn secondary" onclick="openLogin('principal')"><i class="fa-solid fa-user-shield"></i> Principal Login</button>
          </div>
          <div class="home-grid">
            <div class="home-mini"><i class="fa-solid fa-people-group"></i><strong>Leadership & Teams</strong><small>Role-based council operations and team coordination.</small></div>
            <div class="home-mini"><i class="fa-solid fa-calendar-days"></i><strong>Events & Calendar</strong><small>Plan activities, meetings and publish event media.</small></div>
            <div class="home-mini"><i class="fa-solid fa-file-invoice-dollar"></i><strong>Finance & Budget • Future Update</strong><small>Principal and Treasury approval workflows.</small></div>
            <div class="home-mini"><i class="fa-solid fa-shield-heart"></i><strong>Student Welfare</strong><small>Secure grievance handling and council support.</small></div>
          </div>
        </div>
        <aside class="home-side">
          <h3>About the Council</h3>
          <p>Student leadership, participation and accountability brought into one workspace.</p>
          <div id="home-leadership-list"></div>
          <div style="margin-top:18px;padding:14px;border-radius:16px;background:#fff;border:1px solid rgba(122,31,61,.09)">
            <strong style="font-size:.8rem;color:var(--wine-dark)">Student Portal Ready</strong>
            <small style="display:block;color:var(--text-muted);margin-top:4px">Published event photos and public council information can appear here.</small>
            <div id="home-gallery" class="student-gallery" style="margin-top:10px"></div>
          </div>
          <div style="margin-top:18px;font-size:.68rem;color:var(--text-muted)"><strong style="color:var(--wine)">ASTRA</strong> • OrbitA Mini SCMS</div>
        </aside>
      </div>
    </section>

    <!-- GLASSMORPHISM LOGIN SCREEN -->
    <div id="login-screen" class="hide">
        <div class="login-box">
            <img class="login-logo-img" src="./student-council-logo.jpeg" alt="Student Council logo">
            <h2 id="login-title">Council Portal</h2>
            <p id="login-subtitle">Sign in to your council account</p>
            <div class="login-switch"><button type="button" id="council-login-tab" class="active" onclick="openLogin('council')">Council</button><button type="button" id="principal-login-tab" onclick="openLogin('principal')">Principal / Super Admin</button></div>
            <div style="margin:-.25rem 0 1rem;font-size:.62rem;font-weight:800;letter-spacing:.08em;color:#6b7280;text-transform:uppercase;">ASTRA • ORBITA MINI</div>
            <form id="login-form">
                <input type="email" id="email" placeholder="Email Address" value="" required>
                <input type="password" id="password" placeholder="Password" value="" required>
                <button type="submit">Access System</button>
            </form>
            <div id="login-error"><i class="fa-solid fa-circle-exclamation"></i> Invalid credentials.</div><div style="margin-top:12px;font-size:.68rem;line-height:1.45;color:#6b7280;text-align:center">Authentication is provided by the configured institutional account layer. Do not share passwords.</div>
        </div>
    </div>

    <!-- MASTER APP FRAME (Matches the uploaded image perfectly) -->
    <div class="app-wrapper hide" id="app-container">
        <div class="app-inner">
            
            <!-- SIDEBAR -->
            <header id="main-header">
                    <div class="header-profile">
                        <img id="user-avatar" src="" alt="Profile">
                        <div class="header-profile-text">
                            <p>Welcome,</p>
                            <h4 id="user-name">Loading...</h4>
                            <span id="user-role" style="display:none;"></span> <!-- Hidden but kept for JS -->
                        </div>
                    </div>
                    
                    <div class="header-actions">
                        <div class="search-bar">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text" placeholder="Search">
                        </div>
                        <button class="icon-btn" id="header-chat-btn" title="Open Council Chat"><i class="fa-regular fa-comment-dots"></i></button>
                        <button class="icon-btn" id="header-notification-btn" title="Notifications"><i class="fa-regular fa-bell"></i><span class="notification-dot"></span><span id="notification-count" class="scms-unread">0</span></button>
                        <button class="icon-btn" id="header-settings-btn" title="Settings"><i class="fa-solid fa-gear"></i></button>
                        <span class="scms-command-key" title="Open command palette">Ctrl K</span>
                    </div>
                </header>

            <aside id="sidebar-wrapper">
                <div class="brand-logo">
                    <i class="fa-solid fa-bolt"></i>
                    <div class="brand-titles">
                        <h1>Siddhant</h1>
                        <p>College</p>
                        <span class="ssav-brand"><span>ASTRA</span><span class="tm-mark">™</span></span>
                    </div>
                </div>
                <div class="sih-logo-slot" id="sih-logo-slot" title="Click to add your SIH logo">
                    <input id="sih-logo-input" type="file" accept="image/*" hidden>
                    <div class="sih-logo-preview" id="sih-logo-preview"><i class="fa-solid fa-image"></i></div>
                    <div class="sih-logo-copy"><strong>STUDENT COUNCIL</strong><small>Official logo</small></div>
                    <button class="sih-logo-clear" id="sih-logo-clear" type="button" title="Remove logo"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <nav id="sidebar-nav" style="display:flex; flex-direction:column; height:100%;"></nav>
            </aside>

            <!-- MAIN CONTENT -->
            <main>
                <!-- HEADER (Inside Main Area) -->
                

                <!-- PRINCIPAL / SUPER ADMIN DASHBOARD -->
                <div id="view-principal-dashboard" class="view-section hide">
                  <div class="principal-view">
                    <div style="display:flex;justify-content:space-between;gap:14px;align-items:flex-start;flex-wrap:wrap"><div><div class="dash-eyebrow"><span class="live-dot"></span> PRINCIPAL COMMAND CENTER</div><h1 style="color:var(--wine-dark);margin-top:6px">Super Admin Dashboard</h1><p style="color:var(--text-muted);font-size:.82rem;margin-top:5px">Institution-level oversight of the Student Council.</p></div><button class="small-btn" onclick="refreshPrincipalDashboard()"><i class="fa-solid fa-rotate"></i> Refresh</button></div>
                    <div class="principal-grid" style="margin-top:20px">
                      <div class="principal-kpi"><span>Finance & Budget</span><strong id="principal-pending-finance">Future</strong></div><div class="principal-kpi"><span>Open Grievances</span><strong id="principal-open-grievances">0</strong></div><div class="principal-kpi"><span>Active Tasks</span><strong id="principal-active-tasks">0</strong></div><div class="principal-kpi"><span>Upcoming Events</span><strong id="principal-upcoming-events">0</strong></div>
                    </div>
                  </div>
                  <div class="dash-two-col">
                    <div class="card"><div class="section-header"><div><h3>Finance & Budget</h3><div class="team-small">Planned for a future update</div></div><span class="profile-chip">FUTURE MODULE</span></div><div class="empty-state" style="margin-top:1rem">Finance requests, budgets, treasury workflows and approvals will be available in a future update.</div></div>
                    <div class="card"><div class="section-header"><h3>Administrative Shortcuts</h3></div><div class="module-grid"><div class="module-tile" onclick="goToPage('finance')"><i class="fa-solid fa-file-invoice-dollar"></i><strong>Finance • Future</strong><small>Coming in a future update</small></div><div class="module-tile" onclick="goToPage('teams')"><i class="fa-solid fa-people-group"></i><strong>Leadership</strong><small>Manage teams</small></div><div class="module-tile" onclick="goToPage('power')"><i class="fa-solid fa-bolt"></i><strong>Power Suit</strong><small>Command tools</small></div><div class="module-tile" onclick="goToPage('analytics')"><i class="fa-solid fa-chart-line"></i><strong>Reports</strong><small>Analytics & exports</small></div></div></div>
                  </div>
                </div>

                <!-- PAGE 1: DASHBOARD (Perfect Replica) -->
                <div id="view-dashboard" class="view-section hide scms-original-dashboard">
  <div class="dash-welcome-row">
    <div class="dash-welcome">
      <div class="dash-eyebrow"><span class="live-dot"></span> COUNCIL COMMAND CENTER</div>
      <h1>Welcome back, <span id="dash-user-name">Council Member</span>! <span class="wave">👋</span></h1>
      <p id="dash-role-subtitle">Student Council Dashboard</p>
    </div>
    <div class="dash-date"><i class="fa-regular fa-calendar"></i><span id="dash-date-label">31 August, 2026</span></div>
  </div>

  <div class="dash-layout">
    <section class="dash-main-col">
      <div class="dash-kpi-grid">
        <div class="dash-kpi">
          <div class="dash-kpi-icon"><i class="fa-solid fa-clipboard-check"></i></div>
          <div><span>Total Tasks</span><strong id="stat-total">0</strong></div>
          <button onclick="document.querySelector('[data-page=\'tasks\']').click()">View all <i class="fa-solid fa-arrow-right"></i></button>
        </div>
        <div class="dash-kpi">
          <div class="dash-kpi-icon"><i class="fa-solid fa-hourglass-half"></i></div>
          <div><span>Pending Tasks</span><strong id="stat-pending">0</strong></div>
          <button onclick="document.querySelector('[data-page=\'tasks\']').click()">View all <i class="fa-solid fa-arrow-right"></i></button>
        </div>
        <div class="dash-kpi success">
          <div class="dash-kpi-icon"><i class="fa-solid fa-chart-line"></i></div>
          <div><span>Completed Tasks</span><strong id="stat-completed">0</strong></div>
          <button onclick="document.querySelector('[data-page=\'tasks\']').click()">View all <i class="fa-solid fa-arrow-right"></i></button>
        </div>
        <div class="dash-kpi danger">
          <div class="dash-kpi-icon"><i class="fa-regular fa-clock"></i></div>
          <div><span>Overdue Tasks</span><strong id="stat-overdue">0</strong></div>
          <button onclick="document.querySelector('[data-page=\'tasks\']').click()">View all <i class="fa-solid fa-arrow-right"></i></button>
        </div>
      </div>

      <div class="dash-two-col">
        <div class="dash-card task-overview-card">
          <div class="dash-card-head"><h3>Task Overview</h3><button onclick="document.querySelector('[data-page=\'tasks\']').click()">View all tasks <i class="fa-solid fa-arrow-right"></i></button></div>
          <div class="task-overview-body">
            <div class="donut-large"><div><strong id="dash-donut-total">0</strong><span>Total</span></div></div>
            <div class="task-legend">
              <div><i class="legend-dot pending"></i><span>Pending</span><b id="legend-pending">0</b><small id="legend-pending-pct">0%</small></div>
              <div><i class="legend-dot progress"></i><span>In Progress</span><b id="legend-progress">0</b><small id="legend-progress-pct">0%</small></div>
              <div><i class="legend-dot completed"></i><span>Completed</span><b id="legend-completed">0</b><small id="legend-completed-pct">0%</small></div>
              <div><i class="legend-dot overdue"></i><span>Overdue</span><b id="legend-overdue">0</b><small id="legend-overdue-pct">0%</small></div>
            </div>
          </div>
        </div>

        <div class="dash-card">
          <div class="dash-card-head"><h3>Upcoming Events</h3><button onclick="document.querySelector('[data-page=\'events\']').click()">View all events <i class="fa-solid fa-arrow-right"></i></button></div>
          <div id="dash-events-container" class="dash-event-list"></div>
        </div>
      </div>

      <div class="dash-card portfolio-card">
        <div class="dash-card-head"><h3>Portfolio Activity</h3><button onclick="document.querySelector('[data-page=\'teams\']').click()">View full report <i class="fa-solid fa-arrow-right"></i></button></div>
        <div class="portfolio-grid">
          <button onclick="document.querySelector('[data-page=\'teams\']').click()"><i class="fa-solid fa-trophy"></i><span>Sports<small>12 Tasks</small></span></button>
          <button onclick="document.querySelector('[data-page=\'teams\']').click()"><i class="fa-solid fa-laptop-code"></i><span>Technical<small>14 Tasks</small></span></button>
          <button onclick="document.querySelector('[data-page=\'teams\']').click()"><i class="fa-solid fa-masks-theater"></i><span>Cultural<small>10 Tasks</small></span></button>
          <button onclick="document.querySelector('[data-page=\'teams\']').click()"><i class="fa-solid fa-hand-holding-heart"></i><span>Social Responsibility<small>9 Tasks</small></span></button>
          <button onclick="document.querySelector('[data-page=\'teams\']').click()"><i class="fa-solid fa-bullhorn"></i><span>PR &amp; Media<small>7 Tasks</small></span></button>
          <button onclick="document.querySelector('[data-page=\'teams\']').click()"><i class="fa-solid fa-people-group"></i><span>Student Welfare<small>8 Tasks</small></span></button>
          <button onclick="document.querySelector('[data-page=\'teams\']').click()"><i class="fa-solid fa-briefcase"></i><span>T&amp;P<small>6 Tasks</small></span></button>
          <button onclick="document.querySelector('[data-page=\'teams\']').click()"><i class="fa-solid fa-user-group"></i><span>Women’s Rep.<small>5 Tasks</small></span></button>
        </div>
      </div>
    </section>

    <div class="dash-right-col">
      <div class="dash-card">
        <div class="dash-card-head"><h3>Announcements</h3><button onclick="document.querySelector('[data-page=\'announcements\']')?.click()">View all <i class="fa-solid fa-arrow-right"></i></button></div>
        <div class="announcement-list">
          <div><i class="fa-solid fa-bullhorn"></i><span>Student Council Orientation Program<small>23 Aug, 2026</small></span></div>
          <div><i class="fa-solid fa-bullhorn"></i><span>Submission of Event Proposals<small>22 Aug, 2026</small></span></div>
          <div><i class="fa-solid fa-bullhorn"></i><span>Independence Day Celebration<small>15 Aug, 2026</small></span></div>
        </div>
