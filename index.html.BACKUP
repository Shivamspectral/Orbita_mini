  ]},
  {id:'welfare',leadRole:'Student Welfare Secretary',lead:'Aryan Shirpute',class:'SE',branch:'IOT',icon:'fa-heart-circle-check',colorClass:'team-pink',faculty:'Vaibhav Munde',facultyDept:'Mechanical Engineering Department',members:[
    ['Sarthak Misal','SE','Comp','Committee Member'],['Darshan Patil','SE','ENCE','Committee Member'],['Vishal Aswar','SE','E&TC','Committee Member'],['Sankashti Jagdambe','SE','E&TC','Committee Member'],['Anil Rathod','SE','COMP','Committee Member']
  ]},
  {id:'women',leadRole:"Women's Representative",lead:'Likhitha Teppda',class:'TE',branch:'COMP',icon:'fa-venus',colorClass:'team-rose',faculty:'Nilima Patil',facultyDept:'First Year Department',members:[
    ['Payal Pimple','SE','AIML','Committee Member'],['Pratidnya Talekar','TE','E&TC','Committee Member'],['Rutuja Bhaval','SE','AIDS','Committee Member'],['Aishwarya Bhosale','SE','IT','Committee Member'],['Ruksana Khan','SE','COMP','Committee Member']
  ]},
  {id:'tnp',leadRole:'Training & Placement Representative',lead:'Bhavesh Mahajan',class:'TE',branch:'E&TC',icon:'fa-briefcase',colorClass:'team-teal',faculty:'Richa Nighote',facultyDept:'TNP Department',facultyCoordinators:[['Nilima Patil','First Year Department'],['Richa Nighote','TNP Department']],members:[
    ['Shruti Supekar','TE','Comp','Committee Member'],['Ganesh Harel','TE','IOT','Committee Member'],['Pranali Ghogare','SE','AIML','Committee Member'],['Kaushik Gunkar','TE','AIDS','Committee Member'],['Snehal Aade','SE','IT','Committee Member']
  ]}
];

const OFFICIAL_ROSTER = [
  ['Rupali Tagunde','TE','AIML','President','Executive Council'],['Purnima Patra','TE','IOT','Vice-President','Executive Council'],['Kiran Prasad','TE','COMP','General Secretary','Executive Council'],['Kajal Bodke','TE','E&TC','Joint Secretary','Executive Council'],['Vedant Aware','SE','AIML','Joint Secretary','Executive Council'],['Tushar Gawali','SE','ELECT','Treasurer','Executive Council'],['Aachal Baviskar','SE','Mech','Committee Member','Executive Council'],['Sandhya Kolpe','SE','Mech','Committee Member','Executive Council'],['Ajeet Mahatme','','','Faculty Coordinator','Accounts Department'],
  ['Aryan Pentewar','TE','COMP','Cultural Secretary','Cultural'],['Prachi Tarale','SE','Comp','Committee Member','Cultural'],['Sakshi Yadav','SE','AIDS','Committee Member','Cultural'],['Chandrakant Shinde','SE','IOT','Committee Member','Cultural'],['Ronic Vasane','SE','AIDS','Committee Member','Cultural'],['Pratik Galande','SE','COMP','Committee Member','Cultural'],['Rushikesh More','','','Faculty Coordinator','First Year Department'],
  ['Prachi Dinkar','TE','IT','Sports Secretary','Sports'],['Abhijeet Nimbalkar','SE','COMP','Committee Member','Sports'],['Pragati Sarnaik','SE','AIML','Committee Member','Sports'],['Pranav Avate','SE','AIML','Committee Member','Sports'],['Ajay Kadam','SE','ELECT','Committee Member','Sports'],['Ansari Faizan','SE','AIDS','Committee Member','Sports'],['Gopinath Kalokhe','','','Faculty Coordinator','Sports Department'],
  ['Samiksha Harap','TE','ECE','Technical Secretary','Technical'],['Tanmay Yewale','SE','AIDS','Committee Member','Technical'],['Ankita Suryavanshi','TE','AIDS','Committee Member','Technical'],['Rohan Patil','SE','CYB','Committee Member','Technical'],['Shubham Giram','SE','COMP','Committee Member','Technical'],['Harhkumar Rajput','SE','AIDS','Committee Member','Technical'],['Swati Deshmukh','','','Faculty Coordinator','Electronics & Tele-Communication Engineering'],
  ['Anzar Sayyad','SE','E&TC','Social Responsibility Secretary','Social Responsibility'],['Mohit Chandanmathe','TE','ENCE','Committee Member','Social Responsibility'],['Gaurav Dhormare','BE','CIVIL','Committee Member','Social Responsibility'],['Krishna Dixit','SE','MECH','Committee Member','Social Responsibility'],['Shivam Prajapati','TE','AIDS','Committee Member','Social Responsibility'],['Dnyaneshwari Birajdar','SE','AIML','Committee Member','Social Responsibility'],
  ['Mayur Kadam','','','Faculty Coordinator','Diploma Mechanical Department'],['Shreyash Ghanvat','','','Faculty Coordinator','Civil Engineering Department'],['Karishma Savalekar','TE','E&TC','Public Relations & Media Secretary','Public Relations & Media'],['Savan Doiphode','SE','AIML','Committee Member','Public Relations & Media'],['Harshvardhan Bhalerao','SE','E&TC','Committee Member','Public Relations & Media'],['Vaibhav Aaglave','SE','AIML','Committee Member','Public Relations & Media'],['Dashrath Koli','SE','ENCE','Committee Member','Public Relations & Media'],['Siddhi Londhe','SE','AIDS','Committee Member','Public Relations & Media'],['Rajesh Mahamuni','','','Faculty Coordinator','Computer Engineering Department'],
  ['Aryan Shirpute','SE','IOT','Student Welfare Secretary','Student Welfare'],['Sarthak Misal','SE','Comp','Committee Member','Student Welfare'],['Darshan Patil','SE','ENCE','Committee Member','Student Welfare'],['Vishal Aswar','SE','E&TC','Committee Member','Student Welfare'],['Sankashti Jagdambe','SE','E&TC','Committee Member','Student Welfare'],['Anil Rathod','SE','COMP','Committee Member','Student Welfare'],['Vaibhav Munde','','','Faculty Coordinator','Mechanical Engineering Department'],
  ['Likhitha Teppda','TE','COMP',"Women's Representative","Women's Representation"],['Payal Pimple','SE','AIML','Committee Member',"Women's Representation"],['Pratidnya Talekar','TE','E&TC','Committee Member',"Women's Representation"],['Rutuja Bhaval','SE','AIDS','Committee Member',"Women's Representation"],['Aishwarya Bhosale','SE','IT','Committee Member',"Women's Representation"],['Ruksana Khan','SE','COMP','Committee Member',"Women's Representation"],['Nilima Patil','','','Faculty Coordinator','First Year Department'],
  ['Bhavesh Mahajan','TE','E&TC','Training & Placement Representative','Training & Placement'],['Shruti Supekar','TE','Comp','Committee Member','Training & Placement'],['Ganesh Harel','TE','IOT','Committee Member','Training & Placement'],['Pranali Ghogare','SE','AIML','Committee Member','Training & Placement'],['Kaushik Gunkar','TE','AIDS','Committee Member','Training & Placement'],['Snehal Aade','SE','IT','Committee Member','Training & Placement'],['Richa Nighote','','','Faculty Coordinator','TNP Department']
].map((r,i)=>({id:i+1,name:r[0],class:r[1],branch:r[2],role_name:r[3],team:r[4],department:r[4]})); 
 
        const TEAM_ACTIVITY = { 
            executive:["Executive council review","Core council coordination","Monthly action tracker"], 
            cultural:["Cultural calendar planning","Event rehearsal coordination","Inter-department activity"], 
            sports:["Tournament planning","Practice & participation","Sports equipment tracker"], 
            technical:["Hackathon & technical events","Portal and AV support","Technical workshop planning"], 
            social:["Community outreach","Social responsibility drive","Student engagement activities"], 
            pr:["Event publicity","Social media calendar","Media and documentation"], 
            welfare:["Student grievance follow-up","Welfare initiatives","Student support coordination"], 
            women:["Women's safety & inclusion","Awareness campaigns","Student outreach"], 
            tnp:["Placement preparation","Training calendar","Industry interaction"] 
        }; 
 
        let ACTIVE_TEAM_ID = null; 
 
        function initials(name=''){ 
            return name.split(/\s+/).filter(Boolean).slice(0,2).map(x=>x[0]).join('').toUpperCase(); 
        } 
        function getTeam(id){ return COUNCIL_TEAMS.find(t=>t.id===id); } 
 
        function renderTeamDirectory(query=''){ 
            const q=(query||'').toLowerCase().trim(); 
            const mode=document.getElementById('team-filter')?.value||''; 
            const rows=COUNCIL_TEAMS.filter(t=>{ 
                const blob=[t.lead,t.leadRole,t.class,t.branch,t.faculty,t.facultyDept,...t.members.flat()].join(' ').toLowerCase(); 
                return (!q || blob.includes(q)) && (!mode || mode==='lead' || mode==='faculty'); 
            }); 
            const host=document.getElementById('team-directory'); 
            if(!host)return; 
            host.innerHTML=rows.map(t=>` 
                <div class="team-lead-card ${ACTIVE_TEAM_ID===t.id?'active':''}" onclick="openTeamWorkspace('${t.id}')"> 
                    <div class="team-avatar"><i class="fa-solid ${t.icon}"></i></div> 
                    <div><div style="font-weight:800;font-size:.84rem">${escapeHtml(t.lead)}</div><div style="font-size:.72rem;color:#58647a">${escapeHtml(t.leadRole)}</div><div class="team-small">${t.members.length} committee members · ${escapeHtml(t.branch)}</div></div> 
                    <i class="fa-solid fa-chevron-right" style="color:#a0a8b8"></i> 
                </div>`).join('') || emptyState('fa-users-slash','No matching teams','Try another lead, role or member name.'); 
            renderTeamKpis(); 
        } 
 
        function renderTeamKpis(){ 
            const totalTeams=COUNCIL_TEAMS.length; 
            const totalMembers=COUNCIL_TEAMS.reduce((n,t)=>n+t.members.length,0); 
            const totalLeads=COUNCIL_TEAMS.length; 
            const faculty=COUNCIL_TEAMS.reduce((n,t)=>n+(t.facultyCoordinators?.length || (t.faculty?1:0)),0); 
            const k=document.getElementById('team-kpis'); 
            if(!k)return; 
            k.innerHTML=` 
                <div class="kpi"><div class="kpi-label">Functional Teams</div><div class="kpi-value">${totalTeams}</div></div> 
                <div class="kpi"><div class="kpi-label">Committee Members</div><div class="kpi-value">${totalMembers}</div></div> 
                <div class="kpi"><div class="kpi-label">Student Leads</div><div class="kpi-value">${totalLeads}</div></div> 
                <div class="kpi"><div class="kpi-label">Faculty Coordinators</div><div class="kpi-value">${faculty}</div></div>`; 
        } 
 
        function showAllTeams(){ 
            ACTIVE_TEAM_ID=null; 
            renderTeamDirectory(document.getElementById('team-search')?.value||''); 
            const box=document.getElementById('team-workspace'); 
            if(!box)return; 
            box.innerHTML=` 
                <div class="team-hero"> 
                    <div class="team-hero-top"> 
                        <div class="team-identity"> 
                            <div class="team-avatar team-blue"><i class="fa-solid fa-people-group"></i></div> 
                            <div><h2>Student Council 2026-27</h2><div class="team-role">Leadership & Functional Team Command</div><div class="team-meta"><span class="pill-badge">9 functional teams</span><span class="pill-badge">All committee members</span><span class="pill-badge">Central coordination</span></div></div> 
                        </div> 
                    </div> 
                </div> 
                <div class="team-member-grid"> 
                    ${COUNCIL_TEAMS.map(t=>` 
                        <div class="team-member-card" onclick="openTeamWorkspace('${t.id}')" style="cursor:pointer"> 
                            <div class="team-member-main"><div class="member-mini"><i class="fa-solid ${t.icon}"></i></div><div><strong>${escapeHtml(t.lead)}</strong><div class="team-small">${escapeHtml(t.leadRole)}</div></div></div> 
                            <span class="pill-badge pill-blue">${t.members.length} members</span> 
                        </div>`).join('')} 
                </div>`; 
        } 
 
        function openTeamWorkspace(id){ 
            const t=getTeam(id); if(!t)return; 
            ACTIVE_TEAM_ID=id; 
            renderTeamDirectory(document.getElementById('team-search')?.value||''); 
            const recent=TEAM_ACTIVITY[id]||["Team planning","Task follow-up","Council coordination"]; 
            const box=document.getElementById('team-workspace'); 
            if(!box)return; 
            box.innerHTML=` 
                <div class="team-hero"> 
                    <div class="team-hero-top"> 
                        <div class="team-identity"> 
                            <div class="team-avatar ${t.colorClass}"><i class="fa-solid ${t.icon}"></i></div> 
                            <div><h2>${escapeHtml(t.lead)}</h2><div class="team-role">${escapeHtml(t.leadRole)}</div> 
                                <div class="team-meta"><span class="pill-badge">${escapeHtml(t.class)} · ${escapeHtml(t.branch)}</span><span class="pill-badge">${t.members.length} committee members</span>${(t.facultyCoordinators||[]).length ? (t.facultyCoordinators||[]).map(f=>`<span class="pill-badge"><i class="fa-solid fa-user-tie"></i> ${escapeHtml(f[0])}</span>`).join('') : (t.faculty ? `<span class="pill-badge"><i class="fa-solid fa-user-tie"></i> ${escapeHtml(t.faculty)}</span>` : '')}</div> 
                            </div> 
                        </div> 
                        <div class="team-actions"> 
                            <button class="team-action" onclick="teamAction('Task assigned to team')"><i class="fa-solid fa-plus"></i> Add Task</button> 
                            <button class="team-action" onclick="teamAction('Team meeting created')"><i class="fa-solid fa-calendar"></i> Meeting</button> 
                            <button class="team-action" onclick="teamAction('Announcement prepared')"><i class="fa-solid fa-bullhorn"></i> Announce</button> 
                            <button class="team-action" onclick="teamAction('Report export prepared')"><i class="fa-solid fa-file-export"></i> Report</button> 
                        </div> 
                    </div> 
                </div> 
                <div class="team-stats" id="live-team-stats-${id}"> 
                    <div class="team-stat"><div class="team-stat-label">Members</div><div class="team-stat-value">${t.members.length}</div></div> 
                    <div class="team-stat"><div class="team-stat-label">Open Tasks</div><div class="team-stat-value">—</div></div> 
                    <div class="team-stat"><div class="team-stat-label">Budget Left</div><div class="team-stat-value">—</div></div> 
                    <div class="team-stat"><div class="team-stat-label">Utilization</div><div class="team-stat-value">—</div></div> 
                </div> 
                <div class="team-tabs"> 
                    <button class="team-tab active" onclick="switchTeamTab(this,'team-overview-${id}')"><i class="fa-solid fa-gauge-high"></i> Overview</button> 
                    <button class="team-tab" onclick="switchTeamTab(this,'team-people-${id}')"><i class="fa-solid fa-users"></i> Team</button> 
                    <button class="team-tab" onclick="switchTeamTab(this,'team-tasks-${id}')"><i class="fa-solid fa-list-check"></i> Tasks</button> 
                    <button class="team-tab" onclick="switchTeamTab(this,'team-goals-${id}')"><i class="fa-solid fa-bullseye"></i> Goals</button> 
                    <button class="team-tab" onclick="switchTeamTab(this,'team-budget-${id}')"><i class="fa-solid fa-wallet"></i> Budget</button> 
                    <button class="team-tab" onclick="switchTeamTab(this,'team-performance-${id}')"><i class="fa-solid fa-chart-line"></i> Performance</button> 
                    <button class="team-tab" onclick="switchTeamTab(this,'team-meetings-${id}')"><i class="fa-solid fa-handshake"></i> Meetings</button> 
                    <button class="team-tab" onclick="switchTeamTab(this,'team-files-${id}')"><i class="fa-solid fa-folder-open"></i> Files</button> 
                    <button class="team-tab" onclick="switchTeamTab(this,'team-approvals-${id}')"><i class="fa-solid fa-circle-check"></i> Approvals</button> 
                </div> 
                <div id="team-overview-${id}" class="team-tab-panel active"> 
                    <div class="team-note"><strong>Faculty Coordination:</strong> ${((t.facultyCoordinators||[]).length ? t.facultyCoordinators.map(f=>`${escapeHtml(f[0])} — ${escapeHtml(f[1])}`).join(' · ') : (t.faculty ? `${escapeHtml(t.faculty)} — ${escapeHtml(t.facultyDept)}` : 'No faculty coordinator is listed for this team in the selection report.'))}. This workspace is the operating page for the lead and committee.</div> 
                    <div class="team-log" style="margin-top:.8rem">${recent.map((a,i)=>`<div class="team-log-item"><div class="team-log-icon"><i class="fa-solid ${i===0?'fa-flag':i===1?'fa-calendar-check':'fa-gear'}"></i></div><div><strong>${escapeHtml(a)}</strong><div class="team-small">Planned team activity</div></div></div>`).join('')}</div> 
                </div> 
                <div id="team-people-${id}" class="team-tab-panel"> 
                    <div class="team-member-grid"> 
                        ${t.members.map(m=>`<div class="team-member-card"><div class="team-member-main"><div class="member-mini">${initials(m[0])}</div><div><strong>${escapeHtml(m[0])}</strong><div class="team-small">${escapeHtml(m[3])}</div><div class="team-small">${escapeHtml(m[1])} · ${escapeHtml(m[2])}</div></div></div><button class="small-btn" onclick="teamAction('Profile opened')"><i class="fa-solid fa-user"></i></button></div>`).join('')} 
                    </div> 
                </div> 
                <div id="team-tasks-${id}" class="team-tab-panel"> 
                    <div class="view-toolbar"><strong>Team Tasks</strong><div class="toolbar-actions"><button class="small-btn" onclick="teamAction('New team task created')"><i class="fa-solid fa-plus"></i> New</button><button class="small-btn" onclick="teamAction('Task board opened')"><i class="fa-solid fa-table-cells"></i> Board</button></div></div> 
                    <div class="team-log">${recent.map((a,i)=>`<div class="team-log-item"><div class="team-log-icon"><i class="fa-solid fa-list-check"></i></div><div style="flex:1"><strong>${escapeHtml(a)}</strong><div class="team-small">Owner: ${escapeHtml(t.lead)} · ${i%2?'Medium':'High'} priority</div></div><span class="pill-badge ${i%2?'pill-orange':'pill-blue'}">${i%2?'In Progress':'Planned'}</span></div>`).join('')}</div> 
                </div> 
                <div id="team-goals-${id}" class="team-tab-panel"> 
                    <div class="team-note"><strong>Quarter goals</strong><br>Define measurable outcomes for this functional team, assign owners and review progress during every council meeting.</div> 
                    <div class="team-log" style="margin-top:.8rem"><div class="team-log-item"><div class="team-log-icon"><i class="fa-solid fa-bullseye"></i></div><div><strong>Primary team objective</strong><div class="team-small">Create the 2026-27 action calendar for ${escapeHtml(t.leadRole)}.</div></div><span class="pill-badge pill-green">Active</span></div><div class="team-log-item"><div class="team-log-icon"><i class="fa-solid fa-chart-line"></i></div><div><strong>Monthly progress review</strong><div class="team-small">Review participation, task closure and upcoming activities.</div></div><span class="pill-badge pill-blue">Monthly</span></div></div> 
                </div> 
                <div id="team-budget-${id}" class="team-tab-panel"> 
                    <div class="budget-actions"> 
                        <div><strong>Department Budget Command Center</strong><div class="team-small">Live allocation, spending and financial utilization for this lead's team.</div></div> 
                        <div class="toolbar-actions"><button class="small-btn" onclick="loadTeamDashboard('${id}')"><i class="fa-solid fa-rotate"></i> Refresh</button><button class="small-btn" onclick="exportTeamBudget('${id}')"><i class="fa-solid fa-file-csv"></i> Export</button></div> 
                    </div> 
                    <div class="team-budget-grid" id="budget-kpis-${id}"> 
                        <div class="budget-card highlight"><div class="label">Assigned Budget</div><div class="value">₹0</div></div> 
                        <div class="budget-card"><div class="label">Budget Used</div><div class="value">₹0</div></div> 
                        <div class="budget-card"><div class="label">Pending Requests</div><div class="value">₹0</div></div> 
                        <div class="budget-card"><div class="label">Remaining</div><div class="value">₹0</div></div> 
                        <div class="budget-card"><div class="label">Utilization</div><div class="value">0%</div><div class="budget-progress"><span></span></div></div> 
                    </div> 
                    <div class="budget-forms"> 
                        <div class="budget-form"> 
                            <h4><i class="fa-solid fa-sliders"></i> Allocation</h4> 
                            <div class="team-small" style="margin-bottom:.55rem">Authorized executive/finance/faculty users can assign the annual team budget.</div> 
                            <input id="budget-amount-${id}" type="number" min="0" step="100" placeholder="Assigned amount (₹)"> 
                            <input id="budget-year-${id}" type="text" value="2026-27" placeholder="Financial year"> 
                            <textarea id="budget-notes-${id}" rows="3" placeholder="Budget rules / notes"></textarea> 
                            <button class="small-btn" onclick="saveTeamBudget('${id}')"><i class="fa-solid fa-floppy-disk"></i> Save Allocation</button> 
                        </div> 
                        <div class="budget-form"> 
                            <h4><i class="fa-solid fa-receipt"></i> Record Expense</h4> 
                            <div class="team-small" style="margin-bottom:.55rem">Record approved expenditure directly against the team's ledger.</div> 
                            <input id="expense-title-${id}" type="text" placeholder="Expense title"> 
                            <input id="expense-amount-${id}" type="number" min="1" step="1" placeholder="Amount (₹)"> 
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem"><select id="expense-type-${id}"><option>Expense</option><option>Purchase</option><option>Travel</option><option>Event</option><option>Marketing</option><option>Equipment</option></select><input id="expense-ref-${id}" type="text" placeholder="Reference / bill no."></div> 
                            <button class="small-btn" onclick="recordTeamExpense('${id}')"><i class="fa-solid fa-plus"></i> Add Expense</button> 
                        </div> 
                    </div> 
                    <div style="margin-top:1rem"><h4 style="margin-bottom:.6rem">Budget Ledger</h4><div class="team-log" id="budget-ledger-${id}"><div class="team-small">Loading ledger...</div></div></div> 
                </div> 
                <div id="team-performance-${id}" class="team-tab-panel"> 
                    <div class="team-note"><strong>Lead Performance Center</strong><br>Monitor execution, team activity, financial discipline and delivery health for this functional area.</div> 
                    <div class="team-performance" id="team-performance-grid-${id}"> 
                        <div class="performance-card"><small>Open Tasks</small><div class="metric">—</div></div> 
                        <div class="performance-card"><small>Completed Tasks</small><div class="metric">—</div></div> 
                        <div class="performance-card"><small>Events</small><div class="metric">—</div></div> 
                        <div class="performance-card"><small>Goals</small><div class="metric">—</div></div> 
                        <div class="performance-card"><small>Meetings</small><div class="metric">—</div></div> 
                        <div class="performance-card"><small>Pending Approvals</small><div class="metric">—</div></div> 
                        <div class="performance-card"><small>Announcements</small><div class="metric">—</div></div> 
                        <div class="performance-card"><small>Team Members</small><div class="metric">${t.members.length}</div></div> 
                    </div> 
                </div> 
                <div id="team-meetings-${id}" class="team-tab-panel"><div class="team-log"><div class="team-log-item"><div class="team-log-icon"><i class="fa-solid fa-calendar-day"></i></div><div><strong>Team planning meeting</strong><div class="team-small">Agenda: priorities, task assignments, upcoming events and blockers.</div></div><span class="pill-badge pill-blue">Schedule</span></div><div class="team-log-item"><div class="team-log-icon"><i class="fa-solid fa-comments"></i></div><div><strong>Lead review</strong><div class="team-small">Lead + faculty coordinator review.</div></div><span class="pill-badge pill-orange">Review</span></div></div></div> 
                <div id="team-files-${id}" class="team-tab-panel"><div class="team-log">${["Team action plan","Monthly report","Event checklist","Meeting minutes","Member roster"].map(x=>`<div class="team-log-item"><div class="team-log-icon"><i class="fa-solid fa-file-lines"></i></div><div style="flex:1"><strong>${x}</strong><div class="team-small">Council workspace document</div></div><button class="small-btn" onclick="teamAction('Opened ${x}')"><i class="fa-solid fa-eye"></i></button></div>`).join('')}</div></div> 
                <div id="team-approvals-${id}" class="team-tab-panel"><div class="team-log"><div class="team-log-item"><div class="team-log-icon"><i class="fa-solid fa-circle-check"></i></div><div style="flex:1"><strong>Activity proposal</strong><div class="team-small">Awaiting review by council leadership.</div></div><button class="small-btn" onclick="teamAction('Approval request opened')">Review</button></div><div class="team-log-item"><div class="team-log-icon"><i class="fa-solid fa-indian-rupee-sign"></i></div><div style="flex:1"><strong>Budget request</strong><div class="team-small">Attach estimate, justification and supporting documents.</div></div><button class="small-btn" onclick="teamAction('Budget workflow opened')">Open</button></div></div></div>`; 
        ; 
            loadTeamDashboard(id); 
        } 
 
 
        async function loadTeamDashboard(teamId){ 
            try{ 
                const data=await apiFetch(`/teams/${teamId}/budget`); 
                const b=data.budget||{}; 
                const fmt=n=>`₹${Number(n||0).toLocaleString('en-IN',{maximumFractionDigits:0})}`; 
                const k=document.getElementById(`budget-kpis-${teamId}`); 
                if(k){ 
                    k.innerHTML=`<div class="budget-card highlight"><div class="label">Assigned Budget</div><div class="value">${fmt(b.allocated)}</div></div> 
                    <div class="budget-card"><div class="label">Budget Used</div><div class="value">${fmt(b.used)}</div></div> 
                    <div class="budget-card"><div class="label">Pending Requests</div><div class="value">${fmt(b.pending_requests)}</div></div> 
                    <div class="budget-card"><div class="label">Remaining</div><div class="value">${fmt(b.remaining)}</div></div> 
                    <div class="budget-card"><div class="label">Utilization</div><div class="value">${Number(b.utilization||0).toFixed(1)}%</div><div class="budget-progress"><span style="width:${Math.min(100,Number(b.utilization||0))}%"></span></div></div>`; 
                } 
                const year=document.getElementById(`budget-year-${teamId}`); const amount=document.getElementById(`budget-amount-${teamId}`); const notes=document.getElementById(`budget-notes-${teamId}`); 
                if(amount && !amount.value) amount.value=b.allocated||0; if(year) year.value=b.fiscal_year||'2026-27'; if(notes && !notes.value) notes.value=b.notes||''; 
                const stats=document.getElementById(`live-team-stats-${teamId}`); 
                if(stats){ 
                    stats.querySelectorAll('.team-stat-value')[0].innerText=data.counts.members; 
                    stats.querySelectorAll('.team-stat-value')[1].innerText=data.counts.open_tasks; 
                    stats.querySelectorAll('.team-stat-value')[2].innerText=fmt(b.remaining); 
                    stats.querySelectorAll('.team-stat-value')[3].innerText=`${Number(b.utilization||0).toFixed(1)}%`; 
                } 
                const perf=document.getElementById(`team-performance-grid-${teamId}`); 
                if(perf){ 
                    const c=data.counts; 
                    perf.innerHTML=`<div class="performance-card"><small>Open Tasks</small><div class="metric">${c.open_tasks}</div></div> 
                    <div class="performance-card"><small>Completed Tasks</small><div class="metric">${c.completed_tasks}</div></div> 
                    <div class="performance-card"><small>Events</small><div class="metric">${c.events}</div></div> 
                    <div class="performance-card"><small>Goals</small><div class="metric">${c.goals}</div></div> 
                    <div class="performance-card"><small>Meetings</small><div class="metric">${c.meetings}</div></div> 
                    <div class="performance-card"><small>Pending Approvals</small><div class="metric">${c.pending_approvals}</div></div> 
                    <div class="performance-card"><small>Announcements</small><div class="metric">${c.announcements}</div></div> 
                    <div class="performance-card"><small>Team Members</small><div class="metric">${c.members}</div></div>`; 
                } 
                await loadBudgetLedger(teamId); 
            }catch(e){ showToast(e.message||'Unable to load team dashboard','error'); } 
        } 
 
        async function loadBudgetLedger(teamId){ 
            const box=document.getElementById(`budget-ledger-${teamId}`); if(!box)return; 
            try{ 
                const rows=await apiFetch(`/teams/${teamId}/budget/transactions`); 
                box.innerHTML=rows.length?rows.map(r=>`<div class="team-log-item"><div class="team-log-icon"><i class="fa-solid fa-receipt"></i></div><div style="flex:1"><strong>${escapeHtml(r.title)}</strong><div class="team-small">${escapeHtml(r.transaction_type)} · ${escapeHtml(r.reference||'No reference')} · ${escapeHtml(r.created_by_name||'')}</div></div><strong style="color:#b91c1c">₹${Number(r.amount||0).toLocaleString('en-IN')}</strong><span class="pill-badge ${r.status==='Approved'?'pill-green':'pill-orange'}">${escapeHtml(r.status)}</span></div>`).join(''):`<div class="empty-state"><i class="fa-solid fa-receipt"></i><strong>No budget transactions</strong><span>This team's expense ledger is empty.</span></div>`; 
            }catch(e){box.innerHTML='<div class="team-small">Ledger unavailable.</div>';} 
        } 
 
        async function saveTeamBudget(teamId){ 
            const allocated=Number(document.getElementById(`budget-amount-${teamId}`).value||0); 
            const fiscal_year=document.getElementById(`budget-year-${teamId}`).value||'2026-27'; 
            const notes=document.getElementById(`budget-notes-${teamId}`).value||''; 
            try{ 
                const db=getLocalDB(); db.team_budgets=db.team_budgets||{}; db.team_budgets[teamId]={team_id:teamId,allocated_amount:allocated,fiscal_year,notes,updated_at:new Date().toISOString()}; saveLocalDB(db); 
                showToast('Team budget allocation saved.'); await loadTeamDashboard(teamId); 
            }catch(e){showToast(e.message,'error');} 
        } 
 
        async function recordTeamExpense(teamId){ 
            const title=document.getElementById(`expense-title-${teamId}`).value.trim(); 
            const amount=Number(document.getElementById(`expense-amount-${teamId}`).value||0); 
            const transaction_type=document.getElementById(`expense-type-${teamId}`).value; 
            const reference=document.getElementById(`expense-ref-${teamId}`).value.trim(); 
            if(!title||!amount){showToast('Enter expense title and amount.','error');return;} 
            try{ 
                const db=getLocalDB(); db.budget_transactions=db.budget_transactions||[]; db.budget_transactions.unshift({id:nextId(db.budget_transactions),team_id:teamId,title,amount,transaction_type,status:'Approved',reference,created_by:CURRENT_USER?.id||null,created_by_name:CURRENT_USER?.name||'',created_at:new Date().toISOString()}); saveLocalDB(db); 
                showToast('Expense added to team budget.'); 
                document.getElementById(`expense-title-${teamId}`).value='';document.getElementById(`expense-amount-${teamId}`).value='';document.getElementById(`expense-ref-${teamId}`).value=''; 
                await loadTeamDashboard(teamId); 
            }catch(e){showToast(e.message,'error');} 
        } 
 
        function exportTeamBudget(teamId){ 
            apiFetch(`/teams/${teamId}/budget/transactions`).then(rows=>{ 
                const lines=[['Title','Amount','Type','Status','Reference','Created By','Created At'],...rows.map(r=>[r.title,r.amount,r.transaction_type,r.status,r.reference||'',r.created_by_name||'',r.created_at])]; 
                const csv=lines.map(row=>row.map(v=>`"${String(v??'').replaceAll('"','""')}"`).join(',')).join('\n'); 
                downloadBlob(csv,`Team_Budget_${teamId}.csv`,'text/csv'); 
                showToast('Team budget export created.'); 
            }).catch(()=>showToast('Export failed.','error')); 
        } 
 
        function switchTeamTab(btn,panelId){ 
            const host=btn.closest('.team-workspace'); 
            host.querySelectorAll('.team-tab').forEach(x=>x.classList.remove('active')); 
            host.querySelectorAll('.team-tab-panel').forEach(x=>x.classList.remove('active')); 
            btn.classList.add('active'); 
            document.getElementById(panelId)?.classList.add('active'); 
        } 
 
        function teamAction(message){ showToast(message); } 
 
        document.addEventListener('click', e=>{ 
            const nav=e.target.closest('.nav-item[data-page="teams"]'); 
            if(nav){ 
                setTimeout(()=>{ 
                    renderTeamDirectory(document.getElementById('team-search')?.value||''); 
                    if(!ACTIVE_TEAM_ID)showAllTeams(); 
                },30); 
            } 
        }); 
 

        window.addEventListener('unhandledrejection',e=>{
            console.error('SCMS unhandled rejection:',e.reason);
            if(e.reason?.message) showToast(e.reason.message,'error');
        });
        window.addEventListener('error',e=>console.error('SCMS runtime error:',e.error||e.message));

    </script> 

<script>
/* SCMS POWER SUITE — local-only feature engine */
const POWER_KEY='scms_power_suite_v1';
function powerStore(){try{return JSON.parse(localStorage.getItem(POWER_KEY)||'null')||{approvals:[],goals:[{title:'Improve student engagement',owner:'General Secretary',progress:72},{title:'Increase event participation',owner:'Cultural & Sports',progress:58},{title:'Improve grievance response',owner:'Student Welfare',progress:81}],docs:[],media:[],achievements:[]};}catch{return {approvals:[],goals:[],docs:[],media:[],achievements:[]}}}
function savePowerStore(x){localStorage.setItem(POWER_KEY,JSON.stringify(x))}
function switchPowerTab(tab){document.querySelectorAll('.power-tab').forEach(x=>x.classList.toggle('active',x.dataset.powerTab===tab));document.querySelectorAll('.power-panel').forEach(x=>x.classList.toggle('active',x.id==='power-panel-'+tab));refreshPowerSuite()}
function powerData(){const db=getLocalDB();return {tasks:db.tasks||[],events:db.events||[],meetings:db.meetings||[],finances:db.finances||[],grievances:db.grievances||[],members:db.members||[]}}
function powerHealth(){const d=powerData();const total=d.tasks.length,done=d.tasks.filter(x=>String(x.status||'').toLowerCase()==='completed').length;const ev=Math.min(100,d.events.length?80+d.events.length*3:60),meet=Math.min(100,d.meetings.length?82+d.meetings.length*2:60),fin=d.finances.length?78:70,g=d.grievances.length?Math.round(d.grievances.filter(x=>['resolved','closed'].includes(String(x.status||'').toLowerCase())).length/d.grievances.length*100):100;return Math.round((total?done/total*100:72)*.35+ev*.15+meet*.15+fin*.15+g*.2)}
function renderPowerAttention(){const d=powerData(),rows=[];const overdue=d.tasks.filter(t=>String(t.status||'').toLowerCase()!=='completed'&&t.due_date&&new Date(t.due_date)<new Date()).length;if(overdue)rows.push(['fa-clock','Overdue tasks',`${overdue} task${overdue>1?'s':''} need immediate action.`,'URGENT']);const urgentG=d.grievances.filter(g=>['urgent','emergency','critical'].includes(String(g.priority||'').toLowerCase())&&!['resolved','closed'].includes(String(g.status||'').toLowerCase())).length;if(urgentG)rows.push(['fa-shield-halved','Priority grievances',`${urgentG} high-priority grievance${urgentG>1?'s':''} open.`,'ATTENTION']);const pendingF=d.finances.filter(f=>String(f.status||'Pending').toLowerCase()==='pending').length;if(pendingF)rows.push(['fa-indian-rupee-sign','Finance approvals',`${pendingF} funding request${pendingF>1?'s':''} pending review.`,'REVIEW']);const upcoming=d.events.filter(e=>e.date&&new Date(e.date)>=new Date()).length;rows.push(['fa-calendar','Upcoming calendar',`${upcoming} upcoming event${upcoming!==1?'s':''} currently indexed.`,'INFO']);const box=document.getElementById('power-attention-list');if(box)box.innerHTML=rows.map(r=>`<div class="power-row"><div class="mini"><i class="fa-solid ${r[0]}"></i></div><div><strong>${escapeHtml(r[1])}</strong><small>${escapeHtml(r[2])}</small></div><span class="power-badge">${r[3]}</span></div>`).join('')||'<div class="power-empty">No attention items. Council is clear. 🎉</div>'}
function renderPowerCalendar(){const d=powerData(),q=(document.getElementById('power-calendar-search')?.value||'').toLowerCase();const rows=[...d.events.map(x=>({date:x.date||'',time:x.start_time||x.time||'',title:x.title||'Event',type:'Event',icon:'fa-calendar'})),...d.meetings.map(x=>({date:x.date||'',time:x.time||'',title:x.title||'Meeting',type:'Meeting',icon:'fa-handshake'})),...d.tasks.filter(x=>x.due_date).map(x=>({date:x.due_date,time:'',title:x.title||'Task deadline',type:'Task deadline',icon:'fa-clipboard-check'}))].filter(x=>!q||`${x.title} ${x.type}`.toLowerCase().includes(q)).sort((a,b)=>String(a.date).localeCompare(String(b.date)));const box=document.getElementById('power-calendar-list');if(box)box.innerHTML=rows.map(x=>`<div class="power-row"><div class="mini"><i class="fa-solid ${x.icon}"></i></div><div><strong>${escapeHtml(x.title)}</strong><small>${escapeHtml(x.date)} ${escapeHtml(x.time)} • ${x.type}</small></div><span class="power-badge">${x.type}</span></div>`).join('')||'<div class="power-empty">No scheduled records.</div>';const st=document.getElementById('power-calendar-stat');if(st)st.textContent=`${rows.length} scheduled`}
function renderApprovals(){const s=powerStore(),box=document.getElementById('power-approval-list');if(box)box.innerHTML=s.approvals.map((x,i)=>`<div class="power-row"><div class="mini"><i class="fa-solid fa-route"></i></div><div><strong>${escapeHtml(x.title)}</strong><small>${escapeHtml(x.type)} • Stage: ${escapeHtml(x.stage||'Team Lead')} • ${escapeHtml(x.created||'')}</small></div><button class="small-btn" onclick="advanceApproval(${i})">Advance</button></div>`).join('')||'<div class="power-empty">Approval queue is empty.</div>';document.getElementById('power-approval-stat')&&(document.getElementById('power-approval-stat').textContent=`${s.approvals.length} requests`)}
function createApproval(){const title=prompt('Approval request title:');if(!title)return;const type=prompt('Type (Finance/Event/Announcement):','Finance')||'General';const s=powerStore();s.approvals.push({title,type,stage:'Team Lead',created:new Date().toLocaleDateString('en-IN')});savePowerStore(s);renderApprovals();showToast('Approval request created.')} 
function advanceApproval(i){const s=powerStore(),flow=['Team Lead','Treasurer / Coordinator','General Secretary','President','Approved'];const x=s.approvals[i],n=flow.indexOf(x.stage);x.stage=flow[Math.min(n+1,flow.length-1)];if(x.stage==='Approved')s.approvals.splice(i,1);savePowerStore(s);renderApprovals();showToast(x.stage==='Approved'?'Request approved.':'Approval advanced.','success')}
function renderGoals(){const s=powerStore(),box=document.getElementById('power-goals-list');if(box)box.innerHTML=s.goals.map((g,i)=>`<div class="power-goal"><div class="power-goal-head"><span>${escapeHtml(g.title)}</span><span>${Number(g.progress)||0}%</span></div><small style="color:var(--text-muted)">${escapeHtml(g.owner||'Council')} • <button class="small-btn" style="padding:.2rem .4rem" onclick="bumpGoal(${i})">+5%</button></small><div class="power-goal-bar"><i style="width:${Math.min(100,Math.max(0,Number(g.progress)||0))}%"></i></div></div>`).join('');const avg=s.goals.length?Math.round(s.goals.reduce((a,g)=>a+(Number(g.progress)||0),0)/s.goals.length):0;document.getElementById('power-goal-stat')&&(document.getElementById('power-goal-stat').textContent=`${s.goals.length} goals`);document.getElementById('power-goal-health')&&(document.getElementById('power-goal-health').innerHTML=`<div style="font-size:2rem;font-weight:900;color:var(--accent-blue)">${avg}%</div><p style="font-size:.7rem;color:var(--text-muted)">Average goal progress</p>`)}
function addPowerGoal(){const title=prompt('Goal title:');if(!title)return;const owner=prompt('Owner/team:','Council')||'Council';const s=powerStore();s.goals.push({title,owner,progress:0});savePowerStore(s);renderGoals();showToast('Goal added.')}function bumpGoal(i){const s=powerStore();s.goals[i].progress=Math.min(100,(Number(s.goals[i].progress)||0)+5);savePowerStore(s);renderGoals()}
function renderDocs(){const s=powerStore(),box=document.getElementById('power-doc-list');if(box)box.innerHTML=s.docs.map((x,i)=>`<div class="power-row"><div class="mini"><i class="fa-solid fa-file-lines"></i></div><div><strong>${escapeHtml(x.name)}</strong><small>${escapeHtml(x.category||'Council document')} • ${escapeHtml(x.date||'')}</small></div>${x.data?`<button class="small-btn" onclick="downloadDataUrl('${'${x.data}'}','${escapeHtml(x.name)}')">Download</button>`:''}<button class="small-btn" onclick="deletePowerItem('docs',${i},renderDocs)">Delete</button></div>`).join('')||'<div class="power-empty">No documents indexed yet.</div>';document.getElementById('power-doc-stat')&&(document.getElementById('power-doc-stat').textContent=`${s.docs.length} documents`)}
function addPowerDocument(){const inp=document.createElement('input');inp.type='file';inp.accept='.pdf,.doc,.docx,.txt,.png,.jpg,.jpeg';inp.onchange=()=>{const file=inp.files?.[0];if(!file)return;if(file.size>5*1024*1024){showToast('Document must be 5MB or smaller.','error');return;}const r=new FileReader();r.onload=()=>{const s=powerStore();s.docs.push({name:file.name,category:prompt('Category:','Meeting Minutes')||'Council',date:new Date().toLocaleDateString('en-IN'),data:r.result,type:file.type});savePowerStore(s);renderDocs();showToast('Document uploaded and stored.');};r.readAsDataURL(file);};inp.click()} 
function renderMedia(){const s=powerStore(),box=document.getElementById('power-media-list');if(box)box.innerHTML=s.media.map((x,i)=>`<div class="power-row"><div class="mini"><i class="fa-solid fa-photo-film"></i></div><div><strong>${escapeHtml(x.title)}</strong><small>${escapeHtml(x.type||'Post')} • ${escapeHtml(x.stage||'Idea')} • Owner: ${escapeHtml(x.owner||'PR & Media')}</small></div><button class="small-btn" onclick="advanceMedia(${i})">Advance</button></div>`).join('')||'<div class="power-empty">Media pipeline is empty.</div>';document.getElementById('power-media-stat')&&(document.getElementById('power-media-stat').textContent=`${s.media.length} content items`)}
function addMediaItem(){const title=prompt('Content title:');if(!title)return;const s=powerStore();s.media.push({title,type:prompt('Content type:','Event Poster')||'Content',stage:'Idea',owner:'PR & Media'});savePowerStore(s);renderMedia();showToast('Media item added.')}function advanceMedia(i){const s=powerStore(),flow=['Idea','Draft','Review','Approved','Published'];const x=s.media[i],n=flow.indexOf(x.stage);x.stage=flow[Math.min(n+1,flow.length-1)];savePowerStore(s);renderMedia()}
function renderPowerGrievances(){const d=powerData(),open=d.grievances.filter(g=>!['resolved','closed'].includes(String(g.status||'').toLowerCase()));const box=document.getElementById('power-grievance-list');if(box)box.innerHTML=open.map(g=>`<div class="power-row"><div class="mini"><i class="fa-solid fa-shield-halved"></i></div><div><strong>${escapeHtml(g.subject||'Grievance')}</strong><small>${escapeHtml(g.priority||'Normal')} • ${escapeHtml(g.status||'Open')}</small></div><span class="power-badge">${String(g.priority||'Normal').toUpperCase()}</span></div>`).join('')||'<div class="power-empty">No open grievances.</div>';document.getElementById('power-grievance-stat')&&(document.getElementById('power-grievance-stat').textContent=`${open.length} open`);const resolved=d.grievances.length-open.length;document.getElementById('power-grievance-health')&&(document.getElementById('power-grievance-health').innerHTML=`<div style="font-size:2rem;font-weight:900;color:var(--accent-blue)">${d.grievances.length?Math.round(resolved/d.grievances.length*100):100}%</div><p style="font-size:.7rem;color:var(--text-muted)">Resolution rate</p>`)}
function renderAchievements(){const s=powerStore(),box=document.getElementById('power-achievement-list');if(box)box.innerHTML=s.achievements.map((x,i)=>`<div class="power-row"><div class="mini"><i class="fa-solid fa-medal"></i></div><div><strong>${escapeHtml(x.award)}</strong><small>${escapeHtml(x.person)} • ${escapeHtml(x.reason||'Council achievement')}</small></div><button class="small-btn" onclick="deletePowerItem('achievements',${i},renderAchievements)">Delete</button></div>`).join('')||'<div class="power-empty">No awards recorded yet.</div>';document.getElementById('power-achievement-stat')&&(document.getElementById('power-achievement-stat').textContent=`${s.achievements.length} awards`)}
function addAchievement(){const person=prompt('Member name:');if(!person)return;const award=prompt('Achievement:','Deadline Master')||'Achievement';const s=powerStore();s.achievements.push({person,award,reason:prompt('Reason:','Strong delivery')||'Council achievement'});savePowerStore(s);renderAchievements();showToast('Achievement added.')}function deletePowerItem(key,i,fn){const s=powerStore();s[key].splice(i,1);savePowerStore(s);fn();showToast('Removed.')}
function renderPowerCommand(){const d=powerData(),s=powerStore();const activities=[...d.tasks.slice(-3).map(x=>`Task: ${x.title}`),...d.events.slice(-2).map(x=>`Event: ${x.title}`),...d.meetings.slice(-2).map(x=>`Meeting: ${x.title}`)];const a=document.getElementById('power-activity-list');if(a)a.innerHTML=activities.reverse().map(x=>`<div class="power-row"><div class="mini"><i class="fa-solid fa-bolt"></i></div><div><strong>${escapeHtml(x)}</strong><small>Local activity stream</small></div><span class="power-badge">LIVE</span></div>`).join('')||'<div class="power-empty">No activity yet.</div>';const e=document.getElementById('power-engagement');if(e)e.innerHTML=`<div style="font-size:1.7rem;font-weight:900;color:var(--accent-blue)">${Math.min(99,62+d.members.length)}%</div><div class="power-progress"><i style="width:${Math.min(99,62+d.members.length)}%"></i></div><small style="color:var(--text-muted)">${d.members.length} council profiles indexed.</small>`;const r=document.getElementById('power-role-intel');if(r){const leads=(typeof COUNCIL_TEAMS!=='undefined'?COUNCIL_TEAMS.length:0);r.innerHTML=`<div style="font-size:1.7rem;font-weight:900">${leads}</div><small style="color:var(--text-muted)">functional leadership workspaces</small>`}}
function runPowerAutomation(type){const d=powerData();if(type==='event'&&d.events[0]){showToast('Preparation pack simulated for '+d.events[0].title)}else if(type==='meeting'&&d.meetings[0]){showToast('Action-item workflow simulated for '+d.meetings[0].title)}else if(type==='finance'&&d.finances[0]){createApproval();return}else showToast('No matching source record yet.','error')}
function generateSCMSBriefing(){const d=powerData(),h=powerHealth(),over=d.tasks.filter(t=>String(t.status||'').toLowerCase()!=='completed'&&t.due_date&&new Date(t.due_date)<new Date()).length,up=d.events.filter(e=>e.date&&new Date(e.date)>=new Date()).length,pf=d.finances.filter(f=>String(f.status||'Pending').toLowerCase()==='pending').length,gr=d.grievances.filter(g=>!['resolved','closed'].includes(String(g.status||'').toLowerCase())).length;const text=`SCMS DAILY COUNCIL BRIEFING\n\nCouncil Health: ${h}%\n\nATTENTION\n• ${over} overdue task(s)\n• ${pf} finance request(s) awaiting review\n• ${gr} open grievance(s)\n• ${up} upcoming event(s)\n\nNEXT MOVE\nReview urgent tasks, clear approval bottlenecks and confirm the next event readiness.\n\nMode: Orbita FastAPI + Supabase workspace.`;switchPowerTab('assistant');document.getElementById('power-assistant-output').textContent=text}
function askSCMSAssistant(){const q=(document.getElementById('power-assistant-input')?.value||'').toLowerCase();const d=powerData();let ans='';if(q.includes('task'))ans=`You have ${d.tasks.length} tasks. ${d.tasks.filter(t=>String(t.status||'').toLowerCase()!=='completed').length} are not completed.`;else if(q.includes('event'))ans=`There are ${d.events.length} indexed events. ${d.events.filter(e=>e.date&&new Date(e.date)>=new Date()).length} are upcoming.`;else if(q.includes('meeting'))ans=`There are ${d.meetings.length} meetings in the local workspace.`;else if(q.includes('finance')||q.includes('budget'))ans=`There are ${d.finances.length} finance records; ${d.finances.filter(f=>String(f.status||'Pending').toLowerCase()==='pending').length} are pending.`;else if(q.includes('grievance'))ans=`There are ${d.grievances.filter(g=>!['resolved','closed'].includes(String(g.status||'').toLowerCase())).length} open grievances.`;else ans=`Council health is ${powerHealth()}%. Ask me about tasks, events, meetings, finance, grievances, teams or priorities.`;document.getElementById('power-assistant-output').textContent=ans}
function exportPowerSuite(){const payload={exportedAt:new Date().toISOString(),currentUser:CURRENT_USER,powerSuite:powerStore(),coreData:powerData()};const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(payload,null,2)],{type:'application/json'}));a.download='scms-power-suite-snapshot.json';a.click();showToast('Power Suite export created.')}
function refreshPowerSuite(){const h=powerHealth();document.getElementById('power-health-score')&&(document.getElementById('power-health-score').textContent=h+'%');document.getElementById('power-health-bar')&&(document.getElementById('power-health-bar').style.width=h+'%');renderPowerAttention();renderPowerCalendar();renderApprovals();renderGoals();renderDocs();renderMedia();renderPowerGrievances();renderAchievements();renderPowerCommand()}
</script>
<script>
if('serviceWorker' in navigator && location.protocol !== 'file:'){ window.addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(()=>{})); }
</script>

<script src="./api-config.js"></script>
</body> 
</html>    