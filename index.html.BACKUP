                <div id="view-teams" class="view-section hide">
                    <div class="view-toolbar">
                        <div>
                            <div class="profile-chip"><span class="status-dot"></span> Leadership Command Center</div>
                            <h2 style="margin-top:.55rem;font-size:1.45rem;">Leaders & Functional Teams</h2>
                            <p style="margin-top:.25rem;color:var(--text-muted);font-size:.78rem">Live council leadership, faculty coordinators, committee members and team workspaces.</p>
                        </div>
                        <div class="toolbar-actions">
                            <button class="small-btn" onclick="showAllTeams()"><i class="fa-solid fa-grid-2"></i> All Teams</button>
                            <button class="small-btn" onclick="renderTeamDirectory(document.getElementById('team-search')?.value||'')"><i class="fa-solid fa-rotate"></i> Refresh</button>
                        </div>
                    </div>
                    <div class="kpi-grid" id="team-kpis"></div>
                    <div class="team-layout">
                        <div class="card">
                            <div class="section-header">
                                <div><h3>Leadership Directory</h3><div class="team-small">Official Student Council 2026-27 roster • 21 Aug 2026 selection report</div></div>
                                <span class="profile-chip"><i class="fa-solid fa-shield-halved"></i> SCMS</span>
                            </div>
                            <div class="team-filter-row">
                                <div class="team-search-box"><i class="fa-solid fa-magnifying-glass"></i><input id="team-search" class="toolbar-input" placeholder="Search lead, role, branch or member..." oninput="renderTeamDirectory(this.value)"></div>
                                <select id="team-filter" class="toolbar-select" onchange="renderTeamDirectory(document.getElementById('team-search')?.value||'')">
